#!/usr/bin/env sh
# Tier 2: local CI-parity gate, run once per push (replaces branch protection's
# required status checks). Mirrors the non-Swift CI jobs. Also blocks direct
# pushes to main/master.
#
# Bypass for genuine emergencies (CI re-verifies on the PR):
#   DS_SKIP_PREPUSH=1 git push

branch=$(git rev-parse --abbrev-ref HEAD)
if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
  echo "ERROR: Direct push to $branch is not allowed. Open a pull request."
  exit 1
fi

if [ "${DS_SKIP_PREPUSH:-0}" = "1" ]; then
  echo "[pre-push] DS_SKIP_PREPUSH=1 — skipping local CI gate. Remote CI will re-verify."
  exit 0
fi

# Run a labelled step; abort the push on the first failure with a clear message.
step() {
  printf '[pre-push] %s\n' "$1"
  shift
  if ! "$@"; then
    echo "ERROR: pre-push check failed: $*" >&2
    echo "  Fix the issue (or bypass with DS_SKIP_PREPUSH=1 git push for emergencies)." >&2
    exit 1
  fi
}

echo "[pre-push] Running local CI-parity gate (format, lint, freshness, tests, governance)..."

# ── Formatting, lint, typecheck, generated-artifact freshness ───────────────
# format:check runs dprint (TS/JS/JSON) + prettier (astro/md/mdx/css); see
# package.json. typecheck runs `turbo run typecheck` across the packages that
# extend @j0nathan-ll0yd/config/tsconfig-base.json (schemas, fixtures, web,
# storybook) — mirrors the CI `typecheck` job.
step "format:check"            pnpm format:check
step "lint"                    pnpm lint
step "typecheck"               pnpm typecheck
step "schemas freshness"       pnpm check:schemas-freshness

# Component-contract catalog (atlas decision 0060). Offline and fast, so it runs
# before the network-dependent drift gate. Five checks: grammar conformance vectors
# + sidecar digest, entry validity, completeness, the CONFORMANCE RATCHET (a widget
# with a null behavioral test or a null a11y label must be grandfathered in
# conformance-baseline.json, so a new widget with neither and a regression that
# drops either both red), and IDEMPOTENCE — the catalog is regenerated into a temp
# dir and diffed against what is committed, so a hand-edited contract or an
# unregenerated source change reds here rather than shipping a claim that reads as
# verified. See contracts/component-catalog/README.md.
#
# It ALSO runs in the CI governance-gates step (Phoenix eval GAP 2). This line stays
# because pre-push is DS's declared CI-parity tier and a drift someone else landed
# should block locally too (B9) — but CI is now where it BINDS, since
# DS_SKIP_PREPUSH=1 skips everything below.
#
# CATALOG_BASELINE_FROZEN=1 arms the sixth check, the BASELINE FREEZE (atlas decision
# 0102 move 1b): the committed conformance-baseline.json is compared against its copy
# at the merge base with origin/main, and an id that was ADDED reds unless a
# `Baseline-Raise: <axis>:<widget-id> <reason>` trailer on a commit in this branch
# justifies it. CI sets the flag implicitly through CI=1; setting it here is what makes
# an absorbed gap red BEFORE the push rather than after. It needs origin/main to exist
# locally — run `git fetch origin main` if it says it cannot resolve a base.
step "component-catalog gate"  env CATALOG_BASELINE_FROZEN=1 pnpm check:component-catalog

# C147 — published-package payload drift: a published package's payload changed
# but nobody bumped that package's version, so `changeset publish` silently skips
# it and consumers never receive the change. Content-based: it compares the
# payload this checkout would publish against the payload already published under
# the declared version.
#
# There is no base-ref filtering, matching the CI job — this hook is a CI-parity
# gate, and a drift someone else landed on main still blocks the release, so it
# should block here too (B9).
#
# It evaluates the WORKING TREE (a build is required, and a build needs a
# materialised tree), so an uncommitted bump IS visible here — unlike the
# previous git-ref-based generation.
#
# It needs the network and a GitHub Packages token; there is no anonymous access
# even for public packages, so offline is INDETERMINATE/exit 3, never a pass. The
# documented escape for a genuine emergency is DS_SKIP_PREPUSH=1.
# Invoked directly rather than through `pnpm check:package-drift -- --lane=...`:
# pnpm 11 forwards the bare `--` to the script as a literal argument, which the
# parser rejects. Caught by this very hook on its first run.
step "package payload drift"   node scripts/check-package-drift.mjs --lane=pre-push

# ── Tier 2: cheap CI-job mirrors (unit tests, contract, audits) ─────────────
# The web unit suite (vitest) is distinct from `typecheck` above: it exercises
# runtime behaviour of the updaters/adapters Props contract.
step "web tests"               pnpm -F @j0nathan-ll0yd/web test
step "copy tests"              pnpm -F @j0nathan-ll0yd/copy test
step "audit script tests"      pnpm test:scripts
step "copy grep-gate"          pnpm -F @j0nathan-ll0yd/copy grep-gate
step "web inline-script audit" pnpm -F @j0nathan-ll0yd/web audit:inline-scripts
step "schema contract verify"  pnpm -F @j0nathan-ll0yd/schemas contract:verify
step "DTCG conformance"        pnpm dtcg:validate

# ── Tier 3: governance gates (need token-dist; mirror CI governance-gates) ──
step "build tokens (prereq)"   pnpm build:tokens
step "widget inventory drift"  pnpm widget:inventory -- --check
step "token parity (P1)"       pnpm tokens:parity
step "WCAG-AA contrast"        pnpm check:contrast
step "Swift widget purity (P3)" pnpm swift:purity
step "watch exclusions (F-014)" pnpm watch:exclusions
step "promotion gate (P4/P7)"  pnpm promotion:check
step "tokens golden test"      pnpm -F @j0nathan-ll0yd/tokens test

# ── Tier 4: apps Astro builds (mirror the build-web + docs-build CI jobs) ────
# These were previously absent from the gate; a widget-registry change that
# broke the /llms-full.txt prerender (an incomplete MovementRings fixture, PR
# #128) passed pre-push and only reddened on CI. `pnpm build` builds both the
# portfolio and docs apps, so it covers both jobs' failure surface. Slowest
# step — kept last.
step "apps build (build-web + docs-build CI mirror)" pnpm build

echo "[pre-push] All checks passed."
