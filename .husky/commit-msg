#!/usr/bin/env sh
# Enforce the repo's commit convention (CLAUDE.md): no AI attribution.
# Mirrors mantle-LifegamesPortal's commit-msg hook.

if grep -iqE "Co-Authored-By:.*(Claude|Anthropic|GPT|Copilot)|Generated with (Claude|AI)|AI.generated|Generated by (AI|Claude|GPT|LLM)" "$1"; then
  echo "ERROR: AI attribution detected in commit message — not allowed (see CLAUDE.md)." >&2
  exit 1
fi

if grep -q "🤖" "$1"; then
  echo "ERROR: Robot emoji detected in commit message — not allowed." >&2
  exit 1
fi
