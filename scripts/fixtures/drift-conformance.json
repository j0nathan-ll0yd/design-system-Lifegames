        "registryEffectiveDigest": "1752f5166524a4acb762175bc32fb1c6c464a8f8c12c78b8e627c7397d1f0672",
        "headEffectiveDigest": "1752f5166524a4acb762175bc32fb1c6c464a8f8c12c78b8e627c7397d1f0672",
        "differingFiles": []
      }
    },
    {
      "id": "cmp-files-array-reorder-is-drift",
      "kind": "comparison",
      "why": "Arrays keep their order: `files[]` order is semantically meaningful to packers.",
      "registry": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"files\":[\"dist\",\"src\"]}"
      },
      "head": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"files\":[\"src\",\"dist\"]}"
      },
      "expect": {
        "verdict": "DRIFT",
        "registryEffectiveDigest": "1ede62d6a8f68cfee29bd37b15f9b95e863fa175e0ac47e160c5a63b4c1fa99f",
        "headEffectiveDigest": "d90d7a6e13d97ab5c34d5065cdadadddd6b7ce86575019bd7b75d1d23f5489c2",
        "differingFiles": [
          "package.json"
        ]
      }
    },
    {
      "id": "cmp-publishconfig-edit-is-drift",
      "kind": "comparison",
      "why": "PINS THE DECISION NOT TO HOIST. publishConfig is compared as written; nobody may quietly normalize pnpm publishConfig hoisting away.",
      "registry": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"publishConfig\":{\"registry\":\"https://npm.pkg.github.com\"}}"
      },
      "head": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"publishConfig\":{\"registry\":\"https://registry.npmjs.org\"}}"
      },
      "expect": {
