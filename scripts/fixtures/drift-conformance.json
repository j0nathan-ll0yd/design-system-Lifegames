{
  "$comment": "CANONICAL cross-repo conformance fixture for the package payload digest. Source of truth: atlas/contracts/package-digest/. Generated by build-fixture.mjs from reference.mjs — do not hand-edit, and do not fork per repo. Every implementation must reproduce every case exactly and must assert its SPEC_VERSION equals specVersion below.",
  "specVersion": 3,
  "digest": {
    "hash": "sha256",
    "encoding": "hex",
    "manifestEntry": "package.json",
    "strippedManifestKeys": [
      "version"
    ],
    "strippedScriptKeys": [
      "postpack",
      "postpublish",
      "prepack",
      "prepare",
      "prepublishOnly",
      "publish"
    ],
    "dropScriptsKeyWhenEmpty": true,
    "canonicalization": "recursively sort object keys; preserve array order",
    "serialization": "JSON.stringify of the canonicalized value, no whitespace, UTF-8",
    "unparseableManifest": "hash raw bytes; never throw",
    "payloadDigest": "sha256 of sorted \"<posix path> <sha256hex>\" lines joined by \\n",
    "deadSourceMap": "a .map is dead only when EVERY sources[] entry resolves outside the packed set; sourceRoot is honoured; a data: source is never unresolvable; dead maps leave effectiveDigest only",
    "verdictSource": "effectiveDigest"
  },
  "caseEncoding": "every `input`, `files` value, `registry` value and `head` value is UTF-8 text",
  "cases": [
    {
      "id": "man-version-deleted-and-keys-sorted",
      "kind": "manifest",
      "why": "The head/registry comparison is head-vs-semverMax(registry), where the numbers legitimately differ. Keys sort recursively; arrays keep order.",
      "input": "{\"name\":\"p\",\"version\":\"9.9.9\",\"files\":[\"b\",\"a\"],\"exports\":{\"./z\":\"./z.js\",\".\":\"./i.js\"}}",
      "expect": {
        "normalized": "{\"exports\":{\".\":\"./i.js\",\"./z\":\"./z.js\"},\"files\":[\"b\",\"a\"],\"name\":\"p\"}",
        "sha256": "2eb870ce3aa9d347a73d47325e167e8708661c80616ae37a1c838c5d7a90cc26"
      }
    },
    {
      "id": "man-six-publish-only-scripts-removed",
      "kind": "manifest",
      "why": "THE X3 RULE. Exactly the six scripts `pnpm pack` deletes. Kills any implementation that strips none.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"build\":\"tsc\",\"prepack\":\"x\",\"prepare\":\"x\",\"prepublishOnly\":\"x\",\"postpack\":\"x\",\"publish\":\"x\",\"postpublish\":\"x\"}}",
      "expect": {
        "normalized": "{\"name\":\"p\",\"scripts\":{\"build\":\"tsc\"}}",
        "sha256": "8ec5ec6579ea89852d95d69ed60c447c12c465b8761c59930e59819ee5df1713"
      }
    },
    {
      "id": "man-legacy-prepublish-is-retained",
      "kind": "manifest",
      "why": "Neither npm nor pnpm strips legacy `prepublish`, so it stays compared. Kills the old atlas seven-item list.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"prepublish\":\"legacy\",\"prepack\":\"gone\"}}",
      "expect": {
        "normalized": "{\"name\":\"p\",\"scripts\":{\"prepublish\":\"legacy\"}}",
        "sha256": "d42e6ba352adcf45b9a3599a24a8179f98a8f115a230735bc3df66dd1277dced"
      }
    },
    {
      "id": "man-consumer-run-scripts-are-retained",
      "kind": "manifest",
      "why": "preinstall/install/postinstall DO run on a consumer machine, so they must never be normalized away.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"preinstall\":\"a\",\"install\":\"b\",\"postinstall\":\"c\",\"prepare\":\"stripped\"}}",
      "expect": {
        "normalized": "{\"name\":\"p\",\"scripts\":{\"install\":\"b\",\"postinstall\":\"c\",\"preinstall\":\"a\"}}",
        "sha256": "95f4a7ec3c1bc36e4db12a78c5a851b71fa3a2a6f975187f83ff3df708979a21"
      }
    },
    {
      "id": "man-scripts-key-dropped-when-emptied",
      "kind": "manifest",
      "why": "pnpm emits `\"scripts\": {}`; npm emits the original object; a source with none emits no key. All three must hash alike.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"prepare\":\"x\",\"prepack\":\"y\"}}",
      "expect": {
        "normalized": "{\"name\":\"p\"}",
        "sha256": "1cf8d75aa01a64d20f498907560fe65bd4cc3ed6ab4bc38a5592392afbfaa192"
      }
    },
    {
      "id": "man-already-empty-scripts-object-dropped",
      "kind": "manifest",
      "why": "The literal `\"scripts\": {}` that pnpm pack writes must collapse to the same bytes as an absent key.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{}}",
      "expect": {
        "normalized": "{\"name\":\"p\"}",
        "sha256": "1cf8d75aa01a64d20f498907560fe65bd4cc3ed6ab4bc38a5592392afbfaa192"
      }
    },
    {
      "id": "man-absent-scripts-key-stays-absent",
      "kind": "manifest",
      "why": "The equivalence class the two cases above collapse into.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\"}",
      "expect": {
        "normalized": "{\"name\":\"p\"}",
        "sha256": "1cf8d75aa01a64d20f498907560fe65bd4cc3ed6ab4bc38a5592392afbfaa192"
      }
    },
    {
      "id": "man-nested-values-sorted-arrays-preserved",
      "kind": "manifest",
      "why": "Canonicalization is recursive, but `files[]` order is meaningful and must survive.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\",\"files\":[\"z\",\"a\",\"m\"],\"exports\":{\"./b\":{\"import\":\"./b.mjs\",\"types\":\"./b.d.mts\"},\".\":{\"types\":\"./i.d.mts\",\"import\":\"./i.mjs\"}}}",
      "expect": {
        "normalized": "{\"exports\":{\".\":{\"import\":\"./i.mjs\",\"types\":\"./i.d.mts\"},\"./b\":{\"import\":\"./b.mjs\",\"types\":\"./b.d.mts\"}},\"files\":[\"z\",\"a\",\"m\"],\"name\":\"p\"}",
        "sha256": "b66aeb47ce6e1aa99a556a32c3cfafaf1cebb606378fbba961bdd040c4ee759c"
      }
    },
    {
      "id": "man-utf8-preserved",
      "kind": "manifest",
      "why": "Serialization is UTF-8; non-ASCII content must not be mangled or escaped differently across runtimes.",
      "input": "{\"name\":\"p\",\"version\":\"1.0.0\",\"description\":\"café — naïve — 日本語 — 🎯\"}",
      "expect": {
        "normalized": "{\"description\":\"café — naïve — 日本語 — 🎯\",\"name\":\"p\"}",
        "sha256": "ee4908d303b7ee21188b9315f51c0dcd79f0bfd1dd57093759ee970ba0eb3414"
      }
    },
    {
      "id": "man-malformed-manifest-compared-raw",
      "kind": "manifest",
      "why": "An unparseable manifest is hashed as raw bytes. It must NOT throw — design-system currently throws here.",
      "input": "{ this is not json",
      "expect": {
        "normalized": "{ this is not json",
        "sha256": "0fb1db0e71e178183d7581080c63c2b80630b1e60c182cae9fd866701a751329"
      }
    },
    {
      "id": "man-non-object-manifest-compared-raw",
      "kind": "manifest",
      "why": "A manifest that parses to an array/scalar has no keys to normalize; hash it raw rather than crashing.",
      "input": "[1,2,3]",
      "expect": {
        "normalized": "[1,2,3]",
        "sha256": "a615eeaee21de5179de080de8c3052c8da901138406ba71c38c032845f7d54f4"
      }
    },
    {
      "id": "ent-non-manifest-hashed-raw",
      "kind": "entry",
      "why": "Only the top-level package.json is normalized; everything else is byte-compared.",
      "path": "dist/index.mjs",
      "input": "export const a = 1\n",
      "expect": {
        "normalized": "export const a = 1\n",
        "sha256": "a3b135bcfeaabda5d6780642cf256059889ad4649c9ba4f7a4d5d6e83a68b402"
      }
    },
    {
      "id": "ent-nested-manifest-hashed-raw",
      "kind": "entry",
      "why": "A nested dist/package.json is NOT the manifest and must keep its `version` in the hash.",
      "path": "dist/package.json",
      "input": "{\"name\":\"inner\",\"version\":\"1.0.0\",\"type\":\"module\"}",
      "expect": {
        "normalized": "{\"name\":\"inner\",\"version\":\"1.0.0\",\"type\":\"module\"}",
        "sha256": "5cf8125a0b02b4571eabd9f1a3f42d5b46f8be1d21dbca8201751885586e186f"
      }
    },
    {
      "id": "pay-dead-map-all-sources-outside",
      "kind": "payload",
      "why": "files:[\"dist\"] ships dist/i.mjs.map pointing at ../src/i.ts, which is in no consumer node_modules. Dropped from effective only.",
      "files": {
        "dist/i.mjs": "x",
        "dist/i.mjs.map": "{\"version\":3,\"sources\":[\"../src/i.ts\"]}"
      },
      "expect": {
        "strictDigest": "5674ec91f0fa6d47ac7ae7ca7f20020f78721aa566bd8eb9973b547a5619a7a3",
        "effectiveDigest": "d076b5e514037a0a899b7dd025855c957edb9ee9e3a414ca94252c9fd0543aa9",
        "deadMaps": [
          "dist/i.mjs.map"
        ]
      }
    },
    {
      "id": "pay-map-partially-resolvable-is-kept",
      "kind": "payload",
      "why": "One resolvable source means the map is usable. Kills the ANY-source-missing rule that mantle shipped.",
      "files": {
        "dist/i.mjs": "x",
        "dist/a.ts": "y",
        "dist/i.mjs.map": "{\"version\":3,\"sources\":[\"./a.ts\",\"../src/b.ts\"]}"
      },
      "expect": {
        "strictDigest": "8dc9e8e3f29eef4a65cba6d04f4e10a65a622945c035a52bb12faac2d05d7291",
        "effectiveDigest": "8dc9e8e3f29eef4a65cba6d04f4e10a65a622945c035a52bb12faac2d05d7291",
        "deadMaps": []
      }
    },
    {
      "id": "pay-map-sourceroot-honoured",
      "kind": "payload",
      "why": "sourceRoot prefixes every source before resolution. Kills implementations that ignore it — atlas and DS both do.",
      "files": {
        "dist/i.mjs": "x",
        "dist/a.ts": "y",
        "dist/i.mjs.map": "{\"version\":3,\"sources\":[\"a.ts\"],\"sourceRoot\":\"../src\"}"
      },
      "expect": {
        "strictDigest": "b8b3a77562977035eb00ed691197633634a69314d6a437675c06c9de5f642894",
        "effectiveDigest": "e8e1b6c374a9bfd920e5c5cd7dcd3ed5b2004b36674fca132aeb28be2548741a",
        "deadMaps": [
          "dist/i.mjs.map"
        ]
      }
    },
    {
      "id": "pay-map-data-uri-is-kept",
      "kind": "payload",
      "why": "A data: source is inlined and always resolvable, so the map is never dead. Kills mantle and DS.",
      "files": {
        "dist/i.mjs": "x",
        "dist/i.mjs.map": "{\"version\":3,\"sources\":[\"data:application/json;base64,e30=\"]}"
      },
      "expect": {
        "strictDigest": "06a6548424d3bb55355637be786c29457818e44d5ab8b292f8d0bb1d4611637c",
        "effectiveDigest": "06a6548424d3bb55355637be786c29457818e44d5ab8b292f8d0bb1d4611637c",
        "deadMaps": []
      }
    },
    {
      "id": "pay-map-empty-sources-is-kept",
      "kind": "payload",
      "why": "No sources means nothing proves it dead.",
      "files": {
        "dist/i.mjs": "x",
        "dist/i.mjs.map": "{\"version\":3,\"sources\":[]}"
      },
      "expect": {
        "strictDigest": "9f4333b632c989a6822b02190a38e513e124c92caf5cc652bb6203866d7c63f7",
        "effectiveDigest": "9f4333b632c989a6822b02190a38e513e124c92caf5cc652bb6203866d7c63f7",
        "deadMaps": []
      }
    },
    {
      "id": "pay-unparseable-map-is-kept",
      "kind": "payload",
      "why": "A map we cannot read is not provably dead weight.",
      "files": {
        "dist/i.mjs": "x",
        "dist/i.mjs.map": "{oops"
      },
      "expect": {
        "strictDigest": "963572a07be59360c130b28d83871c398022f009f7d5be2fa958fa80d6334204",
        "effectiveDigest": "963572a07be59360c130b28d83871c398022f009f7d5be2fa958fa80d6334204",
        "deadMaps": []
      }
    },
    {
      "id": "pay-excluded-entry-removed-entirely",
      "kind": "payload",
      "why": "Leak-screen hits leave the payload so a leak reports as LEAKED_ARTIFACT, not DRIFT — and they also leave packedPaths, which can revive a map.",
      "files": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\"}",
        ".env": "SECRET=1",
        "dist/i.mjs": "x"
      },
      "exclude": [
        ".env"
      ],
      "expect": {
        "strictDigest": "89845984911a631929f6a6935c736bc3921a8ce9fff9466222726961a64c8e79",
        "effectiveDigest": "89845984911a631929f6a6935c736bc3921a8ce9fff9466222726961a64c8e79",
        "deadMaps": []
      }
    },
    {
      "id": "pay-manifest-normalized-inside-payload",
      "kind": "payload",
      "why": "End-to-end: the manifest rule applies within a full payload digest, not only in isolation.",
      "files": {
        "package.json": "{\n  \"name\": \"@j0nathan-ll0yd/portal-contract\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"private\": false,\n  \"publishConfig\": {\n    \"registry\": \"https://npm.pkg.github.com\"\n  },\n  \"files\": [\n    \"dist\",\n    \"raw-schemas\"\n  ],\n  \"scripts\": {\n    \"codegen\": \"node scripts/codegen.mjs\",\n    \"build\": \"tsc -p tsconfig.json\",\n    \"test\": \"node --test tests/contract.test.ts\",\n    \"prepublishOnly\": \"pnpm run codegen && pnpm run build\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"6.0.3\"\n  }\n}\n",
        "dist/i.mjs": "x"
      },
      "expect": {
        "strictDigest": "a794a63081bc2e6107f1c7e19e8761f993b9f487c26b93283f65c329edbb6054",
        "effectiveDigest": "a794a63081bc2e6107f1c7e19e8761f993b9f487c26b93283f65c329edbb6054",
        "deadMaps": []
      }
    },
    {
      "id": "cmp-npm-published-vs-pnpm-packed-is-clean",
      "kind": "comparison",
      "why": "THE X3 REGRESSION VECTOR, from real bytes. @j0nathan-ll0yd/portal-contract@1.0.0 was uploaded by `npm publish` (prepublishOnly intact, byte-identical to the repo source); the gate measures HEAD with `pnpm pack`, which deletes it. HEAD is exactly what is published, so the only correct verdict is CLEAN. Any engine that strips nothing, or strips version only, reports DRIFT here.",
      "registry": {
        "package.json": "{\n  \"name\": \"@j0nathan-ll0yd/portal-contract\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"private\": false,\n  \"publishConfig\": {\n    \"registry\": \"https://npm.pkg.github.com\"\n  },\n  \"files\": [\n    \"dist\",\n    \"raw-schemas\"\n  ],\n  \"scripts\": {\n    \"codegen\": \"node scripts/codegen.mjs\",\n    \"build\": \"tsc -p tsconfig.json\",\n    \"test\": \"node --test tests/contract.test.ts\",\n    \"prepublishOnly\": \"pnpm run codegen && pnpm run build\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"6.0.3\"\n  }\n}\n",
        "dist/i.mjs": "x"
      },
      "head": {
        "package.json": "{\n  \"name\": \"@j0nathan-ll0yd/portal-contract\",\n  \"version\": \"1.0.0\",\n  \"type\": \"module\",\n  \"private\": false,\n  \"publishConfig\": {\n    \"registry\": \"https://npm.pkg.github.com\"\n  },\n  \"files\": [\n    \"dist\",\n    \"raw-schemas\"\n  ],\n  \"devDependencies\": {\n    \"typescript\": \"6.0.3\"\n  },\n  \"scripts\": {\n    \"codegen\": \"node scripts/codegen.mjs\",\n    \"build\": \"tsc -p tsconfig.json\",\n    \"test\": \"node --test tests/contract.test.ts\"\n  }\n}",
        "dist/i.mjs": "x"
      },
      "expect": {
        "verdict": "CLEAN",
        "registryEffectiveDigest": "a794a63081bc2e6107f1c7e19e8761f993b9f487c26b93283f65c329edbb6054",
        "headEffectiveDigest": "a794a63081bc2e6107f1c7e19e8761f993b9f487c26b93283f65c329edbb6054",
        "differingFiles": []
      }
    },
    {
      "id": "cmp-legacy-prepublish-edit-is-drift",
      "kind": "comparison",
      "why": "Both tools preserve legacy `prepublish`, so an edit to it is real. Fails the old atlas seven-item list.",
      "registry": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"prepublish\":\"old\"}}"
      },
      "head": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"prepublish\":\"new\"}}"
      },
      "expect": {
        "verdict": "DRIFT",
        "registryEffectiveDigest": "7a9f3bed80bfa20dedf8fe454cfd26abf0efd436fc198d402efe7b69424cbbd0",
        "headEffectiveDigest": "2535c46ab3e5675e4fdd9ec719ef6e82c7ffc29cc61b459fa7f5670abbc4615c",
        "differingFiles": [
          "package.json"
        ]
      }
    },
    {
      "id": "cmp-postinstall-edit-is-drift",
      "kind": "comparison",
      "why": "Proves the six-script rule did not over-strip into scripts a consumer actually runs.",
      "registry": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"old\"}}"
      },
      "head": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"scripts\":{\"postinstall\":\"new\"}}"
      },
      "expect": {
        "verdict": "DRIFT",
        "registryEffectiveDigest": "efa57a6b202f8ab2e0dba7648d66ce940032de36158a16d2851daeda51fc1d11",
        "headEffectiveDigest": "28064ac92144ae8136acc9c4a9490c076a48ef69347151d589d2f363325fc50e",
        "differingFiles": [
          "package.json"
        ]
      }
    },
    {
      "id": "cmp-nested-dep-cascade-is-drift",
      "kind": "comparison",
      "why": "The workspace cascade: a sibling moves 1.0.0 -> 1.0.1 with no source file changing. Nested dependency versions must stay compared.",
      "registry": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"dependencies\":{\"@j0nathan-ll0yd/database\":\"1.0.0\"}}"
      },
      "head": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\",\"dependencies\":{\"@j0nathan-ll0yd/database\":\"1.0.1\"}}"
