      "expect": {
        "verdict": "DRIFT",
        "registryEffectiveDigest": "75bd1cff48c926b5b927dc6d6f3f4c984cbf98cdf3f38aaf96bc7c4898c0b0e9",
        "headEffectiveDigest": "09d00b2dd4e36c13848837e4175df42da04398d25013a87b0d8ed96364c7c4aa",
        "differingFiles": [
          "package.json"
        ]
      }
    },
    {
      "id": "cmp-top-level-version-only-is-clean",
      "kind": "comparison",
      "why": "head-vs-semverMax(registry) compares different numbers by construction.",
      "registry": {
        "package.json": "{\"name\":\"p\",\"version\":\"1.0.0\"}"
      },
      "head": {
        "package.json": "{\"name\":\"p\",\"version\":\"2.5.7\"}"
