      "expect": {
        "verdict": "CLEAN",
        "registryEffectiveDigest": "18c9420438d2cefc64f0225eca248ca163643a3613ce355ff47a6faf767eed88",
        "headEffectiveDigest": "18c9420438d2cefc64f0225eca248ca163643a3613ce355ff47a6faf767eed88",
        "differingFiles": []
      }
    },
    {
      "id": "cmp-formatting-and-key-order-is-clean",
      "kind": "comparison",
      "why": "npm uploads 2-space-indented bytes with a trailing newline; pnpm writes a different key order and no trailing newline. Formatting is not drift.",
      "registry": {
        "package.json": "{\n  \"name\": \"p\",\n  \"version\": \"1.0.0\",\n  \"files\": [\n    \"dist\"\n  ],\n  \"type\": \"module\"\n}\n"
