{
  "$comment": "CANONICAL cross-repo conformance fixture for the drift-verdict ladder. Source of truth: atlas/contracts/verdict-ladder/. Generated by build-fixture.mjs from reference.mjs — do not hand-edit, and do not fork per repo. Every implementation must reproduce every case exactly and must assert its LADDER_SPEC_VERSION equals specVersion below.",
  "specVersion": 1,
  "ladder": {
    "lanes": [
      "pre-push",
      "branch",
      "post-publish"
    ],
    "verdicts": [
      "CLEAN",
      "PENDING_PUBLISH",
      "PENDING_CHANGESET",
      "BUMP_NOT_NEEDED",
      "NEVER_PUBLISHED",
      "DRIFT",
      "SURFACE_BREAK",
      "VERSION_REGRESSION",
      "LEAKED_ARTIFACT",
      "INDETERMINATE",
      "BUILD_FAILED",
      "SKIPPED"
    ],
    "resolvableVerdicts": "resolveVerdict returns only: NEVER_PUBLISHED, CLEAN, DRIFT, PENDING_CHANGESET, BUMP_NOT_NEEDED, PENDING_PUBLISH, VERSION_REGRESSION, INDETERMINATE",
    "pendingChangesetRelabels": "DRIFT only; unreachable from every other verdict by construction",
    "adequacy": "granted iff the projected version (what `changeset version` would write) is itself a clean PENDING_PUBLISH; the projection re-runs resolveVerdict at depth 1 with not-measured",
    "failSafeDefault": "absent/undefined pendingRelease reads as {kind:\"not-measured\"} — no excuse",
    "exitClasses": "4=BUILD_FAILED, 3=INDETERMINATE, 2=blocking defect, 0=fine; an unclassified verdict or unknown lane THROWS",
    "laneEffect": "the lane changes ONLY the exit class, never the verdict; PENDING_PUBLISH / PENDING_CHANGESET / NEVER_PUBLISHED escalate to 2 on post-publish"
  },
  "caseKinds": {
    "exit": "call exitClassOf(verdict, lane); expect.exitClass, or expect.throws for an unknown verdict/lane",
    "semver": "call compareSemver(a, b); expect.sign is the normalized -1/0/1",
    "resolve": "call resolveVerdict(input); expect.verdict, expect.referenceVersion, expect.advisories (order significant)"
  },
