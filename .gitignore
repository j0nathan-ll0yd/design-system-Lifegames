node_modules/
# pnpm content-addressable store. The visual-regression Docker harness
# (apps/portfolio/scripts/run-in-docker.sh) pins the store INSIDE the container,
# but ignore it at the repo root as a safety net so a stray store is never
# committed.
.pnpm-store/
dist/
# Exception: golden-file test fixtures intentionally snapshot dist outputs and
# must be committed so the byte-equality spec is reproducible from a fresh clone.
!packages/tokens/__tests__/golden/dist/
# Exception: @j0nathan-ll0yd/copy commits its generated consumer artifacts (flat schema,
# flat JSON, TS, Zod, barrel) so the freshness gate can git-diff them and reviewers
# see codegen output. Regenerated by `pnpm -F @j0nathan-ll0yd/copy build`.
!packages/copy/dist/
.turbo/
.DS_Store
.build/
build/
.swiftpm/
*.tgz
.env
.env.*
!.env.example
.omc/

# Astro type-generation + content cache
.astro/

# Playwright artifacts
playwright-report/
test-results/
blob-report/

# Vitest coverage output
coverage/

# Generated widget docs (recreated by scripts/generate-widget-docs.mjs)
apps/docs/src/content/docs/widgets/*/
!apps/docs/src/content/docs/widgets/*/index.mdx

# IDE
.idea/

# Storybook static build output
apps/storybook/storybook-static/
apps/swift-gallery/SwiftGallery.xcodeproj/xcuserdata/
apps/swift-gallery/SwiftGallery.xcodeproj/project.xcworkspace/xcuserdata/

# Visual regression diff images (CI uploads these as artifacts; only baselines are committed)
apps/storybook/__snapshots__/__diff__/

# Agent enforcement symlinks
.claude/rules/

# yalc (Phase 1 local cross-repo linking; gitignored — flip to GitHub Packages in Phase 2)
.yalc/
yalc.lock

# Local onboarding scratch docs
docs/ONBOARDING.md
