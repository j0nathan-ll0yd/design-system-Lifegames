{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "swift/**", "vendored/**"]
    },
    "build:tokens": {
      "outputs": ["dist/**", "../../Sources/LifegamesTokens/**/*.swift"]
    },
    "lint": {},
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"]
    },
    "storybook:build": {
      "dependsOn": ["build"],
      "outputs": ["storybook-static/**"]
    },
    "docs:build": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "docs:dev": {
      "cache": false,
      "persistent": true
    },
    "storybook:test": {
      "dependsOn": ["build"],
      "cache": false
    }
  }
}
