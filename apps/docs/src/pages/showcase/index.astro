---
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/base';
import manifest from '@manifest';

const widgetModules = import.meta.glob('/../../packages/web/src/widgets/**/*.astro', { eager: true });
const fixtureModules = import.meta.glob('/../../Sources/LifegamesWidgets/Resources/widgets/**/*.json', { eager: true });

const componentMap: Record<string, any> = {};
for (const [path, mod] of Object.entries(widgetModules)) {
  const fileName = path.split('/').pop()!.replace('.astro', '');
  componentMap[fileName] = (mod as any).default;
}

const fixtureMap: Record<string, any> = {};
for (const [path, mod] of Object.entries(fixtureModules)) {
  const rel = path.split('/widgets/').pop()!;
  fixtureMap[rel] = (mod as any).default;
}

function resolveComponentName(manifestName: string): string {
  if (componentMap[manifestName]) return manifestName;
  const match = Object.keys(componentMap).find(
    (k) => k.startsWith(manifestName) && k !== manifestName
  );
  return match || manifestName;
}

interface ManifestEntry {
  category: string;
  name: string;
  viewType: string;
  fixturePath: string;
}

const categories = (manifest as { widgets: ManifestEntry[] }).widgets.reduce<
  Record<string, { entry: ManifestEntry; componentName: string; fixture: any }[]>
>((acc, w) => {
  const componentName = resolveComponentName(w.name);
  const fixture = fixtureMap[w.fixturePath] || {};
  (acc[w.category] ??= []).push({ entry: w, componentName, fixture });
  return acc;
}, {});

// Full-screen overlay widgets — they use `position: fixed; inset: 0` and
// would cover the entire showcase grid. List them separately with links.
const overlayWidgets = new Set([
  'BookModal', 'FocusOverlay', 'DndOverlay', 'ComingSoon',
]);

const categoryOrder = ['github', 'location', 'health', 'reading', 'identity', 'other'];
const sortedCategories = categoryOrder
  .filter((c) => categories[c])
  .map((c) => ({
    name: c,
    widgets: categories[c].filter((w) => !overlayWidgets.has(w.entry.name)),
    overlays: categories[c].filter((w) => overlayWidgets.has(w.entry.name)),
  }));

const allOverlays = sortedCategories.flatMap((c) =>
  c.overlays.map((w) => ({ category: c.name, entry: w.entry })),
);

const categoryLabel: Record<string, string> = {
  github: 'GitHub',
  location: 'Location',
  health: 'Health',
  reading: 'Reading',
  identity: 'Identity',
  other: 'Other',
};

const widgetSlug = (name: string) =>
  name.replace(/([A-Z])/g, '-$1').toLowerCase().replace(/^-/, '').replace(/v3$/, 'v3');
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Widget Showcase — Lifegames Design System</title>
  <style is:global>
    /* Showcase page: flat grid layout. Bypasses the triptych (.command-layout)
       intentionally — that layout was designed for one column of widgets +
       a fixed identity card, not 56 widgets across 6 categories. */
    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg, #06060f);
      color: var(--text, #e4e4e7);
      font-family: var(--font-family, 'Space Grotesk', sans-serif);
      min-height: 100vh;
    }
    .showcase-header {
      padding: var(--space-32) var(--space-32) var(--space-20);
      border-bottom: 1px solid var(--card-border);
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: var(--space-20);
    }
    .showcase-header h1 {
      margin: 0;
      font-size: var(--font-size-hero);
      font-weight: 700;
      letter-spacing: 1px;
    }
    .showcase-header .meta {
      font-size: var(--font-size-sm);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .showcase-nav {
      display: flex;
      gap: var(--space-12);
      padding: var(--space-12) var(--space-32);
      border-bottom: 1px solid var(--card-border);
      flex-wrap: wrap;
      position: sticky;
      top: 0;
      background: rgba(6, 6, 15, 0.92);
      backdrop-filter: blur(var(--blur-md));
      z-index: 10;
    }
    .showcase-nav a {
      color: var(--text-muted);
      text-decoration: none;
      font-size: var(--font-size-sm);
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: var(--space-6) var(--space-12);
      border-radius: var(--radius-md);
      transition: color 0.18s ease, background 0.18s ease;
    }
    .showcase-nav a:hover {
      color: var(--text);
      background: var(--card-bg-hover);
    }
    .showcase-nav a .count {
      opacity: 0.6;
      margin-left: var(--space-6);
    }
    main.showcase {
      padding: var(--space-32);
      max-width: 1600px;
      margin: 0 auto;
    }
    .category-section {
      margin-bottom: var(--space-48);
      scroll-margin-top: 4rem;
    }
    .category-section h2 {
      margin: 0 0 var(--space-20);
      font-size: var(--font-size-xl);
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 3px;
      color: var(--text-muted);
      padding-bottom: var(--space-12);
      border-bottom: 1px solid var(--card-border);
    }
    .category-section h2 .count {
      font-size: var(--font-size-sm);
      opacity: 0.5;
      margin-left: var(--space-8);
    }
    .widget-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
      gap: var(--space-20);
    }
    .widget-card-wrap {
      min-height: 260px;
      display: flex;
      flex-direction: column;
      gap: var(--space-8);
    }
    .widget-card-wrap > [data-widget-preview] {
      flex: 1;
      min-height: 240px;
    }
    .widget-card-wrap .label {
      font-size: var(--font-size-xs);
      color: var(--text-muted);
      letter-spacing: 2px;
      text-transform: uppercase;
      padding: 0 var(--space-4);
    }
    .widget-card-wrap .missing {
      padding: var(--space-20);
      border: 1px dashed rgba(255, 255, 255, 0.1);
      border-radius: var(--radius-xl);
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--neon-red);
      font-size: var(--font-size-sm);
    }
  </style>
</head>
<body>
  <header class="showcase-header">
    <h1>Lifegames Design System</h1>
    <span class="meta">Widget Showcase · v0.1.1 · {sortedCategories.reduce((s, c) => s + c.widgets.length, 0)} widgets</span>
  </header>

  <nav class="showcase-nav" aria-label="Category navigation">
    {sortedCategories.map((cat) => (
      <a href={`#cat-${cat.name}`}>
        {categoryLabel[cat.name] ?? cat.name}
        <span class="count">{cat.widgets.length}</span>
      </a>
    ))}
  </nav>

  <main class="showcase">
    {sortedCategories.map((cat) => (
      <section class="category-section" id={`cat-${cat.name}`}>
        <h2>
          {categoryLabel[cat.name] ?? cat.name}
          <span class="count">{cat.widgets.length}</span>
        </h2>
        <div class="widget-grid">
          {cat.widgets.map(({ entry, componentName, fixture }) => {
            const Comp = componentMap[componentName];
            return (
              <div class="widget-card-wrap">
                {Comp ? (
                  <div data-widget-preview>
                    <Comp {...fixture} />
                  </div>
                ) : (
                  <div class="missing">Missing: {entry.name}</div>
                )}
                <span class="label">{entry.name}</span>
              </div>
            );
          })}
        </div>
      </section>
    ))}

    {allOverlays.length > 0 && (
      <section class="category-section" id="cat-overlays">
        <h2>
          Overlays
          <span class="count">{allOverlays.length}</span>
        </h2>
        <p style="color: var(--text-muted); font-size: var(--font-size-sm); margin: 0 0 var(--space-20);">
          Full-screen widgets — these use <code>position: fixed</code> and cover the viewport.
          View each in isolation:
        </p>
        <ul style="list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: var(--space-12);">
          {allOverlays.map(({ category, entry }) => (
            <li>
              <a
                href={`/widgets/${category}/${widgetSlug(entry.name)}/`}
                style="display: block; padding: var(--space-16); border: 1px solid var(--card-border); border-radius: var(--radius-xl); color: var(--text); text-decoration: none; background: var(--card-bg); transition: background 0.18s ease, border-color 0.18s ease;"
              >
                <div style="font-weight: 600;">{entry.name}</div>
                <div style="font-size: var(--font-size-xs); color: var(--text-muted); text-transform: uppercase; letter-spacing: 1px; margin-top: var(--space-4);">{category}</div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </main>
</body>
</html>
