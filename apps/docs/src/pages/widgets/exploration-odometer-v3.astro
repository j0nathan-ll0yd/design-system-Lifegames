---
import '@j0nathan-ll0yd/tokens/fonts';
import '@j0nathan-ll0yd/tokens/css';
import '@j0nathan-ll0yd/tokens/compat';
import '@styles/components.css';
import '@j0nathan-ll0yd/tokens/effects';
import '@styles/layout.css';
import '@j0nathan-ll0yd/tokens/base';
import '@docs-styles/docs-chrome.css';

import ExplorationOdometerV3 from '@widgets/location/ExplorationOdometerV3.astro';
import ExplorationOdometerV3Island from '@islands/ExplorationOdometerV3Island.astro';
import fixture from '@fixtures/location/exploration-odometer-v3.json';
import fixture_skeleton from '@fixtures/location/exploration-odometer-v3.skeleton.json';
import fixture_empty from '@fixtures/location/exploration-odometer-v3.empty.json';
import fixture_populated_min from '@fixtures/location/exploration-odometer-v3.populated-min.json';
import fixture_populated_max from '@fixtures/location/exploration-odometer-v3.populated-max.json';
import fixture_homebody from '@fixtures/location/exploration-odometer-v3.homebody.json';
import fixture_weekend_warrior from '@fixtures/location/exploration-odometer-v3.weekend-warrior.json';
import fixture_roadtripper from '@fixtures/location/exploration-odometer-v3.roadtripper.json';
import fixture_new_city_week from '@fixtures/location/exploration-odometer-v3.new-city-week.json';
import fixture_passport_week from '@fixtures/location/exploration-odometer-v3.passport-week.json';
import StateMatrix from '../../components/StateMatrix.astro';
import VariationGrid from '../../components/VariationGrid.astro';
import ResponsiveDemo from '../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../components/WidgetPageScript.astro';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ExplorationOdometerV3 — Lifegames Design System</title>
    <style is:global>
      html,
      body {
        margin: 0;
        padding: 0;
        background: var(--bg, #06060f);
        color: var(--text, #e4e4e7);
        font-family: var(--font-family, 'Space Grotesk', sans-serif);
        min-height: 100vh;
      }
      .wd-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: var(--space-32);
      }
      .wd-header {
        display: flex;
        align-items: center;
        gap: var(--space-16);
        margin-bottom: var(--space-32);
        flex-wrap: wrap;
      }
      .wd-back {
        font-size: var(--font-size-sm);
        color: var(--text-muted);
        text-decoration: none;
        letter-spacing: 1px;
        transition: color 0.18s ease;
      }
      .wd-back:hover {
        color: var(--text);
      }
      .wd-title {
        font-size: var(--font-size-hero);
        font-weight: 700;
        margin: 0;
        letter-spacing: 1px;
      }
      .wd-badge {
        font-size: var(--font-size-xs);
        letter-spacing: 1px;
        text-transform: uppercase;
        padding: var(--space-2) var(--space-8);
        border-radius: var(--radius-sm);
      }
      .wd-badge--shipped {
        background: rgba(6, 214, 160, 0.12);
        color: var(--neon-green);
        border: 1px solid rgba(6, 214, 160, 0.25);
      }
      .wd-badge--dev {
        background: rgba(245, 158, 11, 0.08);
        color: var(--neon-amber);
        border: 1px solid rgba(245, 158, 11, 0.25);
      }
      .wd-cat {
        font-size: var(--font-size-xs);
        color: var(--text-muted);
        text-transform: uppercase;
        letter-spacing: 2px;
      }
      .wd-section {
        margin-bottom: var(--space-32);
      }
      .wd-section-title {
        font-size: var(--font-size-lg);
        font-weight: 600;
        margin: 0 0 var(--space-16);
        letter-spacing: 1px;
        border-bottom: 1px solid var(--card-border);
        padding-bottom: var(--space-8);
      }
      .wd-demo {
        border: 1px solid var(--card-border);
        border-radius: var(--radius-xl);
        background: var(--card-bg);
        padding: var(--space-20);
        overflow: hidden;
      }
      .wd-text {
        font-size: var(--font-size-sm);
        color: var(--text-muted);
        line-height: 1.6;
      }
      .wd-code {
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid var(--card-border);
        border-radius: var(--radius-md);
        padding: var(--space-16);
        font-size: var(--font-size-sm);
        overflow-x: auto;
        color: var(--text-muted);
      }
      .wd-code code {
        font-family: 'JetBrains Mono', monospace;
      }
      .wd-list {
        list-style: none;
        padding: 0;
        margin: 0;
      }
      .wd-list li {
        font-size: var(--font-size-sm);
        color: var(--text-muted);
        padding: var(--space-6) 0;
        border-bottom: 1px solid rgba(255, 255, 255, 0.04);
      }
      .wd-list li:last-child {
        border-bottom: none;
      }
      .wd-list code {
        font-size: var(--font-size-xs);
        background: rgba(255, 255, 255, 0.06);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-sm);
      }
    </style>
  </head>
  <body>
    <div class="wd-page">
      <a class="wd-back" href="/">&#8592; Back to production mirror</a>

      <div class="wd-header">
        <h1 class="wd-title">ExplorationOdometerV3</h1>
        <span class="wd-badge wd-badge--dev">Dev Only</span>
        <span class="wd-cat">location</span>
      </div>

      <section class="wd-section">
        <h2 class="wd-section-title">Live Demo</h2>
        <ResponsiveDemo
          widgetName="ExplorationOdometerV3"
          category="location"
          fixture={fixture}
          island={ExplorationOdometerV3Island}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">State Matrix</h2>
        <StateMatrix
          widgetName="ExplorationOdometerV3"
          category="location"
          island={ExplorationOdometerV3Island}
          states={[
            { state: 'skeleton', fixture: fixture_skeleton },
            { state: 'empty', fixture: fixture_empty },
            { state: 'populated-min', fixture: fixture_populated_min },
            { state: 'populated-max', fixture: fixture_populated_max },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Variations</h2>
        <VariationGrid
          widgetName="ExplorationOdometerV3"
          category="location"
          island={ExplorationOdometerV3Island}
          variations={[
            {
              label: 'homebody',
              fixture: fixture_homebody,
              caption: 'Single city, 412 visits — neighbourhood-deep explorer',
            },
            {
              label: 'weekend-warrior',
              fixture: fixture_weekend_warrior,
              caption: '6 cities across 3 states — regular day-tripper',
            },
            {
              label: 'roadtripper',
              fixture: fixture_roadtripper,
              caption: '38 cities, 14 states — year-long road trip',
            },
            {
              label: 'new-city-week',
              fixture: fixture_new_city_week,
              caption: 'First week in Austin — rapid place discovery',
            },
            {
              label: 'passport-week',
              fixture: fixture_passport_week,
              caption: 'Tokyo week — international travel, 5 cities',
            },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Props</h2>
        <p class="wd-text">
          See <code>packages/web/src/widgets/location/ExplorationOdometerV3.types.ts</code> for the full
          interface.
        </p>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Usage</h2>
        <pre
          class="wd-code"><code>---
import ExplorationOdometerV3 from '@j0nathan-ll0yd/web/widgets/location/ExplorationOdometerV3.astro';
---
&lt;ExplorationOdometerV3 &#123;...data&#125; /&gt;</code></pre>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Cross-Platform</h2>
        <ul class="wd-list">
          <li>
            <strong>Web:</strong>
            <code>packages/web/src/widgets/location/ExplorationOdometerV3.astro</code>
          </li>
          <li>
            <strong>iOS:</strong>
            <code>Sources/LifegamesWidgets/Location/ExplorationOdometerV3View.swift</code>
          </li>
          <li>
            <strong>Fixture:</strong>
            <code
              >Sources/LifegamesWidgets/Resources/widgets/location/exploration-odometer-v3.json</code
            >
          </li>
        </ul>
      </section>
    </div>
    <WidgetPageScript />
  </body>
</html>
