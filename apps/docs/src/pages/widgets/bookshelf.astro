---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import Bookshelf from '@widgets/reading/Bookshelf.astro';
import fixture from '@fixtures/reading/bookshelf.json';
import StateMatrix from '../../components/StateMatrix.astro';
import VariationGrid from '../../components/VariationGrid.astro';
import ResponsiveDemo from '../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../components/WidgetPageScript.astro';
import BookshelfIsland from '@islands/BookshelfIsland.astro';
import BookModal from '@widgets/reading/BookModal.astro';
import fixture_skeleton from '@fixtures/reading/bookshelf.skeleton.json';
import fixture_empty from '@fixtures/reading/bookshelf.empty.json';
import fixture_populated_min from '@fixtures/reading/bookshelf.populated-min.json';
import fixture_populated_max from '@fixtures/reading/bookshelf.populated-max.json';
import var_all_in_progress from '@fixtures/reading/bookshelf.all-in-progress.json';
import var_mixed from '@fixtures/reading/bookshelf.mixed.json';
import var_all_completed from '@fixtures/reading/bookshelf.all-completed.json';
import var_mostly_empty from '@fixtures/reading/bookshelf.mostly-empty.json';
import var_dense_shelf from '@fixtures/reading/bookshelf.dense-shelf.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Bookshelf — Lifegames Design System</title>
  <style is:global>
    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg, #06060f);
      color: var(--text, #e4e4e7);
      font-family: var(--font-family, 'Space Grotesk', sans-serif);
      min-height: 100vh;
    }
    .wd-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-32);
    }
    .wd-header {
      display: flex;
      align-items: center;
      gap: var(--space-16);
      margin-bottom: var(--space-32);
      flex-wrap: wrap;
    }
    .wd-back {
      font-size: var(--font-size-sm);
      color: var(--text-muted);
      text-decoration: none;
      letter-spacing: 1px;
      transition: color 0.18s ease;
    }
    .wd-back:hover {
      color: var(--text);
    }
    .wd-title {
      font-size: var(--font-size-hero);
      font-weight: 700;
      margin: 0;
      letter-spacing: 1px;
    }
    .wd-badge {
      font-size: var(--font-size-xs);
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: var(--space-2) var(--space-8);
      border-radius: var(--radius-sm);
    }
    .wd-badge--shipped {
      background: rgba(6, 214, 160, 0.12);
      color: var(--neon-green);
      border: 1px solid rgba(6, 214, 160, 0.25);
    }
    .wd-badge--dev {
      background: rgba(245, 158, 11, 0.08);
      color: var(--neon-amber);
      border: 1px solid rgba(245, 158, 11, 0.25);
    }
    .wd-cat {
      font-size: var(--font-size-xs);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .wd-section {
      margin-bottom: var(--space-32);
    }
    .wd-section-title {
      font-size: var(--font-size-lg);
      font-weight: 600;
      margin: 0 0 var(--space-16);
      letter-spacing: 1px;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: var(--space-8);
    }
    .wd-demo {
      border: 1px solid var(--card-border);
      border-radius: var(--radius-xl);
      background: var(--card-bg);
      padding: var(--space-20);
      overflow: hidden;
    }
    .wd-text {
      font-size: var(--font-size-sm);
      color: var(--text-muted);
      line-height: 1.6;
    }
    .wd-code {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: var(--space-16);
      font-size: var(--font-size-sm);
      overflow-x: auto;
      color: var(--text-muted);
    }
    .wd-code code {
      font-family: 'JetBrains Mono', monospace;
    }
    .wd-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .wd-list li {
      font-size: var(--font-size-sm);
      color: var(--text-muted);
      padding: var(--space-6) 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .wd-list li:last-child {
      border-bottom: none;
    }
    .wd-list code {
      font-size: var(--font-size-xs);
      background: rgba(255, 255, 255, 0.06);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
    }
  </style>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/">&#8592; Back to production mirror</a>

    <div class="wd-header">
      <h1 class="wd-title">Bookshelf</h1>
      <span class="wd-badge wd-badge--shipped">Shipped</span>
      <span class="wd-cat">reading</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="Bookshelf" category="reading" fixture={fixture} island={BookshelfIsland} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="Bookshelf"
        category="reading"
        island={BookshelfIsland}
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="Bookshelf"
        category="reading"
        island={BookshelfIsland}
        variations={[
          { label: "all-in-progress", fixture: var_all_in_progress, caption: "All books actively in progress — the focused reader mid-sprint." },
          { label: "mixed", fixture: var_mixed, caption: "A healthy mix: finished, reading, and queued up next." },
          { label: "all-completed", fixture: var_all_completed, caption: "Every book checked off — the satisfaction of a cleared queue." },
          { label: "mostly-empty", fixture: var_mostly_empty, caption: "Just started: a single book on an otherwise bare shelf." },
          { label: "dense-shelf", fixture: var_dense_shelf, caption: "Twelve books deep — stress-tests wrapping, scroll, and layout density." },
        ]}
      />
    </section>
    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/reading/Bookshelf.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import Bookshelf from '@lifegames/web/widgets/reading/Bookshelf.astro';
---
&lt;Bookshelf &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/reading/Bookshelf.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/Reading/BookshelfView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/reading/bookshelf.json</code></li>
      </ul>
    </section>
  </div>
  <BookModal />
  <WidgetPageScript />
</body>
</html>
