---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';

import ReadingFeed from '@widgets/reading/ReadingFeed.astro';
import fixture from '@fixtures/reading/reading-feed.json';
import StateMatrix from '../../components/StateMatrix.astro';
import VariationGrid from '../../components/VariationGrid.astro';
import fixture_skeleton from '@fixtures/reading/reading-feed.skeleton.json';
import fixture_empty from '@fixtures/reading/reading-feed.empty.json';
import fixture_populated_min from '@fixtures/reading/reading-feed.populated-min.json';
import fixture_populated_max from '@fixtures/reading/reading-feed.populated-max.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ReadingFeed — Lifegames Design System</title>
  <style is:global>
    html, body {
      margin: 0;
      padding: 0;
      background: var(--bg, #06060f);
      color: var(--text, #e4e4e7);
      font-family: var(--font-family, 'Space Grotesk', sans-serif);
      min-height: 100vh;
    }
    .wd-page {
      max-width: 1200px;
      margin: 0 auto;
      padding: var(--space-32);
    }
    .wd-header {
      display: flex;
      align-items: center;
      gap: var(--space-16);
      margin-bottom: var(--space-32);
      flex-wrap: wrap;
    }
    .wd-back {
      font-size: var(--font-size-sm);
      color: var(--text-muted);
      text-decoration: none;
      letter-spacing: 1px;
      transition: color 0.18s ease;
    }
    .wd-back:hover {
      color: var(--text);
    }
    .wd-title {
      font-size: var(--font-size-hero);
      font-weight: 700;
      margin: 0;
      letter-spacing: 1px;
    }
    .wd-badge {
      font-size: var(--font-size-xs);
      letter-spacing: 1px;
      text-transform: uppercase;
      padding: var(--space-2) var(--space-8);
      border-radius: var(--radius-sm);
    }
    .wd-badge--shipped {
      background: rgba(6, 214, 160, 0.12);
      color: var(--neon-green);
      border: 1px solid rgba(6, 214, 160, 0.25);
    }
    .wd-badge--dev {
      background: rgba(245, 158, 11, 0.08);
      color: var(--neon-amber);
      border: 1px solid rgba(245, 158, 11, 0.25);
    }
    .wd-cat {
      font-size: var(--font-size-xs);
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 2px;
    }
    .wd-section {
      margin-bottom: var(--space-32);
    }
    .wd-section-title {
      font-size: var(--font-size-lg);
      font-weight: 600;
      margin: 0 0 var(--space-16);
      letter-spacing: 1px;
      border-bottom: 1px solid var(--card-border);
      padding-bottom: var(--space-8);
    }
    .wd-demo {
      border: 1px solid var(--card-border);
      border-radius: var(--radius-xl);
      background: var(--card-bg);
      padding: var(--space-20);
      overflow: hidden;
    }
    .wd-text {
      font-size: var(--font-size-sm);
      color: var(--text-muted);
      line-height: 1.6;
    }
    .wd-code {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid var(--card-border);
      border-radius: var(--radius-md);
      padding: var(--space-16);
      font-size: var(--font-size-sm);
      overflow-x: auto;
      color: var(--text-muted);
    }
    .wd-code code {
      font-family: 'JetBrains Mono', monospace;
    }
    .wd-list {
      list-style: none;
      padding: 0;
      margin: 0;
    }
    .wd-list li {
      font-size: var(--font-size-sm);
      color: var(--text-muted);
      padding: var(--space-6) 0;
      border-bottom: 1px solid rgba(255, 255, 255, 0.04);
    }
    .wd-list li:last-child {
      border-bottom: none;
    }
    .wd-list code {
      font-size: var(--font-size-xs);
      background: rgba(255, 255, 255, 0.06);
      padding: var(--space-2) var(--space-4);
      border-radius: var(--radius-sm);
    }
  </style>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/">&#8592; Back to production mirror</a>

    <div class="wd-header">
      <h1 class="wd-title">ReadingFeed</h1>
      <span class="wd-badge wd-badge--shipped">Shipped</span>
      <span class="wd-cat">reading</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <div class="wd-demo">
      <div data-widget-preview>
        <ReadingFeed {...fixture} />
      </div>
      </div>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="ReadingFeed"
        category="reading"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/reading/ReadingFeed.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import ReadingFeed from '@lifegames/web/widgets/reading/ReadingFeed.astro';
---
&lt;ReadingFeed &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/reading/ReadingFeed.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/Reading/ReadingFeedView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/reading/reading-feed.json</code></li>
      </ul>
    </section>
  </div>
  <script>
    // Bundled module script (W9-exempt): mirror the production updaters.ts
    // pagination behavior on the SSR'd article-list. Splits items into
    // PAGE_SIZE=10 groups and renders numbered buttons below.
    const PAGE_SIZE = 10;
    function paginateReadingFeed(card: HTMLElement): void {
      const body = card.querySelector('.widget-body');
      if (!body) return;
      const list = body.querySelector('.article-list');
      if (!list) return;
      const items = Array.from(list.querySelectorAll('.article-list-item'));
      if (items.length <= PAGE_SIZE) return;

      const totalPages = Math.ceil(items.length / PAGE_SIZE);
      let currentPage = 1;

      const existingPager = body.querySelector('.article-pagination');
      if (existingPager) existingPager.remove();

      const pager = document.createElement('div');
      pager.className = 'article-pagination';
      for (let p = 1; p <= totalPages; p++) {
        const btn = document.createElement('button');
        btn.className = 'article-page-btn' + (p === 1 ? ' article-page-active' : '');
        btn.dataset.page = String(p);
        btn.textContent = String(p);
        btn.setAttribute('aria-label', 'Page ' + p + ' of ' + totalPages);
        if (p === 1) btn.setAttribute('aria-current', 'page');
        pager.appendChild(btn);
      }
      body.appendChild(pager);

      function showPage(page: number): void {
        items.forEach((it, idx) => {
          const visible = idx >= (page - 1) * PAGE_SIZE && idx < page * PAGE_SIZE;
          (it as HTMLElement).style.display = visible ? '' : 'none';
        });
        pager.querySelectorAll<HTMLButtonElement>('.article-page-btn').forEach(btn => {
          const target = Number(btn.dataset.page);
          if (target === page) {
            btn.classList.add('article-page-active');
            btn.setAttribute('aria-current', 'page');
          } else {
            btn.classList.remove('article-page-active');
            btn.removeAttribute('aria-current');
          }
        });
      }

      pager.addEventListener('click', (e) => {
        const target = (e.target as HTMLElement).closest<HTMLButtonElement>('.article-page-btn');
        if (!target) return;
        const targetPage = Number(target.dataset.page);
        if (targetPage && targetPage !== currentPage) {
          currentPage = targetPage;
          showPage(currentPage);
        }
      });

      showPage(currentPage);
    }

    document.querySelectorAll<HTMLElement>('#cardReading, [id="cardReading"]').forEach(paginateReadingFeed);
  </script>
  <script is:inline>
    (function() {
      var s = [".tri-card", ".identity-card", ".left-panel-bio", ".left-panel-status"];
      for (var i = 0; i < s.length; i++) {
        var els = document.querySelectorAll(s[i]);
        for (var j = 0; j < els.length; j++) {
          els[j].classList.add("visible");
        }
      }
      var loading = document.querySelectorAll(".tri-card.is-loading");
      for (var k = 0; k < loading.length; k++) {
        loading[k].classList.remove("is-loading");
      }
      var wks = document.querySelectorAll("#cardWorkouts");
      for (var w = 0; w < wks.length; w++) { wks[w].style.display = ""; }
    })();
  </script>
</body>
</html>
