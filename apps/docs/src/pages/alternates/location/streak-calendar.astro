---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import StreakCalendar from '@widgets/location/StreakCalendar.astro';
import fixture from '@fixtures/location/streak-calendar.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/location/streak-calendar.skeleton.json';
import fixture_empty from '@fixtures/location/streak-calendar.empty.json';
import fixture_populated_min from '@fixtures/location/streak-calendar.populated-min.json';
import fixture_populated_max from '@fixtures/location/streak-calendar.populated-max.json';
import var_a from '@fixtures/location/streak-calendar.variation-a.json';
import var_b from '@fixtures/location/streak-calendar.variation-b.json';
import var_c from '@fixtures/location/streak-calendar.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StreakCalendar — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">StreakCalendar</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">location</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="StreakCalendar" category="location" fixture={fixture} Comp={StreakCalendar} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="StreakCalendar"
        category="location"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="StreakCalendar"
        category="location"
        variations={[
          { label: "perfect-month", fixture: var_a, caption: "Unbroken 30-day streak — all cells filled, streak counter at maximum for a Riverton user." },
          { label: "comeback-kid", fixture: var_b, caption: "Two-day gap mid-month with strong recovery — current streak of 16 after the break." },
          { label: "weekend-only", fixture: var_c, caption: "Weekdays mostly missed, weekends always hit — clear weekly rhythm gap in the calendar grid." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/location/StreakCalendar.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import StreakCalendar from '@lifegames/web/widgets/location/StreakCalendar.astro';
---
&lt;StreakCalendar &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/location/StreakCalendar.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/Location/StreakCalendarView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/location/streak-calendar.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
