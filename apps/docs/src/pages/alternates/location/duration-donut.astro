---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import DurationDonut from '@widgets/location/DurationDonut.astro';
import fixture from '@fixtures/location/duration-donut.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/location/duration-donut.skeleton.json';
import fixture_empty from '@fixtures/location/duration-donut.empty.json';
import fixture_populated_min from '@fixtures/location/duration-donut.populated-min.json';
import fixture_populated_max from '@fixtures/location/duration-donut.populated-max.json';
import var_a from '@fixtures/location/duration-donut.variation-a.json';
import var_b from '@fixtures/location/duration-donut.variation-b.json';
import var_c from '@fixtures/location/duration-donut.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DurationDonut — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">DurationDonut</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">location</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="DurationDonut" category="location" fixture={fixture} Comp={DurationDonut} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="DurationDonut"
        category="location"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="DurationDonut"
        category="location"
        variations={[
          { label: "deep-worker", fixture: var_a, caption: "Home and office dominate two large arcs — long uninterrupted focus blocks in Solburg." },
          { label: "commuter-grind", fixture: var_b, caption: "Transit leads at 34% — long daily commute bookending moderate office time on the Northgate corridor." },
          { label: "night-owl", fixture: var_c, caption: "Evening-skewed duration — nightlife, food, and arts fill the Kelvin Heights arts district hours." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/location/DurationDonut.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import DurationDonut from '@lifegames/web/widgets/location/DurationDonut.astro';
---
&lt;DurationDonut &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/location/DurationDonut.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/Location/DurationDonutView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/location/duration-donut.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
