---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import TopRepos from '@widgets/github/TopRepos.astro';
import fixture from '@fixtures/github/top-repos.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/top-repos.skeleton.json';
import fixture_empty from '@fixtures/github/top-repos.empty.json';
import fixture_populated_min from '@fixtures/github/top-repos.populated-min.json';
import fixture_populated_max from '@fixtures/github/top-repos.populated-max.json';
import var_a from '@fixtures/github/top-repos.variation-a.json';
import var_b from '@fixtures/github/top-repos.variation-b.json';
import var_c from '@fixtures/github/top-repos.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>TopRepos — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">TopRepos</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="TopRepos" category="github" fixture={fixture} Comp={TopRepos} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="TopRepos"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="TopRepos"
        category="github"
        variations={[
          { label: "star-ranked", fixture: var_a, caption: "Top 5 repos by star count — polyglot portfolio spanning TypeScript, Go, Rust, and Shell." },
          { label: "systems-focus", fixture: var_b, caption: "Rust and C dominate — embedded, consensus algorithms, and no-std allocator repos lead the ranking." },
          { label: "ts-monolith", fixture: var_c, caption: "All top 5 repos are TypeScript — API gateway, monorepo dashboard, hook libraries, and config tooling." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/TopRepos.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import TopRepos from '@lifegames/web/widgets/github/TopRepos.astro';
---
&lt;TopRepos &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/TopRepos.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/TopReposView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/top-repos.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
