---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import PinnedRepos from '@widgets/github/PinnedRepos.astro';
import fixture from '@fixtures/github/pinned-repos.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/pinned-repos.skeleton.json';
import fixture_empty from '@fixtures/github/pinned-repos.empty.json';
import fixture_populated_min from '@fixtures/github/pinned-repos.populated-min.json';
import fixture_populated_max from '@fixtures/github/pinned-repos.populated-max.json';
import var_oss_portfolio from '@fixtures/github/pinned-repos.variation-a.json';
import var_tool_collection from '@fixtures/github/pinned-repos.variation-b.json';
import var_archived_classics from '@fixtures/github/pinned-repos.variation-c.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>PinnedRepos — Lifegames Design System</title>
  </head>
  <body>
    <div class="wd-page">
      <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

      <div class="wd-header">
        <h1 class="wd-title">PinnedRepos</h1>
        <span class="wd-badge wd-badge--dev">Alternate</span>
        <span class="wd-cat">github</span>
      </div>

      <section class="wd-section">
        <h2 class="wd-section-title">Live Demo</h2>
        <ResponsiveDemo
          widgetName="PinnedRepos"
          category="github"
          fixture={fixture}
          Comp={PinnedRepos}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">State Matrix</h2>
        <StateMatrix
          widgetName="PinnedRepos"
          category="github"
          states={[
            { state: 'skeleton', fixture: fixture_skeleton },
            { state: 'empty', fixture: fixture_empty },
            { state: 'populated-min', fixture: fixture_populated_min },
            { state: 'populated-max', fixture: fixture_populated_max },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Variations</h2>
        <VariationGrid
          widgetName="PinnedRepos"
          category="github"
          variations={[
            {
              label: 'oss-portfolio',
              fixture: var_oss_portfolio,
              caption:
                'Six high-star OSS repos pinned as a developer portfolio — flagship projects front and center.',
            },
            {
              label: 'tool-collection',
              fixture: var_tool_collection,
              caption:
                'Four small personal utility repos with modest star counts — productivity scripts and configs.',
            },
            {
              label: 'archived-classics',
              fixture: var_archived_classics,
              caption:
                'Two of four pinned repos are archived — historical work kept visible alongside active projects.',
            },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Props</h2>
        <p class="wd-text">
          See <code>packages/web/src/widgets/github/PinnedRepos.types.ts</code> for the full interface.
        </p>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Usage</h2>
        <pre
          class="wd-code"><code>---
import PinnedRepos from '@lifegames/web/widgets/github/PinnedRepos.astro';
---
&lt;PinnedRepos &#123;...data&#125; /&gt;</code></pre>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Cross-Platform</h2>
        <ul class="wd-list">
          <li>
            <strong>Web:</strong>
            <code>packages/web/src/widgets/github/PinnedRepos.astro</code>
          </li>
          <li>
            <strong>iOS:</strong>
            <code>Sources/LifegamesWidgets/GitHub/PinnedReposView.swift</code>
          </li>
          <li>
            <strong>Fixture:</strong>
            <code>Sources/LifegamesWidgets/Resources/widgets/github/pinned-repos.json</code>
          </li>
        </ul>
      </section>
    </div>
    <WidgetPageScript />
  </body>
</html>
