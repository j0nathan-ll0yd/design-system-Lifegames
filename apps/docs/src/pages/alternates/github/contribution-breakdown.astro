---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import ContributionBreakdown from '@widgets/github/ContributionBreakdown.astro';
import fixture from '@fixtures/github/contribution-breakdown.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/contribution-breakdown.skeleton.json';
import fixture_empty from '@fixtures/github/contribution-breakdown.empty.json';
import fixture_populated_min from '@fixtures/github/contribution-breakdown.populated-min.json';
import fixture_populated_max from '@fixtures/github/contribution-breakdown.populated-max.json';
import var_commit_dominant from '@fixtures/github/contribution-breakdown.commit-dominant.json';
import var_pr_dominant from '@fixtures/github/contribution-breakdown.pr-dominant.json';
import var_review_specialist from '@fixtures/github/contribution-breakdown.review-specialist.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ContributionBreakdown — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">ContributionBreakdown</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="ContributionBreakdown" category="github" fixture={fixture} Comp={ContributionBreakdown} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="ContributionBreakdown"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="ContributionBreakdown"
        category="github"
        variations={[
          { label: "commit-dominant", fixture: var_commit_dominant, caption: "78% commits, 12% PRs — ada-dev as a solo-project maintainer with high commit count and minimal collaboration overhead." },
          { label: "pr-dominant", fixture: var_pr_dominant, caption: "55% PRs, 15% commits — r-mendez on a team with a strict PR workflow where every change goes through a review cycle." },
          { label: "review-specialist", fixture: var_review_specialist, caption: "70% reviews, 8% commits — senior ada-dev spending most time reviewing others' work on acme-corp repos." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/ContributionBreakdown.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import ContributionBreakdown from '@lifegames/web/widgets/github/ContributionBreakdown.astro';
---
&lt;ContributionBreakdown &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/ContributionBreakdown.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/ContributionBreakdownView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/contribution-breakdown.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
