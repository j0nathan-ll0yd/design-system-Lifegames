---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import ContributionGrid from '@widgets/github/ContributionGrid.astro';
import fixture from '@fixtures/github/contribution-grid.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/contribution-grid.skeleton.json';
import fixture_empty from '@fixtures/github/contribution-grid.empty.json';
import fixture_populated_min from '@fixtures/github/contribution-grid.populated-min.json';
import fixture_populated_max from '@fixtures/github/contribution-grid.populated-max.json';
import var_a from '@fixtures/github/contribution-grid.variation-a.json';
import var_b from '@fixtures/github/contribution-grid.variation-b.json';
import var_c from '@fixtures/github/contribution-grid.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ContributionGrid — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">ContributionGrid</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="ContributionGrid" category="github" fixture={fixture} Comp={ContributionGrid} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="ContributionGrid"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="ContributionGrid"
        category="github"
        variations={[
          { label: "top-left-cluster", fixture: var_a, caption: "Contributions concentrated in early weeks with a mid-year gap — j-howard front-loads work Jan–Apr." },
          { label: "weekend-warrior", fixture: var_b, caption: "Saturdays and Sundays lit up while weekdays are nearly empty — r-mendez side project year." },
          { label: "uniform-moderate", fixture: var_c, caption: "Every cell roughly the same shade — mira-c extremely consistent with no peaks or valleys across 52 weeks." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/ContributionGrid.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import ContributionGrid from '@lifegames/web/widgets/github/ContributionGrid.astro';
---
&lt;ContributionGrid &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/ContributionGrid.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/ContributionGridView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/contribution-grid.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
