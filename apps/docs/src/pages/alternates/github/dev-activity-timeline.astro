---
import '@j0nathan-ll0yd/tokens/fonts';
import '@j0nathan-ll0yd/tokens/css';
import '@j0nathan-ll0yd/tokens/compat';
import '@styles/components.css';
import '@j0nathan-ll0yd/tokens/effects';
import '@styles/layout.css';
import '@j0nathan-ll0yd/tokens/base';
import '@docs-styles/docs-chrome.css';

import DevActivityTimeline from '@widgets/github/DevActivityTimeline.astro';
import fixture from '@fixtures/github/dev-activity-timeline.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/dev-activity-timeline.skeleton.json';
import fixture_empty from '@fixtures/github/dev-activity-timeline.empty.json';
import fixture_populated_min from '@fixtures/github/dev-activity-timeline.populated-min.json';
import fixture_populated_max from '@fixtures/github/dev-activity-timeline.populated-max.json';
import var_a from '@fixtures/github/dev-activity-timeline.variation-a.json';
import var_b from '@fixtures/github/dev-activity-timeline.variation-b.json';
import var_c from '@fixtures/github/dev-activity-timeline.variation-c.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevActivityTimeline — Lifegames Design System</title>
  </head>
  <body>
    <div class="wd-page">
      <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

      <div class="wd-header">
        <h1 class="wd-title">DevActivityTimeline</h1>
        <span class="wd-badge wd-badge--dev">Alternate</span>
        <span class="wd-cat">github</span>
      </div>

      <section class="wd-section">
        <h2 class="wd-section-title">Live Demo</h2>
        <ResponsiveDemo
          widgetName="DevActivityTimeline"
          category="github"
          fixture={fixture}
          Comp={DevActivityTimeline}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">State Matrix</h2>
        <StateMatrix
          widgetName="DevActivityTimeline"
          category="github"
          states={[
            { state: 'skeleton', fixture: fixture_skeleton },
            { state: 'empty', fixture: fixture_empty },
            { state: 'populated-min', fixture: fixture_populated_min },
            { state: 'populated-max', fixture: fixture_populated_max },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Variations</h2>
        <VariationGrid
          widgetName="DevActivityTimeline"
          category="github"
          variations={[
            {
              label: 'parallel-work',
              fixture: var_a,
              caption:
                'Three repos advancing simultaneously — j-howard juggling v3 API, sensor protocol, and CLI command across two weeks.',
            },
            {
              label: 'blocked-period',
              fixture: var_b,
              caption:
                '10-day gap awaiting design review approval — r-mendez blocked on OAuth 2.1 migration before merge.',
            },
            {
              label: 'hotfix-sprint',
              fixture: var_c,
              caption:
                'Normal timeline interrupted by three hotfixes in 48 hours — ada-dev responding to a production incident.',
            },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Props</h2>
        <p class="wd-text">
          See <code>packages/web/src/widgets/github/DevActivityTimeline.types.ts</code> for the full
          interface.
        </p>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Usage</h2>
        <pre
          class="wd-code"><code>---
import DevActivityTimeline from '@j0nathan-ll0yd/web/widgets/github/DevActivityTimeline.astro';
---
&lt;DevActivityTimeline &#123;...data&#125; /&gt;</code></pre>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Cross-Platform</h2>
        <ul class="wd-list">
          <li>
            <strong>Web:</strong>
            <code>packages/web/src/widgets/github/DevActivityTimeline.astro</code>
          </li>
          <li>
            <strong>iOS:</strong>
            <code>Sources/LifegamesWidgets/GitHub/DevActivityTimelineView.swift</code>
          </li>
          <li>
            <strong>Fixture:</strong>
            <code>Sources/LifegamesWidgets/Resources/widgets/github/dev-activity-timeline.json</code
            >
          </li>
        </ul>
      </section>
    </div>
    <WidgetPageScript />
  </body>
</html>
