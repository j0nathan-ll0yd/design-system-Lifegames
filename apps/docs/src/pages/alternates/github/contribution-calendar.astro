---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import ContributionCalendar from '@widgets/github/ContributionCalendar.astro';
import fixture from '@fixtures/github/contribution-calendar.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/contribution-calendar.skeleton.json';
import fixture_empty from '@fixtures/github/contribution-calendar.empty.json';
import fixture_populated_min from '@fixtures/github/contribution-calendar.populated-min.json';
import fixture_populated_max from '@fixtures/github/contribution-calendar.populated-max.json';
import var_dense_year from '@fixtures/github/contribution-calendar.dense-year.json';
import var_sparse_quarter from '@fixtures/github/contribution-calendar.sparse-quarter.json';
import var_weekend_only from '@fixtures/github/contribution-calendar.weekend-only.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ContributionCalendar — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">ContributionCalendar</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="ContributionCalendar" category="github" fixture={fixture} Comp={ContributionCalendar} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="ContributionCalendar"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="ContributionCalendar"
        category="github"
        variations={[
          { label: "dense-year", fixture: var_dense_year, caption: "300+ contribution days with deep green across the board — ada-dev's prolific year with only a few white squares during a week-long vacation." },
          { label: "sparse-quarter", fixture: var_sparse_quarter, caption: "Only Q4 active, rest of year empty — mira-c joining a new team mid-year with a ramp visible in October." },
          { label: "weekend-only", fixture: var_weekend_only, caption: "Saturdays and Sundays lit up, weekdays mostly empty — r-mendez's side project year showing a distinctive column pattern." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/ContributionCalendar.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import ContributionCalendar from '@lifegames/web/widgets/github/ContributionCalendar.astro';
---
&lt;ContributionCalendar &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/ContributionCalendar.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/ContributionCalendarView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/contribution-calendar.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
