---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import LanguageGrid from '@widgets/github/LanguageGrid.astro';
import fixture from '@fixtures/github/language-grid.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/language-grid.skeleton.json';
import fixture_empty from '@fixtures/github/language-grid.empty.json';
import fixture_populated_min from '@fixtures/github/language-grid.populated-min.json';
import fixture_populated_max from '@fixtures/github/language-grid.populated-max.json';
import var_cohesive_ts from '@fixtures/github/language-grid.variation-a.json';
import var_migration from '@fixtures/github/language-grid.variation-b.json';
import var_experiments from '@fixtures/github/language-grid.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LanguageGrid — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">LanguageGrid</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="LanguageGrid" category="github" fixture={fixture} Comp={LanguageGrid} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="LanguageGrid"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="LanguageGrid"
        category="github"
        variations={[
          { label: "cohesive-ts-stack", fixture: var_cohesive_ts, caption: "All repos in TypeScript with CSS and JSON minor shares — a monochromatic full-stack shop." },
          { label: "language-migration", fixture: var_migration, caption: "Older repos in Python, newer repos in Go — a stack migration visible in the grid chronology." },
          { label: "tiny-experiments", fixture: var_experiments, caption: "Weekend language experiments: Elixir, Zig, Gleam, Nim, Haskell, Clojure — one repo each." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/LanguageGrid.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import LanguageGrid from '@lifegames/web/widgets/github/LanguageGrid.astro';
---
&lt;LanguageGrid &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/LanguageGrid.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/LanguageGridView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/language-grid.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
