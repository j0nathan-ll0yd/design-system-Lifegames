---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import DevActivityPulse from '@widgets/github/DevActivityPulse.astro';
import fixture from '@fixtures/github/dev-activity-pulse.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/dev-activity-pulse.skeleton.json';
import fixture_empty from '@fixtures/github/dev-activity-pulse.empty.json';
import fixture_populated_min from '@fixtures/github/dev-activity-pulse.populated-min.json';
import fixture_populated_max from '@fixtures/github/dev-activity-pulse.populated-max.json';
import var_a from '@fixtures/github/dev-activity-pulse.variation-a.json';
import var_b from '@fixtures/github/dev-activity-pulse.variation-b.json';
import var_c from '@fixtures/github/dev-activity-pulse.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DevActivityPulse — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">DevActivityPulse</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="DevActivityPulse" category="github" fixture={fixture} Comp={DevActivityPulse} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="DevActivityPulse"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="DevActivityPulse"
        category="github"
        variations={[
          { label: "hotfix-burst", fixture: var_a, caption: "Three rapid security fixes in under two hours — production incident response with small targeted patches." },
          { label: "weekend-warrior", fixture: var_b, caption: "Sparse weekday commits with a weekend cluster — r-mendez side project on kelvin-foundry/cli-tools." },
          { label: "hackathon-day", fixture: var_c, caption: "14-hour Saturday session at northbridge-labs/hackathon-2025 — 800+ additions in a single burst day." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/DevActivityPulse.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import DevActivityPulse from '@lifegames/web/widgets/github/DevActivityPulse.astro';
---
&lt;DevActivityPulse &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/DevActivityPulse.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/DevActivityPulseView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/dev-activity-pulse.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
