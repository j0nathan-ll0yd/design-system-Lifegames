---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import WeeklyPulse from '@widgets/github/WeeklyPulse.astro';
import fixture from '@fixtures/github/weekly-pulse.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/weekly-pulse.skeleton.json';
import fixture_empty from '@fixtures/github/weekly-pulse.empty.json';
import fixture_populated_min from '@fixtures/github/weekly-pulse.populated-min.json';
import fixture_populated_max from '@fixtures/github/weekly-pulse.populated-max.json';
import var_a from '@fixtures/github/weekly-pulse.variation-a.json';
import var_b from '@fixtures/github/weekly-pulse.variation-b.json';
import var_c from '@fixtures/github/weekly-pulse.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>WeeklyPulse — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">WeeklyPulse</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="WeeklyPulse" category="github" fixture={fixture} Comp={WeeklyPulse} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="WeeklyPulse"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="WeeklyPulse"
        category="github"
        variations={[
          { label: "monday-kickoff", fixture: var_a, caption: "Front-loaded week — highest activity Monday, steadily declining through Friday, near-zero on weekends." },
          { label: "friday-sprint", fixture: var_b, caption: "Back-loaded week — low start, then a large Friday spike as PRs and commits cluster before the weekend." },
          { label: "weekend-warrior", fixture: var_c, caption: "Side-project contributor — near-zero Monday through Friday, large Saturday and Sunday spikes." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/WeeklyPulse.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import WeeklyPulse from '@lifegames/web/widgets/github/WeeklyPulse.astro';
---
&lt;WeeklyPulse &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/WeeklyPulse.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/WeeklyPulseView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/weekly-pulse.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
