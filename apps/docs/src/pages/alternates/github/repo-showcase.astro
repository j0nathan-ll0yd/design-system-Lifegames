---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import RepoShowcase from '@widgets/github/RepoShowcase.astro';
import fixture from '@fixtures/github/repo-showcase.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/repo-showcase.skeleton.json';
import fixture_empty from '@fixtures/github/repo-showcase.empty.json';
import fixture_populated_min from '@fixtures/github/repo-showcase.populated-min.json';
import fixture_populated_max from '@fixtures/github/repo-showcase.populated-max.json';
import var_flagship from '@fixtures/github/repo-showcase.variation-a.json';
import var_revived from '@fixtures/github/repo-showcase.variation-b.json';
import var_mixed_types from '@fixtures/github/repo-showcase.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>RepoShowcase — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">RepoShowcase</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="RepoShowcase" category="github" fixture={fixture} Comp={RepoShowcase} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="RepoShowcase"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="RepoShowcase"
        category="github"
        variations={[
          { label: "flagship", fixture: var_flagship, caption: "Single high-star flagship project with full topic tags and active issue backlog." },
          { label: "revived-and-archived", fixture: var_revived, caption: "A revived repo alongside an archived predecessor — contrasting activity states side by side." },
          { label: "mixed-types", fixture: var_mixed_types, caption: "Monorepo, educational template, and library repo — three structurally different project types." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/RepoShowcase.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import RepoShowcase from '@lifegames/web/widgets/github/RepoShowcase.astro';
---
&lt;RepoShowcase &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/RepoShowcase.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/RepoShowcaseView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/repo-showcase.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
