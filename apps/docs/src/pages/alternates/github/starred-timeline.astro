---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import StarredTimeline from '@widgets/github/StarredTimeline.astro';
import fixture from '@fixtures/github/starred-timeline.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/starred-timeline.skeleton.json';
import fixture_empty from '@fixtures/github/starred-timeline.empty.json';
import fixture_populated_min from '@fixtures/github/starred-timeline.populated-min.json';
import fixture_populated_max from '@fixtures/github/starred-timeline.populated-max.json';
import var_a from '@fixtures/github/starred-timeline.variation-a.json';
import var_b from '@fixtures/github/starred-timeline.variation-b.json';
import var_c from '@fixtures/github/starred-timeline.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StarredTimeline — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">StarredTimeline</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="StarredTimeline" category="github" fixture={fixture} Comp={StarredTimeline} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="StarredTimeline"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="StarredTimeline"
        category="github"
        variations={[
          { label: "binge-then-quiet", fixture: var_a, caption: "Four TypeScript repos starred in a 3-day research sprint, then a single older Go star from months prior." },
          { label: "steady-trickle", fixture: var_b, caption: "Shell and Go tools starred steadily over weeks — dotfiles, TUI kit, and a legacy Rust sensor library." },
          { label: "single-topic-deep-dive", fixture: var_c, caption: "Six Rust repos starred over five consecutive days — embedded, consensus algorithms, WASM, and systems work." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/StarredTimeline.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import StarredTimeline from '@lifegames/web/widgets/github/StarredTimeline.astro';
---
&lt;StarredTimeline &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/StarredTimeline.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/StarredTimelineView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/starred-timeline.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
