---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import StarredByLanguage from '@widgets/github/StarredByLanguage.astro';
import fixture from '@fixtures/github/starred-by-language.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/starred-by-language.skeleton.json';
import fixture_empty from '@fixtures/github/starred-by-language.empty.json';
import fixture_populated_min from '@fixtures/github/starred-by-language.populated-min.json';
import fixture_populated_max from '@fixtures/github/starred-by-language.populated-max.json';
import var_ts_focus from '@fixtures/github/starred-by-language.variation-a.json';
import var_tool_hoarder from '@fixtures/github/starred-by-language.variation-b.json';
import var_niche_systems from '@fixtures/github/starred-by-language.variation-c.json';
---

<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>StarredByLanguage — Lifegames Design System</title>
</head>
<body>
  <div class="wd-page">
    <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

    <div class="wd-header">
      <h1 class="wd-title">StarredByLanguage</h1>
      <span class="wd-badge wd-badge--dev">Alternate</span>
      <span class="wd-cat">github</span>
    </div>

    <section class="wd-section">
      <h2 class="wd-section-title">Live Demo</h2>
      <ResponsiveDemo widgetName="StarredByLanguage" category="github" fixture={fixture} Comp={StarredByLanguage} />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">State Matrix</h2>
      <StateMatrix
        widgetName="StarredByLanguage"
        category="github"
        states={[{ state: "skeleton", fixture: fixture_skeleton }, { state: "empty", fixture: fixture_empty }, { state: "populated-min", fixture: fixture_populated_min }, { state: "populated-max", fixture: fixture_populated_max }]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Variations</h2>
      <VariationGrid
        widgetName="StarredByLanguage"
        category="github"
        variations={[
          { label: "typescript-focus", fixture: var_ts_focus, caption: "TypeScript-dominant stargazer with 5 TS repos and a smattering of legacy JavaScript." },
          { label: "tool-hoarder", fixture: var_tool_hoarder, caption: "Go and Shell dominated — starring CLIs, scripts, and dev-tool utilities exclusively." },
          { label: "niche-systems", fixture: var_niche_systems, caption: "Rust, C, and Zig only — embedded and systems niche with no web repos in sight." },
        ]}
      />
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Props</h2>
      <p class="wd-text">
        See <code>packages/web/src/widgets/github/StarredByLanguage.types.ts</code> for the full interface.
      </p>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Usage</h2>
      <pre class="wd-code"><code>---
import StarredByLanguage from '@lifegames/web/widgets/github/StarredByLanguage.astro';
---
&lt;StarredByLanguage &#123;...data&#125; /&gt;</code></pre>
    </section>

    <section class="wd-section">
      <h2 class="wd-section-title">Cross-Platform</h2>
      <ul class="wd-list">
        <li><strong>Web:</strong> <code>packages/web/src/widgets/github/StarredByLanguage.astro</code></li>
        <li><strong>iOS:</strong> <code>Sources/LifegamesWidgets/GitHub/StarredByLanguageView.swift</code></li>
        <li><strong>Fixture:</strong> <code>Sources/LifegamesWidgets/Resources/widgets/github/starred-by-language.json</code></li>
      </ul>
    </section>
  </div>
  <WidgetPageScript />
</body>
</html>
