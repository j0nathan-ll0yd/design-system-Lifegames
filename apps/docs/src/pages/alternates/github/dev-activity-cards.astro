---
import '@lifegames/tokens/fonts';
import '@lifegames/tokens/css';
import '@lifegames/tokens/compat';
import '@lifegames/tokens/components';
import '@lifegames/tokens/effects';
import '@lifegames/tokens/layout';
import '@lifegames/tokens/base';
import '@lifegames/tokens/docs-chrome';

import DevActivityCards from '@widgets/github/DevActivityCards.astro';
import fixture from '@fixtures/github/dev-activity-cards.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/github/dev-activity-cards.skeleton.json';
import fixture_empty from '@fixtures/github/dev-activity-cards.empty.json';
import fixture_populated_min from '@fixtures/github/dev-activity-cards.populated-min.json';
import fixture_populated_max from '@fixtures/github/dev-activity-cards.populated-max.json';
import var_a from '@fixtures/github/dev-activity-cards.variation-a.json';
import var_b from '@fixtures/github/dev-activity-cards.variation-b.json';
import var_c from '@fixtures/github/dev-activity-cards.variation-c.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DevActivityCards — Lifegames Design System</title>
  </head>
  <body>
    <div class="wd-page">
      <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

      <div class="wd-header">
        <h1 class="wd-title">DevActivityCards</h1>
        <span class="wd-badge wd-badge--dev">Alternate</span>
        <span class="wd-cat">github</span>
      </div>

      <section class="wd-section">
        <h2 class="wd-section-title">Live Demo</h2>
        <ResponsiveDemo
          widgetName="DevActivityCards"
          category="github"
          fixture={fixture}
          Comp={DevActivityCards}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">State Matrix</h2>
        <StateMatrix
          widgetName="DevActivityCards"
          category="github"
          states={[
            { state: 'skeleton', fixture: fixture_skeleton },
            { state: 'empty', fixture: fixture_empty },
            { state: 'populated-min', fixture: fixture_populated_min },
            { state: 'populated-max', fixture: fixture_populated_max },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Variations</h2>
        <VariationGrid
          widgetName="DevActivityCards"
          category="github"
          variations={[
            {
              label: 'refactor-sprint',
              fixture: var_a,
              caption:
                'High deletion counts dominate — r-mendez cleaning up sensor-mesh legacy code before v3, deletions outpacing additions.',
            },
            {
              label: 'docs-blitz',
              fixture: var_b,
              caption:
                'All additions in .md files — mira-c documentation sprint on acme-corp/docs with zero code changes.',
            },
            {
              label: 'test-suite',
              fixture: var_c,
              caption:
                'Additions concentrated in test files — j-howard coverage improvement initiative on solstice-systems/dashboard.',
            },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Props</h2>
        <p class="wd-text">
          See <code>packages/web/src/widgets/github/DevActivityCards.types.ts</code> for the full interface.
        </p>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Usage</h2>
        <pre
          class="wd-code"><code>---
import DevActivityCards from '@lifegames/web/widgets/github/DevActivityCards.astro';
---
&lt;DevActivityCards &#123;...data&#125; /&gt;</code></pre>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Cross-Platform</h2>
        <ul class="wd-list">
          <li>
            <strong>Web:</strong>
            <code>packages/web/src/widgets/github/DevActivityCards.astro</code>
          </li>
          <li>
            <strong>iOS:</strong>
            <code>Sources/LifegamesWidgets/GitHub/DevActivityCardsView.swift</code>
          </li>
          <li>
            <strong>Fixture:</strong>
            <code>Sources/LifegamesWidgets/Resources/widgets/github/dev-activity-cards.json</code>
          </li>
        </ul>
      </section>
    </div>
    <WidgetPageScript />
  </body>
</html>
