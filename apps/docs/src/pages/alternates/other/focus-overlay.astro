---
import '@j0nathan-ll0yd/tokens/fonts';
import '@j0nathan-ll0yd/tokens/css';
import '@j0nathan-ll0yd/tokens/compat';
import '@j0nathan-ll0yd/tokens/components';
import '@j0nathan-ll0yd/tokens/effects';
import '@j0nathan-ll0yd/tokens/layout';
import '@j0nathan-ll0yd/tokens/base';
import '@j0nathan-ll0yd/tokens/docs-chrome';

import FocusOverlay from '@widgets/other/FocusOverlay.astro';
import fixture from '@fixtures/other/focus-overlay.json';
import StateMatrix from '../../../components/StateMatrix.astro';
import VariationGrid from '../../../components/VariationGrid.astro';
import ResponsiveDemo from '../../../components/ResponsiveDemo.astro';
import WidgetPageScript from '../../../components/WidgetPageScript.astro';
import fixture_skeleton from '@fixtures/other/focus-overlay.skeleton.json';
import fixture_empty from '@fixtures/other/focus-overlay.empty.json';
import fixture_populated_min from '@fixtures/other/focus-overlay.populated-min.json';
import fixture_populated_max from '@fixtures/other/focus-overlay.populated-max.json';
import var_default from '@fixtures/other/focus-overlay.default.json';
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FocusOverlay — Lifegames Design System</title>
  </head>
  <body>
    <div class="wd-page">
      <a class="wd-back" href="/alternates/">&#8592; Back to alternates</a>

      <div class="wd-header">
        <h1 class="wd-title">FocusOverlay</h1>
        <span class="wd-badge wd-badge--dev">Alternate</span>
        <span class="wd-cat">other</span>
      </div>

      <section class="wd-section">
        <h2 class="wd-section-title">Live Demo</h2>
        <ResponsiveDemo
          widgetName="FocusOverlay"
          category="other"
          fixture={fixture}
          Comp={FocusOverlay}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">State Matrix</h2>
        <StateMatrix
          widgetName="FocusOverlay"
          category="other"
          states={[
            { state: 'skeleton', fixture: fixture_skeleton },
            { state: 'empty', fixture: fixture_empty },
            { state: 'populated-min', fixture: fixture_populated_min },
            { state: 'populated-max', fixture: fixture_populated_max },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Variations</h2>
        <VariationGrid
          widgetName="FocusOverlay"
          category="other"
          variations={[
            {
              label: 'default',
              fixture: var_default,
              caption: 'This widget is presentational — no state variations.',
            },
          ]}
        />
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Props</h2>
        <p class="wd-text">
          See <code>packages/web/src/widgets/other/FocusOverlay.types.ts</code> for the full interface.
          FocusOverlay accepts no props — it renders as a fixed shift-active overlay activated by <code
            >live-data.ts</code
          > when <code>currentFocus === 'Work'</code>.
        </p>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Usage</h2>
        <pre
          class="wd-code"><code>---
import FocusOverlay from '@j0nathan-ll0yd/web/widgets/other/FocusOverlay.astro';
---
&lt;FocusOverlay /&gt;</code></pre>
      </section>

      <section class="wd-section">
        <h2 class="wd-section-title">Cross-Platform</h2>
        <ul class="wd-list">
          <li>
            <strong>Web:</strong>
            <code>packages/web/src/widgets/other/FocusOverlay.astro</code>
          </li>
          <li>
            <strong>iOS:</strong>
            <code>Sources/LifegamesWidgets/Other/FocusOverlayView.swift</code>
          </li>
          <li>
            <strong>Fixture:</strong>
            <code>Sources/LifegamesWidgets/Resources/widgets/other/focus-overlay.json</code>
          </li>
        </ul>
      </section>
    </div>
    <WidgetPageScript />
  </body>
</html>
