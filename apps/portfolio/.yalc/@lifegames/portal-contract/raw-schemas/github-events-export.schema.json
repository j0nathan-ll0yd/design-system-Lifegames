{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "number": {
            "type": "number"
          },
          "hash": {
            "type": "string"
          },
          "additions": {
            "type": "number"
          },
          "deletions": {
            "type": "number"
          }
        },
        "required": [
          "type",
          "repo",
          "title",
          "date"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generatedAt",
    "events"
  ],
  "additionalProperties": false
}
