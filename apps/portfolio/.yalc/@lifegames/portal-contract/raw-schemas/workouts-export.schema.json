{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "date": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "workouts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "activityType": {
            "type": "string"
          },
          "duration": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "energyBurned": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "distance": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "type": "string"
          }
        },
        "required": [
          "activityType",
          "duration",
          "energyBurned",
          "distance",
          "source"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "date",
    "generatedAt",
    "workouts"
  ],
  "additionalProperties": false
}
