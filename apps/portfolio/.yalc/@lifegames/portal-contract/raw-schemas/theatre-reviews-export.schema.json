{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "generatedAt": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "const": "coasttocoastreviews.com"
    },
    "totalReviews": {
      "type": "number"
    },
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "author": {
            "type": "string"
          },
          "publishedAt": {
            "type": "string"
          },
          "rating": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "ratingNumeric": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "excerpt": {
            "type": "string"
          },
          "imageUrl": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "imageWidth": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          },
          "imageHeight": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "title",
          "slug",
          "url",
          "author",
          "publishedAt",
          "rating",
          "ratingNumeric",
          "excerpt",
          "imageUrl",
          "imageWidth",
          "imageHeight"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "generatedAt",
    "source",
    "totalReviews",
    "reviews"
  ],
  "additionalProperties": false
}
