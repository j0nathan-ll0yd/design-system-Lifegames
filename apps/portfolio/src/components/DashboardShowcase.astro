---
// Shared static-showcase dashboard body, rendered identically by `/` (baseline)
// and every `/scenarios/<name>/` page. All data is supplied by the caller from
// `getScenarioData(scenario)` (src/lib/scenario-data.ts) — the canonical
// `@lifegames/fixtures` source. This component owns NO data fetching: the
// portfolio is a static build, so each scenario is a distinct build-time render.
import Dashboard from '../layouts/Dashboard.astro';
import IdentityCard from '@widgets/identity/IdentityCard.astro';
import BioTerminal from '@lifegames/web/production/BioTerminal.astro';
import SystemStatus from '@widgets/other/SystemStatus.astro';
import HeartRate from '@widgets/health/HeartRate.astro';
import Workouts from '@widgets/health/Workouts.astro';
import NightSummary from '@widgets/health/NightSummary.astro';
import Hydration from '@lifegames/web/production/Hydration.astro';
import StarredRepoList from '@widgets/github/StarredRepoList.astro';
import DevActivityLog from '@widgets/github/DevActivityLog.astro';
import ReadingFeed from '@widgets/reading/ReadingFeed.astro';
import Bookshelf from '@widgets/reading/Bookshelf.astro';
import BookModal from '@widgets/reading/BookModal.astro';
import FocusOverlay from '@widgets/other/FocusOverlay.astro';
import DndOverlay from '@widgets/other/DndOverlay.astro';
import TheatreReviews from '@widgets/reading/TheatreReviews.astro';
import type { ScenarioData } from '../lib/scenario-data';

interface Props {
  data: ScenarioData;
}

const { data } = Astro.props;
const { profile, health, github, reading, books, system, starredRepos } = data.dashboard;
const { theatre, focus } = data;
---

<Dashboard>
  <FocusOverlay />
  <DndOverlay />
  <canvas id="particle-canvas" aria-hidden="true"></canvas>

  <div class="command-layout">
    <!-- LEFT PANEL: Identity -->
    <aside class="left-panel" aria-label="Profile">
      <IdentityCard profile={profile} compact={true} />
      <BioTerminal profile={profile} />
      <SystemStatus system={system} compact={true} />
    </aside>

    <!-- TOP BAR -->
    <header class="top-bar">
      <div class="top-bar-title">Human Datastream</div>
      <span id="pollStatus" class="poll-status">
        <span class="poll-dot poll-dot--off"></span>
        <span class="poll-label"></span>
      </span>
      <div class="top-bar-clock" id="liveClock" aria-live="off" aria-label="Current time"></div>
    </header>

    <!-- RIGHT PANEL: Triptych Grid -->
    <main id="main-content" class="right-panel">
      <div class="triptych-grid" id="triptychGrid">
        <!-- COLUMN 1: BODY -->
        <section class="triptych-column triptych-column-body" aria-label="Body">
          <h2 class="column-header column-header-pink">Body</h2>
          {
            /* Two bento columns: transparent (display:contents) except at the
              768–1100 tablet breakpoint, where they become independent masonry
              columns so a tall Workouts card no longer stretches Hydration.
              `order` (in tokens/layout.css) keeps the single-column sequence. */
          }
          <div class="body-bento">
            <div class="body-bento-col">
              <HeartRate health={health} />
              <Workouts health={health} />
            </div>
            <div class="body-bento-col">
              <Hydration health={health} />
              <NightSummary health={health} />
            </div>
          </div>
        </section>

        <!-- COLUMN 2: MIND -->
        <section class="triptych-column triptych-column-mind" aria-label="Mind">
          <h2 class="column-header column-header-green">Mind</h2>
          <DevActivityLog events={github.devActivity} />
          <ReadingFeed reading={reading} />
          <StarredRepoList repos={starredRepos} />
          <Bookshelf books={books} />
          <TheatreReviews />
        </section>
      </div>
    </main>
  </div>

  <BookModal />

  {
    /* Static reveal: the widgets SSR with `.is-loading` skeletons that a runtime
      would normally strip. This showcase has no runtime data fetch — the
      populated content is already SSR'd — so a tiny ES5 inline script removes
      `.is-loading` from every card on DOMContentLoaded to reveal the
      pre-rendered content deterministically. No data fetch occurs. */
  }
  <script is:inline>
    (function () {
      function revealCards() {
        var loading = document.querySelectorAll('.is-loading');
        for (var i = 0; i < loading.length; i++) {
          loading[i].classList.remove('is-loading');
        }
        // Workouts SSRs with inline `display:none` and is normally un-hidden by
        // its runtime updater (updaters.ts updateWorkouts) ONLY when workout data
        // arrives. On this static build the populated content is already SSR'd,
        // so mirror that exact behaviour: clear the inline hide iff the card has
        // at least one workout sub-card (stays hidden in the empty scenario, just
        // like production).
        var workouts = document.getElementById('cardWorkouts');
        if (workouts && workouts.querySelector('.workout-sub-card')) {
          workouts.style.display = '';
        }
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', revealCards);
      } else {
        revealCards();
      }
    })();
  </script>

  {
    /* TheatreReviews SSRs only a skeleton and is populated by its runtime
      updater from a raw fixture (no network fetch). FocusOverlay/DndOverlay are
      activated by updateFocusOverlay only for the focus/dnd scenarios. The
      fixtures are stashed on window by an inline define:vars script, then the
      bundled module (which statically imports the runtime) consumes them. */
  }
  <script define:vars={{ theatre, focus }} is:inline>
    window.__lgShowcaseFixtures = { theatre: theatre, focus: focus };
  </script>
  <script>
    import { updateTheatreReviews } from '@runtime/updaters-theatre';
    import { updateFocusOverlay } from '@runtime/updaters-focus';
    const fx = (window as any).__lgShowcaseFixtures;
    if (fx) {
      if (fx.theatre) updateTheatreReviews(fx.theatre);
      if (fx.focus) updateFocusOverlay(fx.focus);
    }
  </script>
</Dashboard>
