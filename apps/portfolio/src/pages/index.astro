---
// Default showcase entry (`/`) — renders the baseline (`populated`) scenario.
// All per-scenario variants are served from `/scenarios/<name>/` via the
// getStaticPaths route in `src/pages/scenarios/[scenario].astro`. Both share the
// `DashboardShowcase` component and the canonical `@lifegames/fixtures` data.
import DashboardShowcase from '../components/DashboardShowcase.astro';
import { getScenarioData } from '../lib/scenario-data';

const data = getScenarioData('populated');
---

<DashboardShowcase data={data} />
