---
// Per-scenario static showcase pages. ONE build emits every scenario at
// `/scenarios/<name>/` (e.g. /scenarios/empty/, /scenarios/hr-bradycardia/).
// Each renders the same DashboardShowcase markup with that scenario's data,
// composed from the canonical `@lifegames/fixtures` source in scenario-data.ts.
// The visual-regression harness navigates to these URLs; `/` remains the
// default baseline showcase.
import DashboardShowcase from '../../components/DashboardShowcase.astro';
import { getScenarioData, SCENARIOS } from '../../lib/scenario-data';

export function getStaticPaths() {
  return SCENARIOS.map((scenario) => ({ params: { scenario } }));
}

const { scenario } = Astro.params;
const data = getScenarioData(scenario as string);
---

<DashboardShowcase data={data} />
