---
import Variant from '../../layouts/Variant.astro';
---

<Variant title="Deep Focus — Work Mode">
  <style>
    *,
    *::before,
    *::after {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    html,
    body {
      height: 100%;
      overflow: hidden;
    }
    body {
      background: var(--bg);
      font-family: 'Space Grotesk', sans-serif;
      color: var(--text);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .overlay {
      display: flex;
      position: fixed;
      inset: 0;
      background: var(--bg);
      z-index: 9999;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 32px;
    }
    .scanline {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(245, 158, 11, 0.2), transparent);
      animation: scanline 6s linear infinite;
      z-index: 10000;
      pointer-events: none;
    }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      border-radius: 999px;
      border: 1px solid rgba(245, 158, 11, 0.25);
      background: rgba(245, 158, 11, 0.06);
      font-size: 0.65rem;
      font-weight: 600;
      letter-spacing: 0.15em;
      text-transform: uppercase;
      color: var(--neon-amber);
    }
    .badge .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: var(--neon-amber);
      animation: pulse-dot 2s ease-in-out infinite;
    }
    .ring-container {
      position: relative;
      width: 220px;
      height: 220px;
    }
    .ring-svg {
      width: 100%;
      height: 100%;
      transform: rotate(-90deg);
    }
    .ring-bg {
      fill: none;
      stroke: rgba(245, 158, 11, 0.1);
      stroke-width: 3;
    }
    .ring-progress {
      fill: none;
      stroke: var(--neon-amber);
      stroke-width: 3;
      stroke-linecap: round;
      transition: stroke-dashoffset 1s linear;
      filter: drop-shadow(0 0 8px rgba(245, 158, 11, 0.4));
    }
    .ring-center {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }
    .ring-time {
      font-size: 2.2rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      color: var(--neon-amber);
    }
    .ring-label {
      font-size: 0.55rem;
      font-weight: 500;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--text-muted);
    }
    .heading {
      font-size: 1.3rem;
      font-weight: 600;
      letter-spacing: 0.05em;
    }
    .subheading {
      font-size: 0.75rem;
      font-weight: 300;
      color: var(--text-muted);
      text-align: center;
      max-width: 360px;
      line-height: 1.5;
    }
    @keyframes scanline {
      0% {
        top: -1px;
      }
      100% {
        top: 100%;
      }
    }
    @keyframes pulse-dot {
      0%,
      100% {
        opacity: 1;
      }
      50% {
        opacity: 0.3;
      }
    }
    @media (prefers-reduced-motion: reduce) {
      .scanline {
        animation: none;
        display: none;
      }
      .badge .dot {
        animation: none;
        opacity: 1;
      }
      .ring-progress {
        transition: none;
      }
    }
  </style>
  <div class="overlay" id="overlay">
    <div class="scanline"></div>
    <div class="badge"><span class="dot"></span> Deep Focus Protocol</div>
    <div class="ring-container">
      <svg class="ring-svg" viewBox="0 0 220 220">
        <circle class="ring-bg" cx="110" cy="110" r="100"></circle>
        <circle
          class="ring-progress"
          id="ringProgress"
          cx="110"
          cy="110"
          r="100"
          stroke-dasharray="628.318"
          stroke-dashoffset="0"></circle>
      </svg>
      <div class="ring-center">
        <span class="ring-time" id="ringTime">--:--</span>
        <span class="ring-label">Until Restore</span>
      </div>
    </div>
    <div class="heading">Session in Progress</div>
    <div class="subheading">
      Deep work mode is active. The dashboard will automatically restore when the focus session ends
      at 3:00 PM PST.
    </div>
  </div>
  <script>
    (function () {
      var ringTime = document.getElementById('ringTime');
      var ringProgress = document.getElementById('ringProgress');
      var circumference = 2 * Math.PI * 100;
      function getPSTDate() {
        return new Date(
          new Date().toLocaleString('en-US', { timeZone: 'America/Los_Angeles', hour12: false }),
        );
      }
      function update() {
        var pst = getPSTDate();
        var hour = pst.getHours();
        var min = pst.getMinutes();
        var currentMinutes = hour * 60 + min;
        var startMinutes = 7 * 60;
        var endMinutes = 15 * 60;
        var totalWindow = endMinutes - startMinutes;
        var remaining = Math.max(0, endMinutes - currentMinutes);
        var elapsed = Math.max(0, currentMinutes - startMinutes);
        var progress = elapsed / totalWindow;
        ringProgress.setAttribute('stroke-dashoffset', circumference * (1 - progress));
        var rHours = Math.floor(remaining / 60);
        var rMins = remaining % 60;
        ringTime.textContent =
          (rHours < 10 ? '0' : '') + rHours + ':' + (rMins < 10 ? '0' : '') + rMins;
      }
      update();
      setInterval(update, 1000);
    })();
  </script>
</Variant>
