{
  "name": "design-system-lifegames",
  "private": true,
  "version": "0.0.0",
  "description": "Unified cross-platform design system for Lifegames — tokens, components, and widgets for web (Astro) and iOS (SwiftUI)",
  "packageManager": "pnpm@11.13.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:tokens": "turbo run build:tokens",
    "lint": "turbo run lint",
    "test": "turbo run test && pnpm test:scripts",
    "test:scripts": "node --test scripts/*.test.mjs packages/schemas/scripts/*.test.mjs",
    "docs:build": "turbo run docs:build",
    "docs:dev": "turbo run docs:dev",
    "storybook:build": "turbo run storybook:build",
    "storybook:test": "turbo run storybook:test",
    "check:schemas-freshness": "bash packages/schemas/scripts/check-freshness.sh",
    "check:package-drift": "node scripts/check-package-drift.mjs",
    "baseline:age": "node scripts/check-baseline-age.mjs",
    "widget:inventory": "node scripts/widget-inventory.mjs",
    "dtcg:validate": "node scripts/validate-dtcg.mjs",
    "check:compliance": "node scripts/widget-compliance.mjs",
    "check:widget-matrix": "node scripts/audit-widget-matrix.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "promotion:check": "node scripts/check-promotion.mjs --check",
    "swift:purity": "node scripts/check-swift-widget-purity.mjs --check",
    "watch:exclusions": "node scripts/check-watch-exclusions.mjs --check",
    "tokens:parity": "node scripts/check-token-parity.mjs --check",
    "build:m3": "node scripts/build-m3.mjs",
    "sync:claude-design": "node scripts/sync-claude-design.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish",
    "prepare": "husky",
    "typecheck": "turbo run typecheck",
    "format": "dprint fmt && prettier --write \"**/*.{astro,md,mdx,css}\"",
    "format:check": "dprint check && prettier --check \"**/*.{astro,md,mdx,css}\""
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@j0nathan-ll0yd/config": "workspace:*",
    "@playwright/test": "^1.60.0",
    "dprint": "0.55.2",
    "eslint-config-prettier": "^10.1.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.1",
    "prettier": "3.6.0",
    "prettier-plugin-astro": "0.14.1",
    "style-dictionary": "^5.4.4",
    "turbo": "^2.9.16",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "culori": "^4.0.2"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,mjs,cjs,json}": "dprint fmt --allow-no-files",
    "**/*.{astro,md,mdx,css}": "prettier --write"
  }
}
