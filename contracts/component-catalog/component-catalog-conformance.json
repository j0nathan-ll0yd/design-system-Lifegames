{
  "$comment": "Conformance vectors for the component-contract catalog GRAMMAR (contracts/component-catalog/schema.mjs). DS-owned and DS-local: this repo is the single producer, so there is no cross-repo vendoring here. Hand-authored on purpose — generating the vectors from the implementation they check would make them tautological. Every case is spelled out in full rather than patched onto a base entry, so a reader can see exactly what one vector asserts. `expectErrorContains` pins WHICH rule must fire, not merely that something failed. Editing this file requires regenerating component-catalog-conformance.sha256 in the same change.",
  "specVersion": 1,
  "cases": [
    {
      "name": "valid-minimal-gap-entry",
      "why": "The honest baseline: a presentation-only widget with no VoiceOver label and no consumer render test. Both gaps are written as null, not omitted, and not faked as a pass. `sources` is absent — it is provenance, not contract.",
      "expectValid": true,
      "entry": {
        "specVersion": 1,
        "widget": "bio-terminal",
        "group": "identity",
        "props": { "profile": { "type": "object", "optional": false } },
        "propsRef": "packages/web/src/widgets/identity/BioTerminal.types.ts",
        "swiftPropsRef": "Sources/LifegamesWidgets/Identity/BioTerminalProps.swift",
        "states": ["default", "empty"],
        "a11y": { "voiceOverLabel": null, "ref": null },
        "conformance": { "behavioralTest": null },
        "generatedBy": "contracts/component-catalog/generate.mjs"
      }
    },
    {
      "name": "valid-fully-populated-entry",
      "why": "The other end: a label exists and cites its line, a cross-repo behavioral test is referenced as a STRING, and `sources` records where each axis was read.",
      "expectValid": true,
      "entry": {
        "specVersion": 1,
        "widget": "heart-rate",
        "group": "health",
        "props": { "health": { "type": "object", "optional": false } },
        "propsRef": "packages/web/src/widgets/health/HeartRate.types.ts",
        "swiftPropsRef": "Sources/LifegamesWidgets/Health/HeartRateProps.swift",
        "states": ["default", "paused", "skeleton"],
        "a11y": { "voiceOverLabel": true, "ref": "Sources/LifegamesWidgets/Health/HeartRateView.swift:315" },
        "conformance": { "behavioralTest": "j0nathan-ll0yd.github.io/tests/behavioral/bookshelf-matrix.test.ts" },
        "generatedBy": "contracts/component-catalog/generate.mjs",
        "sources": {
          "props": "packages/schemas/generated/widgets/heart-rate.schema.json",
          "states": ["Sources/LifegamesWidgets/Resources/widgets/health/heart-rate[.<state>].json"],
          "a11y": "Sources/LifegamesWidgets/Health/HeartRateView.swift"
        }
      }
    },
    {
      "name": "valid-optional-prop-and-union-type",
      "why": "`optional: true` means the prop is absent from the source schema's `required[]`. A union type collapses to a single string; the grammar checks the string is non-empty, not its grammar.",
      "expectValid": true,
      "entry": {
        "specVersion": 1,
        "widget": "sync-status",
        "group": "other",
