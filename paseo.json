{
  "_notes": [
    "Paseo worktree lifecycle. Setup builds tokens so the package outputs exist for local work.",
    ".env is gitignored (see .env.example) — copied from the main checkout when present."
  ],
  "worktree": {
    "setup": [
      "MAIN=\"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\" && { cp \"$MAIN/.env\" .env 2>/dev/null || true; }",
      "pnpm install",
      "pnpm build:tokens"
    ]
  },
  "scripts": {
    "test": { "command": "pnpm test" },
    "build-tokens": { "command": "pnpm build:tokens" },
    "docs": {
      "type": "service",
      "command": "pnpm docs:dev -- --port $PASEO_PORT"
    }
  }
}
