{
  "extends": "./node_modules/@j0nathan-ll0yd/config/dprint.json",
  "includes": [
    "**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx,json}"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/.astro/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/.turbo/**",
    "packages/tokens/dist/**",
    "packages/tokens/__tests__/golden/**",
    "packages/schemas/generated/**",
    "packages/schemas/fixture-map.json",
    "packages/fixtures/fixture-map.json",
    "packages/fixtures/src/generated/**",
    "packages/fixtures/src/post-adapter/*.json",
    "packages/web/src/**/*.types.ts",
    "widget-consumers.json",
    "Tests/golden-mdx/**",
    "docs/maintenance/**",
    "pnpm-lock.yaml",
    "**/*.astro",
    "**/*.swift",
    "Sources/**",
    "packages/schemas/.contract-lock.json"
    // The eight `scripts/fixtures/**` entries that used to sit here are gone with the vendored
    // copies (atlas decision 0079 item 4 wave 2). The contract now resolves from
    // `@j0nathan-ll0yd/estate-contracts` under `node_modules/`, which no formatter walks, so the
    // bytes a sha256 pins can no longer be reformatted by accident. That is the whole exclusion
    // rationale retired by construction rather than restated.
  ]
}
