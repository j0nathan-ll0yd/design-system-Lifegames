{
  "extends": "./node_modules/@j0nathan-ll0yd/config/dprint.json",
  "includes": [
    "**/*.{ts,tsx,mts,cts,js,mjs,cjs,jsx,json}"
  ],
  "excludes": [
    "**/node_modules",
    "**/dist",
    "**/.astro/**",
    "**/coverage/**",
    "**/storybook-static/**",
    "**/.turbo/**",
    "packages/tokens/dist/**",
    "packages/tokens/__tests__/golden/**",
    "packages/schemas/generated/**",
    "packages/schemas/fixture-map.json",
    "packages/fixtures/fixture-map.json",
    "packages/fixtures/src/generated/**",
    "packages/fixtures/src/post-adapter/*.json",
    "packages/web/src/**/*.types.ts",
    "widget-consumers.json",
    "Tests/golden-mdx/**",
    "docs/maintenance/**",
    "pnpm-lock.yaml",
    "**/*.astro",
    "**/*.swift",
    "Sources/**",
    "packages/schemas/.contract-lock.json",
    // Vendored VERBATIM from atlas/contracts/. Their bytes are pinned by a sha256 the
    // engine carries in its source (DRIFT_CONFORMANCE_SHA256 /
    // EXPORT_SURFACE_CONFORMANCE_SHA256), so reformatting one would change its digest and
    // turn the conformance suite red for a reason that has nothing to do with the rule.
    // Re-vendor from the source of truth instead of editing — including whitespace.
    "scripts/fixtures/drift-conformance.json",
    "scripts/fixtures/drift-conformance-runner.mjs",
    "scripts/fixtures/export-surface-conformance.json",
    "scripts/fixtures/export-surface-runner.mjs"
  ]
}
