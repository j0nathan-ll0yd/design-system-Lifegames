{
  "name": "@j0nathan-ll0yd/config",
  "version": "1.2.0",
  "description": "Single source of truth for the Lifegames estate's TypeScript formatting (dprint), type-safety floor (tsconfig), and ESLint flat-config standard. Every TS repo — including the mantle framework — extends this package.",
  "type": "module",
  "license": "MIT",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    "./dprint.json": "./dprint.json",
    "./tsconfig-base.json": "./tsconfig-base.json",
    "./eslint": "./eslint.js"
  },
  "files": [
    "dprint.json",
    "tsconfig-base.json",
    "eslint.js",
    "README.md"
  ],
  "peerDependencies": {
    "eslint": ">=10.0.0"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "typescript-eslint": "^8.64.0"
  }
}
