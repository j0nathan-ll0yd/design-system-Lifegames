{
  "name": "@lifegames/tokens",
  "version": "0.1.0",
  "description": "Design tokens for the Lifegames design system — CSS custom properties, JS constants, and JSON",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "dist/tokens.js",
  "exports": {
    ".": {
      "import": "./dist/tokens.js",
      "require": "./dist/tokens.json",
      "types": "./dist/tokens.d.ts"
    },
    "./css": "./dist/tokens.css",
    "./css.layered": "./dist/tokens-layered.css",
    "./preamble": "./src/preamble.css",
    "./json": "./dist/tokens.json",
    "./design-md": "./dist/DESIGN.md",
    "./animations": "./src/animations.css",
    "./components": "./src/components.css",
    "./effects": "./src/effects.css",
    "./layout": "./src/layout.css",
    "./base": "./src/base.css",
    "./compat": "./src/compat.css",
    "./fonts": "./src/fonts.css",
    "./docs-chrome": "./src/docs-chrome.css"
  },
  "files": [
    "dist",
    "src/animations.css",
    "src/components.css",
    "src/effects.css",
    "src/layout.css",
    "src/base.css",
    "src/compat.css",
    "src/fonts.css",
    "src/docs-chrome.css",
    "src/preamble.css"
  ],
  "scripts": {
    "build": "node ../../style-dictionary.config.mjs",
    "build:tokens": "node ../../style-dictionary.config.mjs"
  },
  "devDependencies": {
    "style-dictionary": "^5.4.0",
    "@tokens-studio/sd-transforms": "^2.0.0"
  }
}
