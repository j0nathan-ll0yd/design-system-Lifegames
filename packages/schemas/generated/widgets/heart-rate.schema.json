{
  "type": "object",
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["live", "stale", "empty", "unavailable", "suppressed", "loading"]
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": ["string", "null"],
      "description": "ISO-8601 `generatedAt` of the export the card's state follows."
    },
    "health": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "quantities": {
              "type": "object",
              "properties": {
                "heartRate": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": ["value", "unit"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "hrvSDNN": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": ["value", "unit"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "restingHeartRate": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": ["value", "unit"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "respiratoryRate": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": ["value", "unit"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "wristTemperatureDelta": {
                  "anyOf": [
                    {
                      "type": "object",
                      "properties": {
                        "value": {
                          "type": "number"
                        },
                        "unit": {
                          "type": "string"
                        }
                      },
                      "required": ["value", "unit"]
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            "watch": {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "worn": {
                      "type": "boolean"
                    },
                    "since": {
                      "type": ["string", "null"]
                    },
                    "source": {
                      "type": "string",
                      "enum": ["charging", "hrGap"]
                    }
                  },
                  "required": ["source", "worn"]
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": ["quantities"]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifegames.org/schemas/widget/heart-rate.json",
  "title": "HeartRateProps"
}
