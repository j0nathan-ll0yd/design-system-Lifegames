{
  "type": "object",
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["live", "stale", "empty", "unavailable", "suppressed", "loading"]
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": ["string", "null"],
      "description": "ISO-8601 `generatedAt` of the export the card's state follows."
    },
    "reading": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "articles": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "source": {
                    "type": "string"
                  },
                  "date": {
                    "type": "string"
                  },
                  "datetime": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": ["title", "source", "date"]
              }
            }
          },
          "required": ["articles"]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifegames.org/schemas/widget/reading-feed.json",
  "title": "ReadingFeedProps"
}
