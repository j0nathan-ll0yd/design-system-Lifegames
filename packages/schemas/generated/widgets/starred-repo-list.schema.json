{
  "type": "object",
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["live", "stale", "empty", "unavailable", "suppressed", "loading"]
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": ["string", "null"],
      "description": "ISO-8601 `generatedAt` of the export the card's state follows."
    },
    "repos": {
      "anyOf": [
        {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "owner": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "stars": {
                "type": "number"
              },
              "language": {
                "type": "string"
              },
              "languageColor": {
                "type": "string"
              },
              "starredAt": {
                "type": "string"
              },
              "datetime": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": ["owner", "name", "stars", "language", "languageColor", "starredAt"]
          }
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifegames.org/schemas/widget/starred-repo-list.json",
  "title": "StarredRepoListProps"
}
