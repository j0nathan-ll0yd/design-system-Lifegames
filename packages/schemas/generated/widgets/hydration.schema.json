{
  "type": "object",
  "properties": {
    "state": {
      "anyOf": [
        {
          "type": "string",
          "enum": ["live", "stale", "empty", "unavailable", "suppressed", "loading"]
        },
        {
          "type": "null"
        }
      ]
    },
    "generatedAt": {
      "type": ["string", "null"],
      "description": "ISO-8601 `generatedAt` of the export (the OLDEST input for a multi-export card)."
    },
    "health": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "hydration": {
              "type": "object",
              "properties": {
                "waterOz": {
                  "type": ["number", "null"]
                },
                "caffeineMg": {
                  "type": ["number", "null"]
                },
                "waterMax": {
                  "type": "number"
                },
                "waterRangeLo": {
                  "type": "number"
                },
                "waterRangeHi": {
                  "type": "number"
                },
                "caffeineMax": {
                  "type": ["number", "null"]
                },
                "caffeineRangeLo": {
                  "type": ["number", "null"]
                },
                "caffeineRangeHi": {
                  "type": ["number", "null"]
                }
              },
              "required": [
                "waterOz",
                "caffeineMg",
                "waterMax",
                "waterRangeLo",
                "waterRangeHi",
                "caffeineMax",
                "caffeineRangeLo",
                "caffeineRangeHi"
              ]
            }
          },
          "required": ["hydration"]
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifegames.org/schemas/widget/hydration.json",
  "title": "HydrationProps"
}
