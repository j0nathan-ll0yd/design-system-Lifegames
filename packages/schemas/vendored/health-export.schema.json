{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "date": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string"
    },
    "lastSync": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "quantities": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "value": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          }
        },
        "required": [
          "value",
          "unit"
        ],
        "additionalProperties": false
      }
    },
    "goals": {
      "type": "object",
      "properties": {
        "moveKcal": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "exerciseMin": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "standHr": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "daylightMin": {
          "type": "number"
        }
      },
      "required": [
        "moveKcal",
        "exerciseMin",
        "standHr",
        "daylightMin"
      ],
      "additionalProperties": false
    },
    "solar": {
      "type": "object",
      "properties": {
        "sunriseHHmm": {
          "type": "string"
        },
        "sunsetHHmm": {
          "type": "string"
        },
        "currentProgressPct": {
          "type": "number"
        }
      },
      "required": [
        "sunriseHHmm",
        "sunsetHHmm",
        "currentProgressPct"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "date",
    "generatedAt",
    "quantities"
  ],
  "additionalProperties": false
}
