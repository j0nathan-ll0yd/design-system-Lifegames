{
  "name": "@j0nathan-ll0yd/schemas",
  "version": "1.0.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Cross-language widget data schemas (LP-vendored + DS-authored). Source of truth for fixture validation and codegen.",
  "type": "module",
  "exports": {
    ".": "./dist/types/index.ts",
    "./swift/*": "./swift/*"
  },
  "files": [
    "dist",
    "swift",
    "authored",
    "generated",
    "scripts/validate.ts",
    "scripts/portal-contract-source.mjs",
    "fixture-map.json"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "codegen": "tsx scripts/codegen.ts",
    "validate": "tsx scripts/validate.ts",
    "generate:widgets": "node scripts/generate-widget-schemas.mjs",
    "contract:generate": "tsx scripts/generate-contract-lock.ts",
    "contract:verify": "tsx scripts/verify-contract.ts",
    "build": "pnpm generate:widgets && pnpm codegen && LIFEGAMES_VALIDATE_CWD=$PWD/../.. pnpm validate && pnpm contract:generate",
    "lint": "eslint \"scripts/**/*.{ts,mjs}\""
  },
  "dependencies": {
    "@j0nathan-ll0yd/portal-contract": "^1.0.0",
    "ajv": "~8.20.0",
    "ajv-formats": "~3.0.1"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.61.0",
    "ajv-cli": "^5.0.0",
    "eslint": "^10.4.1",
    "json-schema-to-typescript": "^15.0.4",
    "quicktype": "^23.2.6",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.22.4"
  }
}
