{
  "name": "@lifegames/schemas",
  "version": "0.1.0",
  "description": "Cross-language widget data schemas (LP-vendored + DS-authored). Source of truth for fixture validation and codegen.",
  "type": "module",
  "exports": {
    ".": "./dist/types/index.ts",
    "./swift/*": "./swift/*"
  },
  "files": [
    "dist",
    "swift",
    "vendored",
    "authored",
    "fixture-map.json"
  ],
  "scripts": {
    "sync": "tsx scripts/sync-from-lp.ts",
    "codegen": "tsx scripts/codegen.ts",
    "validate": "tsx scripts/validate.ts",
    "build": "pnpm codegen && pnpm validate"
  },
  "devDependencies": {
    "ajv": "^8.20.0",
    "ajv-cli": "^5.0.0",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.0",
    "quicktype": "^23.0.0",
    "tsx": "^4.21.0"
  }
}
