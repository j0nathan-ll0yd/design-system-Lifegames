{
  "name": "@lifegames/schemas",
  "version": "0.1.0",
  "description": "Cross-language widget data schemas (LP-vendored + DS-authored). Source of truth for fixture validation and codegen.",
  "type": "module",
  "exports": {
    ".": "./dist/types/index.ts",
    "./swift/*": "./swift/*"
  },
  "files": [
    "dist",
    "swift",
    "vendored",
    "authored",
    "generated",
    "scripts/validate.ts",
    "fixture-map.json"
  ],
  "scripts": {
    "sync": "tsx scripts/sync-from-lp.ts",
    "codegen": "tsx scripts/codegen.ts",
    "validate": "tsx scripts/validate.ts",
    "generate:widgets": "node scripts/generate-widget-schemas.mjs",
    "contract:generate": "tsx scripts/generate-contract-lock.ts",
    "contract:verify": "tsx scripts/verify-contract.ts",
    "build": "pnpm sync && pnpm generate:widgets && pnpm codegen && LIFEGAMES_VALIDATE_CWD=$PWD/../.. pnpm validate && pnpm contract:generate"
  },
  "dependencies": {
    "ajv": "~8.20.0",
    "ajv-formats": "~3.0.1"
  },
  "devDependencies": {
    "ajv-cli": "^5.0.0",
    "json-schema-to-typescript": "^15.0.4",
    "quicktype": "^23.2.6",
    "ts-json-schema-generator": "^2.9.0",
    "tsx": "^4.22.4"
  }
}
