{
  "name": "@j0nathan-ll0yd/web",
  "version": "3.0.1",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Astro components and widgets for the Lifegames design system",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "**/*.astro"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./components/OGImage.astro": "./src/components/OGImage.astro",
    "./widgets/github": "./src/widgets/github/index.ts",
    "./widgets/health": "./src/widgets/health/index.ts",
    "./widgets/identity": "./src/widgets/identity/index.ts",
    "./widgets/location": "./src/widgets/location/index.ts",
    "./widgets/other": "./src/widgets/other/index.ts",
    "./widgets/reading": "./src/widgets/reading/index.ts",
    "./runtime/*": {
      "types": "./src/runtime/*.ts",
      "import": "./src/runtime/*.ts"
    },
    "./islands/*": "./src/islands/*",
    "./styles/*": "./src/styles/*",
    "./assets/*": "./src/assets/*",
    "./production": "./src/production/index.ts",
    "./production/*": "./src/production/*"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx,js,jsx,astro}\"",
    "audit:inline-scripts": "node scripts/audit-inline-scripts.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@j0nathan-ll0yd/portal-contract": "^1.0.0",
    "@j0nathan-ll0yd/copy": "workspace:*",
    "@j0nathan-ll0yd/tokens": "workspace:*"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.61.0",
    "@vitest/browser": "4.1.8",
    "@vitest/browser-playwright": "4.1.8",
    "@vitest/coverage-v8": "^4.1.8",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^10.4.1",
    "eslint-plugin-astro": "^1.7.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
