---
import { widgets } from '@j0nathan-ll0yd/copy';
import { composeProvenance } from '../../runtime/compose-provenance';

const { system, compact = false } = Astro.props;
// The Location row is retired (atlas decision 0012): never rendered, in any mode.
const lines = system.lines.filter((line: any) => line.key !== 'Location');
const keyClass = (line: any): string =>
  line.keyClass ?? `sys-key${keyColorMap[line.key] ? ' ' + keyColorMap[line.key] : ''}`;

const sourceMap: Record<string, string> = {
  Health: 'health',
  Sleep: 'sleep',
  Books: 'books',
  Articles: 'articles',
  'Github Events': 'githubEvents',
  'Github Stars': 'starredRepos',
  'Theatre Reviews': 'theatreReviews',
};

const keyColorMap: Record<string, string> = {
  Health: 'sys-key-red',
  Sleep: 'sys-key-purple',
  Books: 'sys-key-amber',
  Articles: 'sys-key-amber',
  'Github Events': 'sys-key-green',
  'Github Stars': 'sys-key-green',
  'Theatre Reviews': 'sys-key-yellow',
};

// Type guard: narrows a runtime string to a valid provenance source key.
function isSourceKey(s: string): s is keyof typeof widgets.systemStatus.sources {
  return s in widgets.systemStatus.sources;
}
---

{
  compact ? (
    <div class="left-panel-status" id="cardSystem">
      <div class="left-status-header">
        <h2 class="widget-label">{widgets.systemStatus.title}</h2>
        <div class="widget-header-right">
          <div class="live-dot" />
          <span class="widget-timestamp">{widgets.systemStatus.timestampRealtime}</span>
        </div>
      </div>
      <div id="systemStatus">
        {lines.map((line: any, idx: number) => {
          const source = line.source ?? sourceMap[line.key] ?? '';
          const provenance = isSourceKey(source) ? widgets.systemStatus.sources[source] : undefined;
          return (
            <div
              class="sys-line"
              data-source={source}
              data-ssr-state={line.suppressed ? 'suppressed' : undefined}
              style={`animation-delay: ${idx * 0.1}s`}
            >
              <div class={`sys-dot ${line.dotClass}`} style={`animation-delay: ${idx * 0.3}s`} />
              <span class={keyClass(line)}>{line.key}:</span>
              <span class={line.valClass || 'sys-val'} set:html={line.value} />
              {provenance !== undefined && (
                <>
                  <button
                    type="button"
                    class="sys-info"
                    popovertarget={`tip-${source}`}
                    popovertargetaction="toggle"
                    aria-label={`More information about the ${line.key} data source`}
                    aria-details={`tip-${source}`}
                  >
                    <svg
                      aria-hidden="true"
                      xmlns="http://www.w3.org/2000/svg"
                      width="14"
                      height="14"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <circle cx="12" cy="12" r="10" />
                      <line x1="12" y1="16" x2="12" y2="12" />
                      <line x1="12" y1="8" x2="12.01" y2="8" />
                    </svg>
                  </button>
                  <div
                    id={`tip-${source}`}
                    popover="auto"
                    role="group"
                    aria-label={`${line.key} data source`}
                    class="sys-tooltip"
                    set:html={composeProvenance(provenance.body, provenance.refs)}
                  />
                </>
              )}
            </div>
          );
        })}
      </div>
    </div>
  ) : (
    <div class="tri-card tri-card-accent-blue" id="cardSystem">
      <div class="widget-header">
        <h3 class="widget-label">{widgets.systemStatus.title}</h3>
        <div class="widget-header-right">
          <div class="live-dot live-dot-blue" />
          <span class="widget-timestamp">{widgets.systemStatus.timestampRealtime}</span>
        </div>
      </div>
      <div class="widget-body">
        <div class="left-panel-status">
          <div id="systemStatus">
            {lines.map((line: any, idx: number) => {
              const source = line.source ?? sourceMap[line.key] ?? '';
              const provenance = isSourceKey(source)
                ? widgets.systemStatus.sources[source]
                : undefined;
              return (
                <div
                  class="sys-line"
                  data-source={source}
                  data-ssr-state={line.suppressed ? 'suppressed' : undefined}
                  style={`animation-delay: ${idx * 0.1}s`}
                >
                  <div
                    class={`sys-dot ${line.dotClass}`}
                    style={`animation-delay: ${idx * 0.3}s`}
                  />
                  <span class={keyClass(line)}>{line.key}:</span>
                  <span class={line.valClass || 'sys-val'} set:html={line.value} />
                  {provenance !== undefined && (
                    <>
                      <button
                        type="button"
                        class="sys-info"
                        popovertarget={`tip-${source}`}
                        popovertargetaction="toggle"
                        aria-label={`More information about the ${line.key} data source`}
                        aria-details={`tip-${source}`}
                      >
                        <svg
                          aria-hidden="true"
                          xmlns="http://www.w3.org/2000/svg"
                          width="14"
                          height="14"
                          viewBox="0 0 24 24"
                          fill="none"
                          stroke="currentColor"
                          stroke-width="2"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        >
                          <circle cx="12" cy="12" r="10" />
                          <line x1="12" y1="16" x2="12" y2="12" />
                          <line x1="12" y1="8" x2="12.01" y2="8" />
                        </svg>
                      </button>
                      <div
                        id={`tip-${source}`}
                        popover="auto"
                        role="group"
                        aria-label={`${line.key} data source`}
                        class="sys-tooltip"
                        set:html={composeProvenance(provenance.body, provenance.refs)}
                      />
                    </>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  )
}
