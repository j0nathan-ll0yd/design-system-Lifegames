---
import { widgets } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { rendersData, resolveWidgetState, stateRootAttrs } from '../../runtime/widget-state';
import type { DevActivityLogProps } from './DevActivityLog.types';

interface Event {
  type: 'commit' | 'pr_opened' | 'pr_closed' | 'pr_merged' | 'issue_opened' | 'issue_closed';
  repo: string;
  title: string;
  date: string;
  datetime?: string;
  hash?: string;
  additions?: number;
  deletions?: number;
  number?: number;
  url?: string;
}

type Props = Omit<DevActivityLogProps, 'events'> & { events?: Event[] };

const { events: eventList, state: requestedState, generatedAt } = Astro.props;
const widgetState = resolveWidgetState(requestedState, (eventList?.length ?? 0) > 0);
const showData = rendersData(widgetState);
const events: Event[] = showData ? (eventList ?? []) : [];

const iconMap: Record<string, { symbol: string; color: string }> = {
  commit: { symbol: '\u2192', color: 'var(--lg-color-accent-green)' },
  pr_opened: { symbol: '\u2295', color: 'var(--lg-color-accent-blue)' },
  pr_closed: { symbol: '\u2296', color: 'var(--lg-color-accent-blue)' },
  pr_merged: { symbol: '\u229E', color: 'var(--lg-color-accent-blue)' },
  issue_opened: { symbol: '\u25C9', color: 'var(--lg-color-accent-amber)' },
  issue_closed: { symbol: '\u2714', color: 'var(--lg-color-accent-amber)' },
};

function getIcon(type: string) {
  return iconMap[type] || { symbol: '\u00B7', color: 'var(--lg-color-accent-green)' };
}

function getDetail(event: Event): string {
  if (event.type === 'commit' && event.hash) {
    return (
      '<span style="color:var(--lg-color-accent-green)">+' +
      (event.additions || 0) +
      '</span> <span style="color:var(--lg-color-accent-red)">-' +
      (event.deletions || 0) +
      '</span>'
    );
  }
  if (event.number !== undefined) {
    return '#' + event.number;
  }
  return '';
}
---

<div
  class={`tri-card tri-card-accent-green${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardDevLog"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.devLog.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot"></div>
      <WidgetTimestamp
        label={widgets.devLog.timestampLive}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <div class="skeleton-bar" style="width: 100%; height: 12px;"></div>
        <div class="skeleton-bar" style="width: 85%; height: 12px;"></div>
        <div class="skeleton-bar" style="width: 92%; height: 12px;"></div>
        <div class="skeleton-bar" style="width: 70%; height: 12px;"></div>
      </div>
    </div>
    <WidgetStateNotice state={widgetState} empty={{ message: widgets.devLog.empty }} />
    <div class="gh-dal-terminal" data-state-scaffold hidden={!showData}>
      {
        events.slice(0, 10).map((event: Event) => {
          const icon = getIcon(event.type);
          const detail = getDetail(event);
          return (
            <a
              class="gh-dal-line"
              href={event.url || undefined}
              target={event.url ? '_blank' : undefined}
              rel={event.url ? 'noopener noreferrer' : undefined}
              data-sa-link-event="activity_click"
            >
              <span class="gh-dal-icon" style={`color: ${icon.color};`}>
                {icon.symbol}
              </span>
              <span class="gh-dal-repo">{event.repo}</span>
              <span class="gh-dal-title">{event.title}</span>
              {detail && <span class="gh-dal-detail" set:html={detail} />}
              {event.datetime ? (
                <time class="gh-dal-date" datetime={event.datetime}>
                  {event.date}
                </time>
              ) : (
                <span class="gh-dal-date">{event.date}</span>
              )}
            </a>
          );
        })
      }
    </div>
  </div>
</div>
