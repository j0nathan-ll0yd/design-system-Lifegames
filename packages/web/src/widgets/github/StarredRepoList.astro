---
import { widgets } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { rendersData, resolveWidgetState, stateRootAttrs } from '../../runtime/widget-state';
import type { StarredRepoListProps } from './StarredRepoList.types';

interface Repo {
  owner: string;
  name: string;
  url: string;
  stars: number;
  language: string;
  languageColor: string;
  starredAt: string;
  datetime?: string;
}

type Props = Omit<StarredRepoListProps, 'repos'> & { repos?: Repo[] };

const { repos: repoList, state: requestedState, generatedAt } = Astro.props;
const widgetState = resolveWidgetState(requestedState, (repoList?.length ?? 0) > 0);
const showData = rendersData(widgetState);
const repos: Repo[] = showData ? (repoList ?? []) : [];
---

<div
  class={`tri-card tri-card-accent-green${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardStarredRepos"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.starredRepos.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot"></div>
      <WidgetTimestamp
        label={widgets.starredRepos.timestampRecent}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="display: flex; flex-direction: column; gap: 8px;">
        <div class="skeleton-bar" style="width: 100%; height: 14px;"></div>
        <div class="skeleton-bar" style="width: 90%; height: 14px;"></div>
        <div class="skeleton-bar" style="width: 95%; height: 14px;"></div>
      </div>
    </div>
    <WidgetStateNotice state={widgetState} empty={{ message: widgets.starredRepos.empty }} />
    <div class="gh-starred-list" data-state-scaffold hidden={!showData}>
      {
        repos.map((repo: Repo) => (
          <div class="gh-sl-row">
            <a
              class="gh-sl-name"
              href={repo.url}
              target="_blank"
              rel="noopener noreferrer"
              data-sa-link-event="repo_click"
            >
              <span class="gh-sl-owner">{repo.owner}/</span>
              {repo.name}
            </a>
            <span class="gh-sl-stars">★ {repo.stars.toLocaleString()}</span>
            <span class="gh-sl-lang">
              <span class="gh-sl-lang-dot" style={`background: ${repo.languageColor};`} />
              {repo.language}
            </span>
            {repo.datetime ? (
              <time class="gh-sl-date" datetime={repo.datetime}>
                {repo.starredAt}
              </time>
            ) : (
              <span class="gh-sl-date">{repo.starredAt}</span>
            )}
          </div>
        ))
      }
    </div>
  </div>
</div>

<style is:global>
  .gh-starred-list {
    background: rgba(0, 0, 0, 0.4);
    border: 1px solid rgba(6, 214, 160, 0.1);
    border-radius: 8px;
    padding: var(--space-8) var(--space-12);
    font-family: 'Space Grotesk', monospace;
    font-size: var(--lg-font-size-sm);
    display: flex;
    flex-direction: column;
  }

  .gh-sl-row {
    display: flex;
    align-items: center;
    gap: var(--space-10);
    padding: var(--space-4) 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.03);
  }

  .gh-sl-row:last-child {
    border-bottom: none;
  }

  .gh-sl-name {
    color: var(--lg-color-accent-green);
    text-decoration: none;
    font-weight: 400;
    line-height: 1.35;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .gh-sl-name:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .gh-sl-owner {
    color: rgba(6, 214, 160, 0.72);
  }

  .gh-sl-stars {
    color: var(--lg-color-accent-amber);
    font-size: var(--lg-font-size-xs);
    flex-shrink: 0;
    text-shadow: 0 0 6px rgba(245, 158, 11, 0.25);
  }

  .gh-sl-lang {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    color: var(--lg-color-text-muted);
    font-size: var(--lg-font-size-xs);
    flex-shrink: 0;
    /* W2-exempt: structural flex-item min-width, no token at this size */
    min-width: 80px;
  }

  .gh-sl-lang-dot {
    width: var(--space-6);
    height: var(--space-6);
    border-radius: 50%;
    flex-shrink: 0;
  }

  .gh-sl-date {
    color: var(--lg-color-text-muted);
    font-size: var(--lg-font-size-xs);
    flex-shrink: 0;
    /* W2-exempt: structural flex-item min-width, no token at this size */
    min-width: 72px;
    text-align: right;
  }

  @container (max-width: 350px) {
    .gh-sl-row {
      flex-wrap: wrap;
      gap: var(--space-4) var(--space-10);
    }
    .gh-sl-name {
      flex-basis: 100%;
    }
    .gh-sl-lang {
      min-width: auto;
    }
    .gh-sl-date {
      min-width: auto;
      margin-left: auto;
    }
  }

  @container (max-width: 250px) {
    .gh-sl-lang,
    .gh-sl-date {
      display: none;
    }
  }

  /* Detail-page tri-card (>500px) shows tighter rows. */
  @container (min-width: 500px) {
    .gh-starred-list,
    .gh-sl-name,
    .gh-sl-owner,
    .gh-sl-stars,
    .gh-sl-lang,
    .gh-sl-date {
      font-size: var(--lg-font-size-xs);
    }
    .gh-sl-row {
      padding: var(--space-2) 0;
    }
    .gh-sl-lang {
      /* W2-exempt: structural flex-item min-width, no token at this size */
      min-width: 60px;
    }
    .gh-sl-date {
      /* W2-exempt: structural flex-item min-width, no token at this size */
      min-width: 56px;
    }
  }
</style>
