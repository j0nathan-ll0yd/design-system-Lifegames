---
const { profile } = Astro.props;
---
<div class="tri-card tri-card-accent-indigo" id="identityCard">
  <div class="widget-header">
    <h3 class="widget-label">Identity</h3>
    <div class="widget-header-right">
      <div class="live-dot live-dot-indigo"></div>
      <span class="widget-timestamp">profile</span>
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div class="id-skeleton-layout">
        <div class="skeleton-circle" style="width: 64px; height: 64px;"></div>
        <div class="id-skeleton-bars">
          <div class="skeleton-bar" style="width: 120px; height: 18px;"></div>
          <div class="skeleton-bar" style="width: 180px; height: 14px;"></div>
          <div class="skeleton-bar" style="width: 100%; height: 12px;"></div>
        </div>
      </div>
    </div>
    <div class="identity-card">
      {profile.github || profile.linkedin ? (
        <picture>
          <source srcset="/assets/avatar.webp" type="image/webp">
          <img class="id-avatar" src="/assets/avatar.jpg" alt={profile.name + ' profile photo'} fetchpriority="high" width="200" height="200">
        </picture>
      ) : null}
      <div class="id-info-inline">
        <h1 class="id-name">{profile.name}</h1>
        {profile.title && <div class="id-title">{profile.title}</div>}
      </div>
      {profile.bio && <div class="id-bio"><em>{profile.bio}</em></div>}
      {profile.tagline && <div class="id-tagline">{profile.tagline}</div>}
      {(profile.github || profile.linkedin || profile.site || profile.mastodon || profile.bluesky) && (
        <nav class="id-links" aria-label="Social">
          {profile.github && <a href={profile.github} class="neon-pill" target="_blank" rel="noopener noreferrer">GitHub</a>}
          {profile.linkedin && <a href={profile.linkedin} class="neon-pill" target="_blank" rel="noopener noreferrer">LinkedIn</a>}
          {profile.site && <a href={profile.site} class="neon-pill" target="_blank" rel="noopener noreferrer">Site</a>}
          {profile.mastodon && <a href={profile.mastodon} class="neon-pill" target="_blank" rel="noopener noreferrer">Mastodon</a>}
          {profile.bluesky && <a href={profile.bluesky} class="neon-pill" target="_blank" rel="noopener noreferrer">Bluesky</a>}
        </nav>
      )}
    </div>
  </div>
</div>

<style>
  .id-skeleton-layout {
    display: flex;
    align-items: center;
    gap: var(--space-16);
  }
  .id-skeleton-bars {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    flex: 1;
  }
  @container (max-width: 360px) {
    .id-name {
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .id-bio {
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
</style>

<script is:inline>
(function() {
  var links = document.querySelectorAll('.id-links a');
  for (var i = 0; i < links.length; i++) {
    links[i].addEventListener('click', function(e) {
      var label = e.currentTarget.textContent.trim().toLowerCase();
      if (typeof window.sa_event === 'function') {
        window.sa_event('social_click', { platform: label });
      }
    });
  }
})();
</script>
