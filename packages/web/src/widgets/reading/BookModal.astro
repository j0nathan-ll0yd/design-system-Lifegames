---
import { a11y } from '@j0nathan-ll0yd/copy';
---

<dialog class="book-dialog" id="bookDialog" aria-label={a11y.bookModal.dialog}>
  <div class="book-modal" id="bookModal"></div>
</dialog>

<!-- BookModal ships scriptless. The consumer attaches the bundled runtime via
     `production/BookModal.astro` → `initBookModal()`. CSP `script-src 'self'`
     is satisfied because the runtime is a bundled (transpiled) module, not
     inline. The native <dialog> element manages open/close state, background
     inert, and Escape-to-close automatically via showModal()/close(). -->
