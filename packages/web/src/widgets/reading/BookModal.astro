---
import { a11y } from '@lifegames/copy';
---

<div
  class="book-overlay"
  id="bookOverlay"
  role="dialog"
  aria-modal="true"
  aria-label={a11y.bookModal.dialog}
  aria-hidden="true"
>
  <div class="book-modal" id="bookModal"></div>
</div>

<!-- BookModal ships scriptless. Consumer attaches activation via a delegated
     handler on document.body that parses the `.shelf-book[data-book]` JSON.
     See web-Lifegames-Portal/public/js/book-modal.js for the canonical
     implementation. CSP `script-src 'self'` rejects inline `<script>` bodies;
     the runtime must live in an external `public/js/*.js` file referenced via
     `<script is:inline src="..." defer>`. -->
