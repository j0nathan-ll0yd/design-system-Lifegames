---
import { widgets } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { THEATRE_SITE, theatreCardsHtml, theatreCountLabel } from '../../runtime/updaters-theatre';
import { rendersData, stateRootAttrs } from '../../runtime/widget-state';
import { theatreReviewsState } from '../../runtime/widget-rules';
import type { TheatreReviewsProps } from './TheatreReviews.types';

// Cards render from props on the server, through the same markup function the
// live update uses (atlas decision 0160, D5).
const { reviews: reviewList, totalReviews, generatedAt } = Astro.props as TheatreReviewsProps;
// One owner for the state: the same rule the view model applies.
const widgetState = theatreReviewsState(Astro.props as TheatreReviewsProps);
const showData = rendersData(widgetState);
const cardsHtml = showData ? theatreCardsHtml(reviewList ?? []) : '';
const showLabel = showData || widgetState === 'empty';
const countLabel =
  showData && typeof totalReviews === 'number' ? theatreCountLabel(totalReviews) : 'reviews';
---

<div
  class={`tri-card tri-card-accent-yellow${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardTheatreReviews"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.theatreReviews.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot"></div>
      {/* The count link holds the usual timestamp slot; stale adds its "as of" time beside it. */}
      {
        widgetState === 'stale' && (
          <WidgetTimestamp label="" state={widgetState} generatedAt={generatedAt} />
        )
      }
      {
        /* The count link is the header label: live, stale and empty show it; the
          states that show no label (unavailable, suppressed, loading) keep an
          empty slot that updateTheatreReviews turns back into the link. */
      }
      {
        showLabel ? (
          <a
            class="widget-timestamp theatre-count-link"
            id="theatreCount"
            href={THEATRE_SITE}
            target="_blank"
            rel="noopener noreferrer"
          >
            {countLabel}
          </a>
        ) : (
          <span class="widget-timestamp theatre-count-link" id="theatreCount" />
        )
      }
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="display: flex; gap: 14px; overflow: hidden;">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
          <div class="skeleton-bar" style="width: 95px; height: 143px; border-radius: 4px;"></div>
          <div class="skeleton-bar" style="width: 76px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 56px; height: 8px;"></div>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
          <div class="skeleton-bar" style="width: 95px; height: 143px; border-radius: 4px;"></div>
          <div class="skeleton-bar" style="width: 68px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 48px; height: 8px;"></div>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
          <div class="skeleton-bar" style="width: 95px; height: 143px; border-radius: 4px;"></div>
          <div class="skeleton-bar" style="width: 72px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 52px; height: 8px;"></div>
        </div>
      </div>
    </div>
    <WidgetStateNotice state={widgetState} empty={{ message: widgets.theatreReviews.empty }} />
    <div
      id="theatreRow"
      class="theatre-row"
      data-state-scaffold
      hidden={!showData}
      set:html={cardsHtml}
    />
  </div>
</div>

<style is:global>
  .tri-card-accent-yellow {
    border-top: 2px solid var(--lg-color-status-warning);
    box-shadow: 0 0 20px rgba(255, 214, 0, 0.08);
  }

  .theatre-row {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding: 0 0 4px;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 214, 0, 0.3) transparent;
    list-style: none;
    margin: 0;
  }
  .theatre-row::-webkit-scrollbar {
    height: 4px;
  }
  .theatre-row::-webkit-scrollbar-track {
    background: transparent;
  }
  .theatre-row::-webkit-scrollbar-thumb {
    background: rgba(255, 214, 0, 0.3);
    border-radius: 4px;
  }

  .theatre-count-link {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s ease;
  }
  .theatre-count-link:hover {
    color: var(--lg-color-status-warning);
  }

  .theatre-card {
    flex-shrink: 0;
    width: 105px;
    scroll-snap-align: start;
    text-decoration: none;
    color: inherit;
    text-align: center;
    padding: 6px 4px;
    border-radius: var(--radius-md);
    transition: transform 0.2s ease;
  }

  @media (hover: hover) {
    .theatre-card:hover {
      transform: translateY(-4px);
    }
    .theatre-card:hover .theatre-title {
      color: var(--lg-color-status-warning);
    }
  }

  .theatre-poster-wrap {
    position: relative;
    width: 95px;
    height: 143px;
    margin: 0 auto 8px;
    border-radius: 4px;
    overflow: hidden;
    background: linear-gradient(135deg, rgba(255, 214, 0, 0.12), rgba(58, 134, 255, 0.08));
  }

  .theatre-poster-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 4px;
  }

  .theatre-grade {
    position: absolute;
    bottom: 6px;
    left: 6px;
    font-size: 0.85rem;
    font-weight: 700;
    font-family: 'Space Grotesk', monospace;
    line-height: 1;
    padding: 4px 7px;
    border: 1.5px solid;
    border-radius: 4px;
    background: rgba(6, 6, 15, 0.85);
    backdrop-filter: blur(4px);
    letter-spacing: 0.5px;
  }

  .theatre-title {
    font-size: var(--font-size-base);
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    transition: color 0.2s ease;
  }
</style>

<script>
  // Server-rendered posters carry `data-fallback`; bind the W6 fallback at
  // load time. Fallback wiring only (no carousel handlers), bundled and
  // idempotent, mirroring Bookshelf.
  import { initImageFallbacks } from '../../runtime/image-utils';

  initImageFallbacks();
</script>
