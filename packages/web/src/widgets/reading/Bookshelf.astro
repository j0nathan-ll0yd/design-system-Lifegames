---
import { widgets, a11y } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import {
  mirroredCoverUrl,
  PLACEHOLDER_IMAGE_SRC,
  sanitizeImageUrl,
} from '../../runtime/image-utils';
import { formatMonthYear, rendersData, stateRootAttrs } from '../../runtime/widget-state';
import { bookshelfState } from '../../runtime/widget-rules';
import type { BookshelfProps } from './Bookshelf.types';

const { books, localCovers = [], generatedAt } = Astro.props as BookshelfProps;
// One owner for the state: the same rule the view model applies.
const widgetState = bookshelfState(Astro.props as BookshelfProps);
const showData = rendersData(widgetState);
const bookList = showData ? (books?.books ?? []) : [];
const bookMeta = books?.bookMeta ?? {};
const statusLabels = books?.statusLabels ?? {};

const statusOrder: Record<string, number> = { reading: 0, upNext: 1, finished: 2 };
// Owner's time zone, never the host's: the same ISO renders the same month on
// every server runtime.
function formatFinishedDate(iso: string): string {
  return formatMonthYear(iso);
}
const sortedBooks = bookList.slice().sort((a: any, b: any) => {
  return (statusOrder[a.status] ?? 99) - (statusOrder[b.status] ?? 99);
});
const displayBooks = sortedBooks.slice(0, 5);

const sanitizerOptions = { baseUrl: Astro.url, onReject: 'omit' as const };
const mirrored = new Set(localCovers);

// A contract cover renders same-origin only when the consumer's manifest of
// mirrored covers lists its exact path (mirroredCoverUrl, the rule
// updateBookshelf applies too). No filesystem probe (W6 fallback covers every
// other case).
function localImageUrl(candidate: string | null): string | null {
  return mirroredCoverUrl(candidate, mirrored, sanitizerOptions);
}
---

<div
  class={`tri-card tri-card-accent-amber${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardBooks"
  data-local-covers={localCovers.length > 0 ? JSON.stringify(localCovers) : undefined}
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.bookshelf.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot"></div>
      <WidgetTimestamp
        label={widgets.bookshelf.timestampLibrary}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="display: flex; gap: 16px;">
        <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
          <div class="skeleton-bar" style="width: 80px; height: 120px; border-radius: 4px;"></div>
          <div class="skeleton-bar" style="width: 64px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 48px; height: 8px;"></div>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
          <div class="skeleton-bar" style="width: 80px; height: 120px; border-radius: 4px;"></div>
          <div class="skeleton-bar" style="width: 56px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 44px; height: 8px;"></div>
        </div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 6px;">
          <div class="skeleton-bar" style="width: 80px; height: 120px; border-radius: 4px;"></div>
          <div class="skeleton-bar" style="width: 60px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 50px; height: 8px;"></div>
        </div>
      </div>
    </div>
    <WidgetStateNotice
      state={widgetState}
      empty={{ title: widgets.bookshelf.emptyTitle, body: widgets.bookshelf.emptyBody }}
    />
    <ul class="shelf-row" id="dashShelfRow" role="list" data-state-scaffold hidden={!showData}>
      {
        displayBooks.map((b: any, i: number) => {
          const asin = b.asin || b.isbn;
          // Prefer the committed same-origin copy; otherwise the export's own
          // first-party CloudFront URL; otherwise the placeholder. No branch
          // here may reach a third-party host (atlas decision 0086).
          const contractCard = sanitizeImageUrl(b.mainImageCard || b.mainImage, sanitizerOptions);
          const contractThumb = sanitizeImageUrl(b.mainImageThumb || b.mainImage, sanitizerOptions);
          const contractAvifCard = sanitizeImageUrl(
            b.mainImageCardAvif || b.mainImageAvif,
            sanitizerOptions,
          );
          const contractAvifThumb = sanitizeImageUrl(
            b.mainImageThumbAvif || b.mainImageAvif,
            sanitizerOptions,
          );
          const localCard = localImageUrl(contractCard);
          const localThumb = localImageUrl(contractThumb);
          const localAvifCard = localImageUrl(contractAvifCard);
          const localAvifThumb = localImageUrl(contractAvifThumb);
          const displayCard = localCard || contractCard;
          const displayThumb = localThumb || contractThumb;
          const imgSrc = displayCard || displayThumb || PLACEHOLDER_IMAGE_SRC;
          const imgSrcset =
            displayCard && displayThumb ? `${displayCard} 1x, ${displayThumb} 2x` : undefined;
          const displayAvifCard = localAvifCard || contractAvifCard;
          const displayAvifThumb = localAvifThumb || contractAvifThumb;
          const avifSrcset =
            [
              displayAvifCard ? `${displayAvifCard} 1x` : null,
              displayAvifThumb ? `${displayAvifThumb} 2x` : null,
            ]
              .filter(Boolean)
              .join(', ') || null;
          const fallbackAttr =
            imgSrc !== PLACEHOLDER_IMAGE_SRC || avifSrcset ? PLACEHOLDER_IMAGE_SRC : undefined;
          const meta = bookMeta[asin] || {};
          const bookData = JSON.stringify({
            title: b.title,
            author: b.author,
            asin: asin,
            status: b.status,
            statusLabel: statusLabels[b.status],
            rating: b.rating,
            progress: b.progress,
            link: `https://www.amazon.com/dp/${asin}?tag=lifegames04-20&linkCode=ll2&language=en_US&ref_=as_li_ss_tl`,
            notes: b.notes || null,
            finishedAt: b.finishedAt || null,
            startedAt: b.startedAt || null,
            series: meta.seriesName || null,
            seriesNumber: meta.seriesNumber || null,
            seriesTotal: meta.seriesTotal || null,
            pages: meta.pages || null,
            year: meta.year || null,
            publicationDate: meta.publicationDate || null,
            desc: meta.desc || null,
            genres: meta.genres || [],
            // Contract field names — BookModal reads `mainImage*` from here.
            mainImage: sanitizeImageUrl(b.mainImage, { baseUrl: Astro.url }),
            mainImageAvif: sanitizeImageUrl(b.mainImageAvif, sanitizerOptions),
          });
          return (
            <li
              class={`shelf-book${b.status === 'reading' ? ' shelf-book-active' : ''}`}
              style={`animation-delay: ${i * 0.08}s`}
              data-book={bookData}
              tabindex="0"
              aria-label={a11y.bookshelf.bookItem
                .replace('{title}', b.title)
                .replace('{author}', b.author)}
            >
              <div class="shelf-cover-wrapper">
                {avifSrcset ? (
                  <picture>
                    <source srcset={avifSrcset} type="image/avif" />
                    <img
                      src={imgSrc}
                      srcset={imgSrcset}
                      width="80"
                      height="120"
                      alt={b.title}
                      loading="lazy"
                      decoding="async"
                      data-fallback={fallbackAttr}
                    />
                  </picture>
                ) : (
                  <img
                    src={imgSrc}
                    srcset={imgSrcset}
                    width="80"
                    height="120"
                    alt={b.title}
                    loading="lazy"
                    decoding="async"
                    data-fallback={fallbackAttr}
                  />
                )}
              </div>
              <div class="shelf-book-title">
                <span>{b.title}</span>
              </div>
              <div class="shelf-book-author">{b.author}</div>
              {b.status === 'reading' ? (
                <Fragment>
                  <div class="shelf-book-status shelf-status-reading">
                    {widgets.bookshelf.statusReading}
                  </div>
                  {b.progress != null && (
                    <Fragment>
                      <div class="shelf-book-progress-bar">
                        <div class="shelf-book-progress-fill" style={`width: ${b.progress}%`} />
                      </div>
                      <div class="shelf-book-progress">{b.progress}%</div>
                    </Fragment>
                  )}
                </Fragment>
              ) : (
                <Fragment>
                  <div class={`shelf-book-status shelf-status-${b.status}`}>
                    {statusLabels[b.status]}
                  </div>
                  {b.rating && (
                    <div class="shelf-book-stars">
                      {[1, 2, 3, 4, 5].map((s: number) => (
                        <span class={s <= b.rating ? 'star-on' : 'star-off'}>
                          {s <= b.rating ? '\u2605' : '\u2606'}
                        </span>
                      ))}
                    </div>
                  )}
                  {b.status === 'finished' && b.finishedAt && (
                    <div class="shelf-book-finished-date">
                      {widgets.bookshelf.finishedDate.replace(
                        '{date}',
                        formatFinishedDate(b.finishedAt),
                      )}
                    </div>
                  )}
                </Fragment>
              )}
            </li>
          );
        })
      }
    </ul>
  </div>
</div>

<script>
  // The covers above are SERVER-RENDERED and already loading before any script
  // runs, so the `data-fallback` attribute they carry needs a handler bound at
  // load time. Until this existed the only thing that installed one was the
  // live-data swap (updateBookshelf / initBookshelf), which leaves the offline
  // shell — and any slow or failed books.json — showing blank covers with no
  // placeholder.
  //
  // Fallback wiring only: no click or keyboard binding, so this does not
  // double-bind the consumer's own page-level handlers. Bundled (not
  // `is:inline`), so it stays inside `script-src 'self'`, and idempotent, so the
  // island and production wrappers may each run their own init as well.
  import { initImageFallbacks } from '../../runtime/image-utils';

  initImageFallbacks();
</script>
