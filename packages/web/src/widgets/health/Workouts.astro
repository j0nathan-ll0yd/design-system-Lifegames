---
import { widgets } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { formatMeasurement, rendersData, stateRootAttrs } from '../../runtime/widget-state';
import { formatWorkoutDuration, workoutsState } from '../../runtime/widget-rules';
import type { Workout, WorkoutsProps } from './Workouts.types';

const props = Astro.props as WorkoutsProps;
const { health, generatedAt } = props;
// One owner for the state: the same rule the view model applies. No workouts
// is the recovery-day empty state, which the widget always had.
const widgetState = workoutsState(props);
const showData = rendersData(widgetState);
const workouts: Workout[] = showData ? (health?.workouts ?? []) : [];
// Shared with updateWorkouts, so server and client format the same.
const fmtDuration = formatWorkoutDuration;
---

{/* Visible by default (atlas decision 0160, D5): real workouts reach every client. */}
<div
  class={`tri-card tri-card-accent-pink${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardWorkouts"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.workouts.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot live-dot-pink"></div>
      <WidgetTimestamp
        label={widgets.workouts.timestampToday}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="display: flex; flex-direction: column; gap: 10px;">
        <div class="skeleton-bar" style="width: 60%; height: 18px;"></div>
        <div style="display: flex; gap: 8px;">
          <div class="skeleton-bar" style="flex: 1; height: 32px; border-radius: 6px;"></div>
          <div class="skeleton-bar" style="flex: 1; height: 32px; border-radius: 6px;"></div>
          <div class="skeleton-bar" style="flex: 1; height: 32px; border-radius: 6px;"></div>
        </div>
      </div>
    </div>
    <WidgetStateNotice state={widgetState} />
    {
      showData ? (
        workouts.map((w) => (
          <div class="workout-sub-card">
            <div class="workout-sub-top">
              {w.activity_type === 'Outdoor Walk' ? (
                <svg class="workout-sub-icon" viewBox="0 0 28 28" fill="none">
                  <circle cx="14" cy="5" r="3" fill="var(--neon-pink)" opacity="0.8" />
                  <path
                    d="M14 8 L14 17 M14 12 L9 15 M14 12 L19 15 M12 27 L14 17 L16 27"
                    stroke="var(--neon-pink)"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    opacity="0.8"
                  />
                </svg>
              ) : w.activity_type === "Barry's Bootcamp" ? (
                <svg class="workout-sub-icon" viewBox="0 0 28 28" fill="none">
                  <rect
                    x="3"
                    y="12"
                    width="22"
                    height="4"
                    rx="2"
                    stroke="var(--neon-pink)"
                    stroke-width="1.8"
                    opacity="0.8"
                  />
                  <rect
                    x="1"
                    y="10"
                    width="4"
                    height="8"
                    rx="1.5"
                    stroke="var(--neon-pink)"
                    stroke-width="1.5"
                    opacity="0.6"
                  />
                  <rect
                    x="23"
                    y="10"
                    width="4"
                    height="8"
                    rx="1.5"
                    stroke="var(--neon-pink)"
                    stroke-width="1.5"
                    opacity="0.6"
                  />
                  <circle
                    cx="8"
                    cy="14"
                    r="3"
                    stroke="var(--neon-pink)"
                    stroke-width="1.2"
                    opacity="0.5"
                  />
                  <circle
                    cx="20"
                    cy="14"
                    r="3"
                    stroke="var(--neon-pink)"
                    stroke-width="1.2"
                    opacity="0.5"
                  />
                </svg>
              ) : (
                <svg class="workout-sub-icon" viewBox="0 0 28 28" fill="none">
                  <circle
                    cx="14"
                    cy="14"
                    r="10"
                    stroke="var(--neon-pink)"
                    stroke-width="1.8"
                    opacity="0.6"
                  />
                  <path
                    d="M14 8 L14 14 L19 14"
                    stroke="var(--neon-pink)"
                    stroke-width="1.8"
                    stroke-linecap="round"
                    opacity="0.8"
                  />
                </svg>
              )}
              {w.link ? (
                <a class="workout-sub-type" href={w.link} target="_blank" rel="noopener noreferrer">
                  {w.activity_type}
                </a>
              ) : (
                <div class="workout-sub-type">{w.activity_type}</div>
              )}
            </div>
            <div class="workout-sub-stats">
              <div class="workout-stat">
                <div class="workout-stat-label">{widgets.workouts.duration}</div>
                <div class="workout-stat-value">{formatMeasurement(w.duration, fmtDuration)}</div>
              </div>
              <div class="workout-stat">
                <div class="workout-stat-label">{widgets.workouts.calories}</div>
                <div class="workout-stat-value">
                  {formatMeasurement(
                    w.energy_burned,
                    (n) => `${Math.round(n)} ${widgets.workouts.caloriesUnit}`,
                  )}
                </div>
              </div>
              {w.distance != null && w.distance > 0 && (
                <div class="workout-stat">
                  <div class="workout-stat-label">{widgets.workouts.distance}</div>
                  <div class="workout-stat-value">
                    {(w.distance / 1000).toFixed(2)} {widgets.workouts.distanceUnit}
                  </div>
                </div>
              )}
            </div>
          </div>
        ))
      ) : widgetState === 'empty' ? (
        <div class="workout-rest-center" data-state-notice="empty">
          <svg class="workout-rest-icon" viewBox="0 0 56 56" fill="none">
            <circle
              cx="28"
              cy="20"
              r="10"
              stroke="var(--neon-pink)"
              stroke-width="1.5"
              opacity="0.7"
            />
            <path
              d="M16 38 Q20 32 28 30 Q36 32 40 38"
              stroke="var(--neon-pink)"
              stroke-width="1.5"
              opacity="0.5"
              fill="none"
            />
            <path
              d="M12 44 Q18 38 28 36 Q38 38 44 44"
              stroke="var(--neon-blue)"
              stroke-width="1"
              opacity="0.3"
              fill="none"
            />
            <circle cx="28" cy="20" r="3" fill="var(--neon-pink)" opacity="0.6" />
            <path
              d="M24 18 Q28 14 32 18"
              stroke="rgba(255,255,255,0.3)"
              stroke-width="0.8"
              fill="none"
            />
          </svg>
          <div class="workout-rest-heading">{widgets.workouts.recoveryDay}</div>
          <div class="workout-rest-sub">{widgets.workouts.none}</div>
          <div class="workout-rest-insight">{widgets.workouts.recoveryBody}</div>
        </div>
      ) : null
    }
  </div>
</div>

<style>
  @container (max-width: 380px) {
    .workout-sub-stats {
      grid-template-columns: repeat(2, 1fr);
    }
    .workout-stat:nth-child(3) {
      grid-column: 1 / -1;
    }
  }
  @container (max-width: 320px) {
    .workout-sub-type {
      overflow-wrap: anywhere;
      line-height: 1.25;
    }
  }
</style>
