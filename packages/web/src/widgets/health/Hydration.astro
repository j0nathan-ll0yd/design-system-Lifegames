---
import { widgets } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { HYDRATION } from '../../runtime/constants';
import {
  formatMeasurement,
  isScaffoldHidden,
  rendersData,
  resolveWidgetState,
  stateRootAttrs,
} from '../../runtime/widget-state';
import type { HydrationProps } from './Hydration.types';

const { health, state: requestedState, generatedAt } = Astro.props as HydrationProps;
const widgetState = resolveWidgetState(requestedState, health?.hydration != null);
// Hydration has no separate empty layout: with no measurement it renders the
// vessels and the no-reading mark for each value.
const showData = rendersData(widgetState) || widgetState === 'empty';
const scaffoldHidden = isScaffoldHidden(widgetState);
const hydration = showData ? health?.hydration : undefined;

// Scale configuration (ranges and maxima) is not a measurement; it falls back
// to the design-system constants. Measurements never fall back to a number.
const waterMax = hydration?.waterMax ?? HYDRATION.waterMax;
const waterRangeLo = hydration?.waterRangeLo ?? HYDRATION.waterRangeLo;
const waterRangeHi = hydration?.waterRangeHi ?? HYDRATION.waterRangeHi;
const caffeineMax = hydration?.caffeineMax ?? HYDRATION.caffeineMax;
const caffeineRangeLo = hydration?.caffeineRangeLo ?? HYDRATION.caffeineRangeLo;
const caffeineRangeHi = hydration?.caffeineRangeHi ?? HYDRATION.caffeineRangeHi;
const waterOz = hydration?.waterOz ?? null;
const caffeineMg = hydration?.caffeineMg ?? null;

const fillPct = (value: number | null, max: number): number =>
  value != null && max > 0 ? Math.min(Math.max(value / max, 0), 1) * 100 : 0;
const waterPct = fillPct(waterOz, waterMax);
const caffeinePct = fillPct(caffeineMg, caffeineMax);
const clip = (pct: number): string => `clip-path: inset(${100 - pct}% 0 0 0)`;
const range = (lo: number, hi: number, max: number) => ({
  style: `bottom: ${(lo / max) * 100}%; height: ${((hi - lo) / max) * 100}%`,
  lo: String(lo),
  hi: String(hi),
});
const waterRange = range(waterRangeLo, waterRangeHi, waterMax);
const caffeineRange = range(caffeineRangeLo, caffeineRangeHi, caffeineMax);
const waterText = showData ? formatMeasurement(waterOz, (n) => `${n} oz`) : '';
const caffeineText = showData ? formatMeasurement(caffeineMg, (n) => `${n} mg`) : '';
---

<div
  class={`tri-card tri-card-accent-pink${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardHydration"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.hydration.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot live-dot-pink"></div>
      <WidgetTimestamp
        label={widgets.hydration.timestampToday}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div
        style="display: flex; justify-content: space-around; align-items: center; padding: 12px 0;"
      >
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
          <div class="skeleton-bar" style="width: 40px; height: 80px; border-radius: 8px;"></div>
          <div class="skeleton-bar" style="width: 40px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 30px; height: 8px;"></div>
        </div>
        <div style="width: 1px; height: 60px; background: rgba(255,255,255,0.06);"></div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
          <div class="skeleton-bar" style="width: 44px; height: 60px; border-radius: 8px;"></div>
          <div class="skeleton-bar" style="width: 40px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 30px; height: 8px;"></div>
        </div>
      </div>
    </div>
    <WidgetStateNotice state={widgetState} />
    <div class="hydra-layout" data-state-scaffold hidden={scaffoldHidden}>
      <div class="hydra-vessel hydra-vessel-water">
        <div class="hydra-bottle">
          <div class="hydra-bottle-cap"></div>
          <div class="hydra-bottle-body">
            {
              showData && (
                <div class="hydra-range hydra-range-water" style={waterRange.style}>
                  <div class="hydra-range-label hydra-range-label-top hydra-range-label-water">
                    {waterRange.hi}
                  </div>
                  <div class="hydra-range-label hydra-range-label-bottom hydra-range-label-water">
                    {waterRange.lo}
                  </div>
                </div>
              )
            }
            <div
              class="hydra-liquid hydra-liquid-water hydra-v3-liquid"
              id="hydraWaterLiq"
              style={clip(waterPct)}
            >
              <div class="hydra-v3-gloss"></div>
              <div class="hydra-v3-bubbles">
                <div class="hydra-v3-bubble" style="left:20%;animation-delay:0s;"></div>
                <div class="hydra-v3-bubble" style="left:45%;animation-delay:0.8s;"></div>
                <div class="hydra-v3-bubble" style="left:70%;animation-delay:1.6s;"></div>
                <div class="hydra-v3-bubble" style="left:35%;animation-delay:2.4s;"></div>
                <div class="hydra-v3-bubble" style="left:60%;animation-delay:0.4s;"></div>
                <div class="hydra-v3-bubble" style="left:15%;animation-delay:1.2s;"></div>
              </div>
              <svg class="hydra-wave" viewBox="0 0 120 16" preserveAspectRatio="none">
                <path
                  class="hydra-wave-path"
                  d="M0,8 Q15,0 30,8 Q45,16 60,8 Q75,0 90,8 Q105,16 120,8 L120,16 L0,16 Z"></path>
              </svg>
            </div>
          </div>
        </div>
        <div class="hydra-val" id="hydraWaterVal">{waterText}</div>
        <div class="hydra-label">{widgets.hydration.water}</div>
      </div>
      <div class="hydra-divider"></div>
      <div class="hydra-vessel hydra-vessel-coffee">
        <div class="hydra-mug">
          <div class="hydra-mug-steam">
            <div class="hydra-steam-line"></div>
            <div class="hydra-steam-line"></div>
            <div class="hydra-steam-line"></div>
          </div>
          <div class="hydra-mug-body">
            {
              showData && (
                <div class="hydra-range hydra-range-coffee" style={caffeineRange.style}>
                  <div class="hydra-range-label hydra-range-label-top hydra-range-label-coffee">
                    {caffeineRange.hi}
                  </div>
                  <div class="hydra-range-label hydra-range-label-bottom hydra-range-label-coffee">
                    {caffeineRange.lo}
                  </div>
                </div>
              )
            }
            <div
              class="hydra-liquid hydra-liquid-coffee hydra-v3-liquid"
              id="hydraCoffeeLiq"
              style={clip(caffeinePct)}
            >
              <div class="hydra-v3-gloss"></div>
              <div class="hydra-v3-bubbles">
                <div class="hydra-v3-bubble" style="left:25%;animation-delay:0.3s;"></div>
                <div class="hydra-v3-bubble" style="left:50%;animation-delay:1.1s;"></div>
                <div class="hydra-v3-bubble" style="left:72%;animation-delay:1.9s;"></div>
                <div class="hydra-v3-bubble" style="left:38%;animation-delay:0.7s;"></div>
                <div class="hydra-v3-bubble" style="left:58%;animation-delay:2.2s;"></div>
                <div class="hydra-v3-bubble" style="left:12%;animation-delay:1.5s;"></div>
              </div>
              <svg class="hydra-wave" viewBox="0 0 120 16" preserveAspectRatio="none">
                <path
                  class="hydra-wave-path"
                  d="M0,8 Q15,0 30,8 Q45,16 60,8 Q75,0 90,8 Q105,16 120,8 L120,16 L0,16 Z"></path>
              </svg>
            </div>
          </div>
          <div class="hydra-mug-handle"></div>
        </div>
        <div class="hydra-val" id="hydraCoffeeVal">{caffeineText}</div>
        <div class="hydra-label" id="hydraCoffeeLabel">{widgets.hydration.caffeine}</div>
      </div>
    </div>
  </div>
</div>
