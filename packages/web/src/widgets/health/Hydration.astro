---
import { widgets } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { hydrationRangeHtml } from '../../runtime/widget-markup';
import { stateRootAttrs } from '../../runtime/widget-state';
import { hydrationView } from '../../runtime/widget-views';
import type { HydrationProps } from './Hydration.types';

const props = Astro.props as HydrationProps;
const { generatedAt } = props;
// One owner for the state, the values and the target-range bands: the view
// updateHydration writes too. Hydration has no separate empty layout: its
// empty state shows the vessels with the no-reading mark and no input value,
// like the Swift HydrationView empty case.
const view = hydrationView(props);
const widgetState = view.state;
const clip = (pct: number): string => `clip-path: inset(${100 - pct}% 0 0 0)`;
---

<div
  class={`tri-card tri-card-accent-pink${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardHydration"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.hydration.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot live-dot-pink"></div>
      <WidgetTimestamp
        label={widgets.hydration.timestampToday}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div
        style="display: flex; justify-content: space-around; align-items: center; padding: 12px 0;"
      >
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
          <div class="skeleton-bar" style="width: 40px; height: 80px; border-radius: 8px;"></div>
          <div class="skeleton-bar" style="width: 40px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 30px; height: 8px;"></div>
        </div>
        <div style="width: 1px; height: 60px; background: rgba(255,255,255,0.06);"></div>
        <div style="display: flex; flex-direction: column; align-items: center; gap: 8px;">
          <div class="skeleton-bar" style="width: 44px; height: 60px; border-radius: 8px;"></div>
          <div class="skeleton-bar" style="width: 40px; height: 10px;"></div>
          <div class="skeleton-bar" style="width: 30px; height: 8px;"></div>
        </div>
      </div>
    </div>
    <WidgetStateNotice state={widgetState} />
    <div class="hydra-layout" data-state-scaffold hidden={view.scaffoldHidden}>
      <div class="hydra-vessel hydra-vessel-water">
        <div class="hydra-bottle">
          <div class="hydra-bottle-cap"></div>
          <div class="hydra-bottle-body">
            {view.waterBand && <Fragment set:html={hydrationRangeHtml('water', view.waterBand)} />}
            <div
              class="hydra-liquid hydra-liquid-water hydra-v3-liquid"
              id="hydraWaterLiq"
              style={clip(view.waterPct)}
            >
              <div class="hydra-v3-gloss"></div>
              <div class="hydra-v3-bubbles">
                <div class="hydra-v3-bubble" style="left:20%;animation-delay:0s;"></div>
                <div class="hydra-v3-bubble" style="left:45%;animation-delay:0.8s;"></div>
                <div class="hydra-v3-bubble" style="left:70%;animation-delay:1.6s;"></div>
                <div class="hydra-v3-bubble" style="left:35%;animation-delay:2.4s;"></div>
                <div class="hydra-v3-bubble" style="left:60%;animation-delay:0.4s;"></div>
                <div class="hydra-v3-bubble" style="left:15%;animation-delay:1.2s;"></div>
              </div>
              <svg class="hydra-wave" viewBox="0 0 120 16" preserveAspectRatio="none">
                <path
                  class="hydra-wave-path"
                  d="M0,8 Q15,0 30,8 Q45,16 60,8 Q75,0 90,8 Q105,16 120,8 L120,16 L0,16 Z"></path>
              </svg>
            </div>
          </div>
        </div>
        <div class="hydra-val" id="hydraWaterVal">{view.waterText}</div>
        <div class="hydra-label">{widgets.hydration.water}</div>
      </div>
      <div class="hydra-divider"></div>
      <div class="hydra-vessel hydra-vessel-coffee">
        <div class="hydra-mug">
          <div class="hydra-mug-steam">
            <div class="hydra-steam-line"></div>
            <div class="hydra-steam-line"></div>
            <div class="hydra-steam-line"></div>
          </div>
          <div class="hydra-mug-body">
            {
              view.caffeineBand && (
                <Fragment set:html={hydrationRangeHtml('coffee', view.caffeineBand)} />
              )
            }
            <div
              class="hydra-liquid hydra-liquid-coffee hydra-v3-liquid"
              id="hydraCoffeeLiq"
              style={clip(view.caffeinePct)}
            >
              <div class="hydra-v3-gloss"></div>
              <div class="hydra-v3-bubbles">
                <div class="hydra-v3-bubble" style="left:25%;animation-delay:0.3s;"></div>
                <div class="hydra-v3-bubble" style="left:50%;animation-delay:1.1s;"></div>
                <div class="hydra-v3-bubble" style="left:72%;animation-delay:1.9s;"></div>
                <div class="hydra-v3-bubble" style="left:38%;animation-delay:0.7s;"></div>
                <div class="hydra-v3-bubble" style="left:58%;animation-delay:2.2s;"></div>
                <div class="hydra-v3-bubble" style="left:12%;animation-delay:1.5s;"></div>
              </div>
              <svg class="hydra-wave" viewBox="0 0 120 16" preserveAspectRatio="none">
                <path
                  class="hydra-wave-path"
                  d="M0,8 Q15,0 30,8 Q45,16 60,8 Q75,0 90,8 Q105,16 120,8 L120,16 L0,16 Z"></path>
              </svg>
            </div>
          </div>
          <div class="hydra-mug-handle"></div>
        </div>
        <div class="hydra-val" id="hydraCoffeeVal">{view.caffeineText}</div>
        <div class="hydra-label" id="hydraCoffeeLabel">{widgets.hydration.caffeine}</div>
      </div>
    </div>
  </div>
</div>
