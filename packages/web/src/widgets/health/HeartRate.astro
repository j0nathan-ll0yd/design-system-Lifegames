---
import { widgets } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { heartRateEmptyHtml } from '../../runtime/widget-markup';
import { stateRootAttrs } from '../../runtime/widget-state';
import { heartRateView } from '../../runtime/widget-views';
import type { HeartRateProps } from './HeartRate.types';

const props = Astro.props as HeartRateProps;
const { generatedAt } = props;
// One owner for the state and every slot: the view updateHeartRate writes too.
const view = heartRateView(props);
const widgetState = view.state;
// SSR paused: the export reports the watch off the wrist or charging. The
// card keeps its data state (a reading of the watch state) but shows no value:
// the scaffold renders value-free, and only the paused copy names anything.
const ssrPaused = view.paused;
const showData = view.showData;
// The value-free scaffold the runtime updaters target. It renders in every
// state, hidden behind the notice in empty, unavailable and suppressed, so a
// later live update can reveal it (revealLiveData) without a reload.
const scaffoldHidden = view.scaffoldHidden;
const { hr, hrv, hasHrv } = view;
const state = view.zone;
// A zone colour belongs to a reading: a missing (or 0) heart rate and a
// missing HRV render the no-reading mark in the default colour, never a zone's.
const { color: hrvColor, shadow: hrvShadow } = view.hrvColor;
const fmtBpm = view.bpmText;
const fmtZone = view.zoneText;
const fmtHrv = view.hrvText;
const fmtRhr = view.rhrText;
const fmtRr = view.rrText;
const fmtTemp = view.tempText;
---

<div
  class={`tri-card ${state.accentClass}${ssrPaused ? ' is-paused' : ''}${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardHR"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.heartRate.title}</h3>
    <div class="widget-header-right">
      <div class={`live-dot ${state.dotClass}`}></div>
      <WidgetTimestamp
        label={widgets.heartRate.timestampLive}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="position: relative; min-height: 100px;">
        <div
          class="skeleton-bar"
          style="width: 100%; height: 60px; border-radius: 8px; margin-bottom: 12px;"
        >
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div class="skeleton-bar" style="width: 80px; height: 28px;"></div>
          <div class="skeleton-bar" style="width: 50px; height: 18px; border-radius: 50px;"></div>
        </div>
        <div style="display: flex; justify-content: flex-end; margin-top: 8px;">
          <div class="skeleton-bar" style="width: 60px; height: 10px;"></div>
        </div>
        <div
          style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 14px; padding-top: 6px; border-top: 1px solid rgba(255,255,255,0.06);"
        >
          <div class="skeleton-bar" style="width: 48px; height: 8px; border-radius: 3px;"></div>
          <div class="skeleton-bar" style="width: 48px; height: 8px; border-radius: 3px;"></div>
          <div class="skeleton-bar" style="width: 40px; height: 8px; border-radius: 3px;"></div>
        </div>
      </div>
    </div>
    {widgetState === 'empty' && <Fragment set:html={heartRateEmptyHtml()} />}
    <WidgetStateNotice state={widgetState} />
    {/* Both states stay mounted so live updates can switch without exposing stale values. */}
    {
      /* The paused block names no value, so it renders in every state; CSS shows it only with .is-paused. */
    }
    <div class="hr-paused" role="status" aria-live="polite" id="hrPaused">
      <svg
        class="hr-paused-icon"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M9 6.5A3 3 0 0 1 12 4a3 3 0 0 1 3 2.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
        <rect x="3" y="9" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"
        ></rect>
        <line
          x1="2"
          y1="2"
          x2="22"
          y2="22"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></line>
      </svg>
      <span class="hr-paused-label" id="hrPausedLabel">{view.pausedLabel}</span>
      <span class="hr-paused-desc" id="hrPausedDesc">{view.pausedDescription}</span>
    </div>
    {
      (
        <div class="hr-data" data-state-scaffold hidden={scaffoldHidden}>
          <div class="hr-layout">
            <div class="hr-ecg-bg" id="hrEcgBg" style={`opacity: ${state.ecgOpacity}`}>
              <canvas
                class="ecg-canvas"
                id="hrEcgCanvas"
                data-bpm={showData && hr > 0 ? String(hr) : undefined}
                data-hrv={showData && hasHrv ? String(hrv) : undefined}
                data-stroke={showData ? state.ecgStroke : undefined}
                width="400"
                height="120"
              />
            </div>
            <div class="hr-overlay">
              <div class="hr-overlay-left">
                <div>
                  <>
                    <span
                      class="pulse-bpm"
                      id="pulseBpm"
                      style={
                        hr > 0
                          ? `color: ${state.bpmColor}; text-shadow: ${state.bpmShadow}`
                          : undefined
                      }
                    >
                      {fmtBpm}
                    </span>
                    <span class="pulse-bpm-unit">{widgets.heartRate.bpm}</span>
                  </>
                </div>
                <span
                  class="pulse-status-badge"
                  id="hrZoneBadge"
                  style={
                    hr > 0
                      ? `color: ${state.badgeColor}; background: ${state.badgeBg}; border: 1px solid ${state.badgeBorder}`
                      : undefined
                  }
                >
                  {fmtZone}
                </span>
              </div>
              <div class="hr-overlay-right">
                <span class="hr-hrv-label">{widgets.heartRate.hrv}</span>
                <span
                  class="hr-hrv-value"
                  id="hrHrvValue"
                  style={hasHrv ? `color: ${hrvColor}; text-shadow: ${hrvShadow}` : undefined}
                >
                  {fmtHrv}
                </span>
                <span class="hr-hrv-unit">{widgets.heartRate.hrvUnit}</span>
              </div>
            </div>
          </div>
          <div class="hr-footer">
            <div class="hr-footer-cell">
              <span class="hr-footer-label">{widgets.heartRate.rhr}</span>
              <>
                <span class="hr-footer-value" id="hrFooterRhr">
                  {fmtRhr}
                </span>
                <span class="hr-footer-unit">{widgets.heartRate.rhrUnit}</span>
              </>
            </div>
            <div class="hr-footer-cell">
              <span class="hr-footer-label">{widgets.heartRate.rr}</span>
              <>
                <span class="hr-footer-value" id="hrFooterRr">
                  {fmtRr}
                </span>
                <span class="hr-footer-unit">{widgets.heartRate.rrUnit}</span>
              </>
            </div>
            <div class="hr-footer-cell">
              <span class="hr-footer-label">{widgets.heartRate.temp}</span>
              <span class="hr-footer-value" id="hrFooterTemp">
                {fmtTemp}
              </span>
            </div>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Global: updateHeartRate writes the empty notice (heartRateEmptyHtml). */
  :global(.hr-empty) {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--space-48);
  }
  :global(.hr-empty-label) {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Paused state — watch off wrist or charging.
     The paused block is always in the DOM (hidden by default).
     When .is-paused is on #cardHR: show the paused block, hide the data. */
  .hr-paused {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--lg-space-200);
    padding: var(--lg-space-600) var(--lg-space-300);
    text-align: center;
  }
  /* Data wrapper: hidden when paused so stale numbers are never shown. */
  #cardHR.is-paused .hr-data {
    display: none;
  }
  #cardHR.is-paused .hr-paused {
    display: flex;
  }
  .hr-paused-icon {
    width: var(--lg-space-600);
    height: var(--lg-space-600);
    color: var(--lg-color-text-disabled);
    opacity: 0.65;
    flex-shrink: 0;
  }
  .hr-paused-label {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption);
    font-weight: var(--lg-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lg-color-text-muted);
  }
  .hr-paused-desc {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption2);
    color: var(--lg-color-text-disabled);
    line-height: 1.4;
    max-width: 22ch;
  }

  /* Tighten card bottom padding so the strip sits flush */
  #cardHR .widget-body {
    padding-bottom: 12px;
  }

  /* Quiet vitals swatch strip (RHR / RR / Temp). ~14-16px tall. */
  .hr-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: var(--lg-space-200);
    padding: 4px 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .hr-footer-cell {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }
  .hr-footer-label {
    font-family: var(--lg-font-family-system);
    font-size: 0.5rem;
    font-weight: var(--lg-font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lg-color-text-muted);
    line-height: 1;
  }
  .hr-footer-value {
    font-family: var(--lg-font-family-system);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--lg-color-text-title);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .hr-footer-unit {
    font-family: var(--lg-font-family-system);
    font-size: 0.5rem;
    color: var(--lg-color-text-muted);
    letter-spacing: 0.06em;
    font-weight: var(--lg-font-weight-regular);
    opacity: 0.7;
  }
</style>
