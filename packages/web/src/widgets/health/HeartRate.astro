---
import { widgets } from '@lifegames/copy';
import { classifyHeartRate, classifyHRV } from '../../runtime/heart-rate';

const { health } = Astro.props;
const hr = Math.round(health.quantities.heartRate.value);
const hrv = Math.round(health.quantities.hrvSDNN.value);
const watch = health.watch;

const isEmpty = hr === 0 && hrv === 0;
const state = classifyHeartRate(hr);
const { color: hrvColor, shadow: hrvShadow } = classifyHRV(hrv);

// 3-up footer vitals — RHR / RR / Temp.
// Render '—' for any field that is absent or zero (empty signal).
const rhr = health.quantities.restingHeartRate;
const rr = health.quantities.respiratoryRate;
const tempDelta = health.quantities.wristTemperatureDelta;

const fmtRhr = rhr && rhr.value > 0 ? String(Math.round(rhr.value)) : '—';
const fmtRr = rr && rr.value > 0 ? String(Math.round(rr.value)) : '—';
// Temp delta: show signed value to 1 decimal place (e.g. +0.2, -0.1)
const fmtTemp = (() => {
  if (!tempDelta) return '—';
  const v = tempDelta.value;
  if (!Number.isFinite(v)) return '—';
  const sign = v > 0 ? '+' : '';
  return sign + v.toFixed(1);
})();
---

<div class={`tri-card ${state.accentClass}`} id="cardHR">
  <div class="widget-header">
    <h3 class="widget-label">{widgets.heartRate.title}</h3>
    <div class="widget-header-right">
      <div class={`live-dot ${state.dotClass}`}></div>
      <span class="widget-timestamp">{widgets.heartRate.timestampLive}</span>
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="position: relative; min-height: 100px;">
        <div
          class="skeleton-bar"
          style="width: 100%; height: 60px; border-radius: 8px; margin-bottom: 12px;"
        >
        </div>
        <div style="display: flex; justify-content: space-between; align-items: center;">
          <div class="skeleton-bar" style="width: 80px; height: 28px;"></div>
          <div class="skeleton-bar" style="width: 50px; height: 18px; border-radius: 50px;"></div>
        </div>
        <div style="display: flex; justify-content: flex-end; margin-top: 8px;">
          <div class="skeleton-bar" style="width: 60px; height: 10px;"></div>
        </div>
        <div
          style="display: flex; align-items: baseline; justify-content: space-between; gap: 8px; margin-top: 14px; padding-top: 6px; border-top: 1px solid rgba(255,255,255,0.06);"
        >
          <div class="skeleton-bar" style="width: 48px; height: 8px; border-radius: 3px;"></div>
          <div class="skeleton-bar" style="width: 48px; height: 8px; border-radius: 3px;"></div>
          <div class="skeleton-bar" style="width: 40px; height: 8px; border-radius: 3px;"></div>
        </div>
      </div>
    </div>
    {
      isEmpty ? (
        <div class="hr-empty">
          <span class="hr-empty-label">{widgets.heartRate.empty}</span>
        </div>
      ) : watch?.worn === false ? (
        <div class="hr-paused" role="status" aria-live="polite" id="hrPaused">
          <svg
            class="hr-paused-icon"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M9 6.5A3 3 0 0 1 12 4a3 3 0 0 1 3 2.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
            <rect
              x="3"
              y="9"
              width="18"
              height="13"
              rx="2"
              stroke="currentColor"
              stroke-width="1.5"
            />
            <line
              x1="2"
              y1="2"
              x2="22"
              y2="22"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
            />
          </svg>
          <span class="hr-paused-label" id="hrPausedLabel">
            {watch.source === 'charging'
              ? widgets.heartRate.paused.labelCharging
              : widgets.heartRate.paused.label}
          </span>
          <span class="hr-paused-desc" id="hrPausedDesc">
            {watch.source === 'charging'
              ? widgets.heartRate.paused.descriptionCharging
              : widgets.heartRate.paused.description}
          </span>
        </div>
      ) : (
        <>
          <div class="hr-layout">
            <div class="hr-ecg-bg" id="hrEcgBg" style={`opacity: ${state.ecgOpacity}`}>
              <canvas
                class="ecg-canvas"
                id="hrEcgCanvas"
                data-bpm={String(hr)}
                data-hrv={String(hrv)}
                data-stroke={state.ecgStroke}
                width="400"
                height="120"
              />
            </div>
            <div class="hr-overlay">
              <div class="hr-overlay-left">
                <div>
                  <>
                    <span
                      class="pulse-bpm"
                      id="pulseBpm"
                      style={`color: ${state.bpmColor}; text-shadow: ${state.bpmShadow}`}
                    >
                      {hr}
                    </span>
                    <span class="pulse-bpm-unit">{widgets.heartRate.bpm}</span>
                  </>
                </div>
                <span
                  class="pulse-status-badge"
                  id="hrZoneBadge"
                  style={`color: ${state.badgeColor}; background: ${state.badgeBg}; border: 1px solid ${state.badgeBorder}`}
                >
                  {state.zone}
                </span>
              </div>
              <div class="hr-overlay-right">
                <span class="hr-hrv-label">{widgets.heartRate.hrv}</span>
                <span
                  class="hr-hrv-value"
                  id="hrHrvValue"
                  style={`color: ${hrvColor}; text-shadow: ${hrvShadow}`}
                >
                  {hrv}
                </span>
                <span class="hr-hrv-unit">{widgets.heartRate.hrvUnit}</span>
              </div>
            </div>
          </div>
          <div class="hr-footer">
            <div class="hr-footer-cell">
              <span class="hr-footer-label">{widgets.heartRate.rhr}</span>
              <>
                <span class="hr-footer-value" id="hrFooterRhr">
                  {fmtRhr}
                </span>
                <span class="hr-footer-unit">{widgets.heartRate.rhrUnit}</span>
              </>
            </div>
            <div class="hr-footer-cell">
              <span class="hr-footer-label">{widgets.heartRate.rr}</span>
              <>
                <span class="hr-footer-value" id="hrFooterRr">
                  {fmtRr}
                </span>
                <span class="hr-footer-unit">{widgets.heartRate.rrUnit}</span>
              </>
            </div>
            <div class="hr-footer-cell">
              <span class="hr-footer-label">{widgets.heartRate.temp}</span>
              <span class="hr-footer-value" id="hrFooterTemp">
                {fmtTemp}
              </span>
            </div>
          </div>
        </>
      )
    }
  </div>
</div>

<style>
  .hr-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--space-48);
  }
  .hr-empty-label {
    font-size: var(--font-size-sm);
    color: var(--text-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Paused state — watch off wrist or charging */
  .hr-paused {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--lg-space-200);
    padding: var(--lg-space-600) var(--lg-space-300);
    text-align: center;
  }
  .hr-paused-icon {
    width: var(--lg-space-600);
    height: var(--lg-space-600);
    color: var(--lg-color-text-disabled);
    opacity: 0.65;
    flex-shrink: 0;
  }
  .hr-paused-label {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption);
    font-weight: var(--lg-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lg-color-text-muted);
  }
  .hr-paused-desc {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption2);
    color: var(--lg-color-text-disabled);
    line-height: 1.4;
    max-width: 22ch;
  }

  /* Tighten card bottom padding so the strip sits flush */
  #cardHR .widget-body {
    padding-bottom: 12px;
  }

  /* Quiet vitals swatch strip (RHR / RR / Temp). ~14-16px tall. */
  .hr-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: var(--lg-space-200);
    padding: 4px 0;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
  }
  .hr-footer-cell {
    display: flex;
    align-items: baseline;
    gap: 3px;
  }
  .hr-footer-label {
    font-family: var(--lg-font-family-system);
    font-size: 0.5rem;
    font-weight: var(--lg-font-weight-medium);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lg-color-text-muted);
    line-height: 1;
  }
  .hr-footer-value {
    font-family: var(--lg-font-family-system);
    font-size: 0.6875rem;
    font-weight: 600;
    color: var(--lg-color-text-title);
    line-height: 1;
    letter-spacing: -0.01em;
  }
  .hr-footer-unit {
    font-family: var(--lg-font-family-system);
    font-size: 0.5rem;
    color: var(--lg-color-text-muted);
    letter-spacing: 0.06em;
    font-weight: var(--lg-font-weight-regular);
    opacity: 0.7;
  }
</style>
