---
import { widgets } from '@j0nathan-ll0yd/copy';

const { health } = Astro.props;
const sleepScore = health.sleepScore;
const sleepDuration = health.sleepDurationFormatted;
const phases = health.sleepPhaseFormatted;
const derived = health.derived;

// Restorative-sleep caption (D2-A): source the ICU template from copy and
// interpolate the deep/REM percentages. The template is em-dash separated:
// "{deep}% deep — {rem}% REM — restorative sleep". We split on the em-dash so
// the web keeps its <span>-wrapped (purple-highlighted) percentage clauses.
const restorativeClauses = widgets.nightSummary.restorative
  .split('—')
  .map((clause) => clause.trim());
const restorativeDeepClause = (restorativeClauses[0] ?? '').replace(
  '{deep}',
  String(derived.deepPct),
);
const restorativeRemClause = (restorativeClauses[1] ?? '').replace('{rem}', String(derived.remPct));
const restorativeTailClause = restorativeClauses[2] ?? '';

const pills = [
  {
    label: widgets.nightSummary.phaseDeep,
    phase: 'deep',
    formatted: phases.deep,
    color: 'var(--lg-color-sleep-deep)',
  },
  {
    label: widgets.nightSummary.phaseRem,
    phase: 'rem',
    formatted: phases.rem,
    color: 'var(--lg-color-sleep-rem)',
  },
  {
    label: widgets.nightSummary.phaseCore,
    phase: 'core',
    formatted: phases.core,
    color: 'var(--lg-color-sleep-core)',
  },
  {
    label: widgets.nightSummary.phaseAwake,
    phase: 'awake',
    formatted: phases.awake,
    color: 'var(--lg-color-accent-amber)',
  },
];
---

<div class="tri-card tri-card-accent-purple" id="cardSleep">
  <div class="widget-header">
    <h3 class="widget-label">{widgets.nightSummary.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot live-dot-purple"></div>
      <span class="widget-timestamp" id="sleepTimestamp"
        >{widgets.nightSummary.timestampLastNight}</span
      >
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
        <div class="skeleton-circle" style="width: 40px; height: 40px;"></div>
        <div class="skeleton-bar" style="width: 80px; height: 22px;"></div>
        <div class="skeleton-bar" style="width: 100%; height: 8px; border-radius: 4px;"></div>
        <div style="display: flex; gap: 8px; flex-wrap: wrap;">
          <div class="skeleton-bar" style="width: 60px; height: 22px; border-radius: 50px;"></div>
          <div class="skeleton-bar" style="width: 55px; height: 22px; border-radius: 50px;"></div>
          <div class="skeleton-bar" style="width: 65px; height: 22px; border-radius: 50px;"></div>
          <div class="skeleton-bar" style="width: 50px; height: 22px; border-radius: 50px;"></div>
        </div>
      </div>
    </div>
    <div class="sleep-moon-top">
      <div class="sleep-moon-wrap">
        <svg width="70" height="70" viewBox="0 0 80 80">
          <defs>
            <filter id="moonGlow">
              <feGaussianBlur stdDeviation="3" result="blur"></feGaussianBlur>
              <feMerge>
                <feMergeNode in="blur"></feMergeNode>
                <feMergeNode in="SourceGraphic"></feMergeNode>
              </feMerge>
            </filter>
          </defs>
          <circle
            cx="40"
            cy="40"
            r="28"
            fill="var(--lg-color-sleep-rem)"
            opacity="0.15"
            filter="url(#moonGlow)"></circle>
          <circle
            cx="40"
            cy="40"
            r="28"
            fill="none"
            stroke="var(--lg-color-sleep-rem)"
            stroke-width="1.5"
            opacity="0.4"></circle>
          <path
            d="M40,12 A28,28 0 1,1 40,68 A20,20 0 1,0 40,12"
            fill="var(--lg-color-sleep-rem)"
            opacity="0.3"
            filter="url(#moonGlow)"></path>
          <circle cx="34" cy="30" r="3" fill="rgba(168,85,247,0.2)"></circle>
          <circle cx="48" cy="45" r="2" fill="rgba(168,85,247,0.15)"></circle>
        </svg>
      </div>
      <div class="sleep-moon-info">
        <div class="sleep-moon-hero" id="sleepDuration">{sleepDuration}</div>
        <div class="sleep-moon-score-row">
          <span class="sleep-moon-score-label">{widgets.nightSummary.score}</span>
          <div class="sleep-moon-score-track">
            <div class="sleep-moon-score-fill" id="sleepScoreFill" style={`width: ${sleepScore}%`}>
            </div>
          </div>
          <span class="sleep-moon-score-val" id="sleepScoreVal">{sleepScore}</span>
        </div>
      </div>
    </div>
    <div class="sleep-moon-pills">
      {
        pills.map((p, i) => (
          <div
            class="sleep-moon-pill"
            data-phase={p.phase}
            style={`background: ${p.color}15; animation-delay: ${i * 0.1 + 0.3}s`}
          >
            <div class="sleep-moon-pill-label">{p.label}</div>
            <div class="sleep-moon-pill-val" style={`color: ${p.color}`}>
              {p.formatted}
            </div>
          </div>
        ))
      }
    </div>
    <div class="sleep-moon-insight" id="sleepInsight">
      <span>{restorativeDeepClause}</span> &mdash; <span>{restorativeRemClause}</span> &mdash; {
        restorativeTailClause
      }
    </div>
  </div>
</div>
