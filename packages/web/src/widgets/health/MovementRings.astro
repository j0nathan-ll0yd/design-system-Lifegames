---
import { widgets, a11y } from '@j0nathan-ll0yd/copy';
import WidgetStateNotice from '../../components/WidgetStateNotice.astro';
import WidgetTimestamp from '../../components/WidgetTimestamp.astro';
import { pendingCopy } from '../../runtime/pending-copy';
import {
  formatMeasurement,
  isScaffoldHidden,
  NO_READING,
  rendersData,
  resolveWidgetState,
  stateRootAttrs,
} from '../../runtime/widget-state';
import type { MovementRingsProps } from './MovementRings.types';

const { health: rawHealth, state: requestedState, generatedAt } = Astro.props as MovementRingsProps;

// Shape adapter: accept the flat `health.movement.*` shape (Swift Props
// contract used by widget fixtures) in addition to the nested
// `health.quantities.*` shape (HealthKit export contract used by the
// runtime updater). The renderer continues to use the nested shape. A flat
// field the fixture omits stays absent — never a 0 (atlas decision 0160).
const m = (rawHealth as any)?.movement as
  | {
      moveKcal?: number;
      exerciseMin?: number;
      standHr?: number;
      steps?: number;
      distanceMeters?: number;
      flights?: number;
      daylightMin?: number;
      goals?: NonNullable<MovementRingsProps['health']>['goals'];
      solar?: NonNullable<MovementRingsProps['health']>['solar'];
    }
  | undefined;
const qty = (value: number | undefined, unit: string) =>
  typeof value === 'number' ? { value, unit } : undefined;
const health: MovementRingsProps['health'] =
  rawHealth == null
    ? undefined
    : (rawHealth as any).quantities
      ? rawHealth
      : ({
          quantities: {
            stepCount: qty(m?.steps, 'count'),
            distanceWalkingRunning: qty(m?.distanceMeters, 'm'),
            flightsClimbed: qty(m?.flights, 'count'),
            activeEnergyBurned: qty(m?.moveKcal, 'kcal'),
            exerciseTime: qty(m?.exerciseMin, 'min'),
            standTime: qty(m?.standHr, 'hr'),
            // Flat-shape standHr is achieved hours — exactly what standHours carries.
            standHours: qty(m?.standHr, 'count'),
            timeInDaylight: qty(m?.daylightMin, 'min'),
          },
          goals: m?.goals,
          solar: m?.solar,
          // Pass watch through from the flat fixture shape so the paused overlay renders.
          watch: (rawHealth as any).watch,
        } as MovementRingsProps['health']);

let widgetState = resolveWidgetState(requestedState, health != null);
const showData = rendersData(widgetState);
const scaffoldHidden = isScaffoldHidden(widgetState);
const q = (showData ? health?.quantities : undefined) ?? {};

// Goals are configuration, not measurements (server-synced; SSR defaults until
// the device's first goals sync). They never stand in for a measurement.
const goals = {
  moveKcal: health?.goals?.moveKcal ?? 500,
  exerciseMin: health?.goals?.exerciseMin ?? 30,
  standHr: health?.goals?.standHr ?? 12,
  daylightMin: health?.goals?.daylightMin ?? 20,
};

const round = (v: number | undefined): number | null =>
  typeof v === 'number' && Number.isFinite(v) ? Math.round(v) : null;

// Stand: prefer the achieved ring count (`standHours`, HKActivitySummary — the
// watch ring's own metric); legacy data falls back to standTime (min → hr).
const standHours: number | null = q.standHours
  ? Math.floor(q.standHours.value)
  : q.standTime
    ? q.standTime.unit === 'min'
      ? Math.floor(q.standTime.value / 60)
      : Math.floor(q.standTime.value)
    : null;

const moveVal = round(q.activeEnergyBurned?.value);
const exerciseVal = round(q.exerciseTime?.value);

// Ring progress fractions (allow >1 for over-fill visual; SVG clamps to 1 turn).
// A missing measurement draws an empty ring and reads as no reading.
const frac = (v: number | null, goal: number): number => (v != null && goal > 0 ? v / goal : 0);
const movePct = frac(moveVal, goals.moveKcal);
const exercisePct = frac(exerciseVal, goals.exerciseMin);
const standPct = frac(standHours, goals.standHr);

const steps = round(q.stepCount?.value);
const distanceM = q.distanceWalkingRunning?.value;
const flights = round(q.flightsClimbed?.value);

// Empty: no movement measurement at all, or every one of them a recorded zero.
const measured = [steps, distanceM ?? null, moveVal, exerciseVal].filter((v) => v != null);
if (showData && measured.every((v) => v === 0)) {
  widgetState = 'empty';
}
const isEmpty = widgetState === 'empty';

const txt = (v: number | null, format: (n: number) => string = String): string =>
  showData ? formatMeasurement(v, format) : '';
const stepsText = txt(steps, (n) => n.toLocaleString('en-US'));
const distanceText = txt(distanceM ?? null, (n) => (n / 1000).toFixed(1));
const flightsText = txt(flights);
const centerText = showData
  ? moveVal != null
    ? `${Math.round(Math.min(movePct, 1) * 100)}%`
    : NO_READING
  : '';
const legend = (v: number | null, goal: number): string =>
  showData ? `${formatMeasurement(v)}/${goal}` : '';

// Ring group accessible name. A missing ring reads "no reading" instead of a number.
const ringPart = (v: number | null, frac: number) =>
  v != null ? `${Math.round(frac * 100)}%` : pendingCopy.widgetState.noReading;
const ringsLabel = a11y.movement.rings
  .replace('{calories}%', ringPart(moveVal, movePct))
  .replace('{exercise}%', ringPart(exerciseVal, exercisePct))
  .replace('{stand}%', ringPart(standHours, standPct));

// SSR paused: if build-data already has watch.worn===false, apply is-paused at SSR time
// so the page is correct before the runtime updater fires.
const ssrPaused = showData && health?.watch?.worn === false;

// Solar footer: server-computed facts. When `solar` is absent, nothing is
// invented — the times read as no reading and the sun dot is not drawn.
const solar = showData ? health?.solar : undefined;
const sunrise = showData ? (solar?.sunriseHHmm ?? NO_READING) : '';
const sunset = showData ? (solar?.sunsetHHmm ?? NO_READING) : '';
// Clamp like the updater does — a contract-violating pct must not paint off-track.
const sunPct = solar ? Math.min(100, Math.max(0, solar.currentProgressPct)) : null;
// Absent daylight = not measured → the no-reading mark, never a mock or a 0.
const daylightMin = round(q.timeInDaylight?.value);
const daylightText = showData ? formatMeasurement(daylightMin) : '';
const daylightHit = daylightMin != null && daylightMin >= goals.daylightMin;

// SVG ring geometry (matches preview html)
const RADII = { move: 60, exercise: 44, stand: 28 };
const CIRC = {
  move: 2 * Math.PI * RADII.move,
  exercise: 2 * Math.PI * RADII.exercise,
  stand: 2 * Math.PI * RADII.stand,
};

// Compute initial stroke-dashoffset (animated to target by updater on load).
// SSR renders the final state so unhydrated pages still look correct.
function offset(circ: number, pct: number): number {
  const visual = Math.min(1, Math.max(0, pct));
  return circ * (1 - visual);
}
---

<div
  class={`tri-card tri-card-accent-red${ssrPaused ? ' is-paused' : ''}${widgetState === 'loading' ? ' is-loading' : ''}`}
  id="cardMovement"
  {...stateRootAttrs(widgetState, generatedAt)}
>
  <div class="widget-header">
    <h3 class="widget-label">{widgets.movement.title}</h3>
    <div class="widget-header-right">
      <div class="live-dot live-dot-red"></div>
      <WidgetTimestamp
        label={widgets.movement.timestampToday}
        state={widgetState}
        generatedAt={generatedAt}
      />
    </div>
  </div>
  <div class="widget-body">
    <div class="skeleton-state">
      <div style="display: grid; grid-template-columns: 144px 1fr; gap: 18px; align-items: center;">
        <div class="skeleton-circle" style="width: 120px; height: 120px; border-radius: 50%;"></div>
        <div style="display: flex; flex-direction: column; gap: 8px;">
          <div class="skeleton-bar" style="width: 100%; height: 28px; border-radius: 8px;"></div>
          <div class="skeleton-bar" style="width: 100%; height: 28px; border-radius: 8px;"></div>
          <div class="skeleton-bar" style="width: 100%; height: 28px; border-radius: 8px;"></div>
        </div>
      </div>
      <div
        style="display: flex; justify-content: space-between; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.04);"
      >
        <div class="skeleton-bar" style="width: 64px; height: 12px;"></div>
        <div class="skeleton-bar" style="width: 64px; height: 12px;"></div>
        <div class="skeleton-bar" style="width: 64px; height: 12px;"></div>
      </div>
      <div
        style="display: flex; align-items: center; gap: 8px; margin-top: 14px; padding-top: 12px; border-top: 1px solid rgba(255,255,255,0.06);"
      >
        <div class="skeleton-bar" style="width: 14px; height: 14px;"></div>
        <div class="skeleton-bar" style="flex: 1; height: 4px;"></div>
        <div class="skeleton-bar" style="width: 14px; height: 14px;"></div>
      </div>
    </div>
    {
      isEmpty && (
        <div class="mv-empty">
          <span class="mv-empty-label">{widgets.movement.empty}</span>
        </div>
      )
    }
    <WidgetStateNotice state={widgetState} />
    {/* Both states stay mounted so live updates can switch without exposing stale values. */}
    <div class="mv-paused" role="status" aria-live="polite" id="mvPaused">
      <svg
        class="mv-paused-icon"
        viewBox="0 0 24 24"
        fill="none"
        aria-hidden="true"
        focusable="false"
      >
        <path
          d="M9 6.5A3 3 0 0 1 12 4a3 3 0 0 1 3 2.5"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></path>
        <rect x="3" y="9" width="18" height="13" rx="2" stroke="currentColor" stroke-width="1.5"
        ></rect>
        <line
          x1="2"
          y1="2"
          x2="22"
          y2="22"
          stroke="currentColor"
          stroke-width="1.5"
          stroke-linecap="round"></line>
      </svg>
      <span class="mv-paused-label" id="mvPausedLabel">
        {
          health.watch?.source === 'charging'
            ? widgets.movement.paused.labelCharging
            : widgets.movement.paused.label
        }
      </span>
      <span class="mv-paused-desc" id="mvPausedDesc">
        {
          health.watch?.source === 'charging'
            ? widgets.movement.paused.descriptionCharging
            : widgets.movement.paused.description
        }
      </span>
    </div>
    {
      !isEmpty && (
        <div class="mv-data" data-state-scaffold hidden={scaffoldHidden}>
          <div class="mv-layout">
            <div class="mv-rings">
              {/* The name belongs on the element carrying role="img", not on the
                  wrapper: an accessible name is computed for the role-bearing
                  element only, and aria-label is prohibited on a bare div
                  (implicit role=generic) — so a label on .mv-rings left the ring
                  group unnamed (axe svg-img-alt, SERIOUS). Same-element pairing
                  matches .mv-sun-track below. */}
              <svg
                viewBox="0 0 144 144"
                role="img"
                aria-label={showData ? ringsLabel : undefined}
                aria-hidden={showData ? undefined : 'true'}
              >
                <circle class="mv-ring-track mv-ring-track-move" cx="72" cy="72" r="60" />
                <circle class="mv-ring-track mv-ring-track-exercise" cx="72" cy="72" r="44" />
                <circle class="mv-ring-track mv-ring-track-stand" cx="72" cy="72" r="28" />
                <circle
                  class="mv-ring-progress mv-ring-move"
                  id="ringMove"
                  cx="72"
                  cy="72"
                  r="60"
                  stroke-dasharray={CIRC.move.toFixed(2)}
                  stroke-dashoffset={offset(CIRC.move, movePct).toFixed(2)}
                />
                <circle
                  class="mv-ring-progress mv-ring-exercise"
                  id="ringExercise"
                  cx="72"
                  cy="72"
                  r="44"
                  stroke-dasharray={CIRC.exercise.toFixed(2)}
                  stroke-dashoffset={offset(CIRC.exercise, exercisePct).toFixed(2)}
                />
                <circle
                  class="mv-ring-progress mv-ring-stand"
                  id="ringStand"
                  cx="72"
                  cy="72"
                  r="28"
                  stroke-dasharray={CIRC.stand.toFixed(2)}
                  stroke-dashoffset={offset(CIRC.stand, standPct).toFixed(2)}
                />
              </svg>
              <div class="mv-rings-center">
                <span class="mv-rings-center-pct" id="ringCenterPct">
                  {centerText}
                </span>
                <span class="mv-rings-center-cap">cal</span>
              </div>
            </div>
            <div class="mv-chips">
              <div class="mv-chip">
                <span class="mv-chip-label">{widgets.movement.steps}</span>
                <span class="mv-chip-value" data-mv-metric="steps">
                  {stepsText}
                </span>
              </div>
              <div class="mv-chip">
                <span class="mv-chip-label">{widgets.movement.distance}</span>
                <span class="mv-chip-value" data-mv-metric="distance">
                  {distanceText}
                  <span class="mv-chip-unit">{widgets.movement.distanceUnit}</span>
                </span>
              </div>
              <div class="mv-chip">
                <span class="mv-chip-label">{widgets.movement.flights}</span>
                <span class="mv-chip-value" data-mv-metric="flights">
                  {flightsText}
                </span>
              </div>
            </div>
          </div>
          <div class="mv-legend">
            <div class="mv-legend-item">
              <span class="mv-legend-swatch mv-legend-swatch-move" />
              <span class="mv-swatch-label">
                <span class="mv-swatch-label-full">{widgets.movement.calories}</span>
                <span class="mv-swatch-label-short">{widgets.movement.caloriesShort}</span>
              </span>
              <span class="mv-legend-val" id="legendMove">
                {legend(moveVal, goals.moveKcal)}
              </span>
            </div>
            <div class="mv-legend-item">
              <span class="mv-legend-swatch mv-legend-swatch-exercise" />
              <span class="mv-swatch-label">
                <span class="mv-swatch-label-full">{widgets.movement.exercise}</span>
                <span class="mv-swatch-label-short">{widgets.movement.exerciseShort}</span>
              </span>
              <span class="mv-legend-val" id="legendExercise">
                {legend(exerciseVal, goals.exerciseMin)}
              </span>
            </div>
            <div class="mv-legend-item">
              <span class="mv-legend-swatch mv-legend-swatch-stand" />
              <span class="mv-swatch-label">
                <span class="mv-swatch-label-full">{widgets.movement.stand}</span>
                <span class="mv-swatch-label-short">{widgets.movement.stand}</span>
              </span>
              <span class="mv-legend-val" id="legendStand">
                {legend(standHours, goals.standHr)}
              </span>
            </div>
          </div>
          <div class="mv-sun-footer">
            <div class="mv-sun-arc-row">
              <span class="mv-sun-glyph" aria-hidden="true">
                ☀
              </span>
              <span class="mv-sun-time" id="mvSunrise">
                {sunrise}
              </span>
              <div class="mv-sun-track" role="img" aria-label={a11y.movement.daylight}>
                <div class="mv-sun-track-line" />
                <div
                  class="mv-sun-dot"
                  id="mvSunDot"
                  style={sunPct != null ? `left: ${sunPct}%` : 'display: none'}
                />
              </div>
              <span class="mv-sun-time" id="mvSunset">
                {sunset}
              </span>
              <span class="mv-sun-glyph mv-sun-glyph-moon" aria-hidden="true">
                ☾
              </span>
            </div>
            <p class="mv-sun-caption">
              <span id="mvDaylightMin">{daylightText}</span>
              {widgets.movement.daylightCaption.replace('{minutes}', '')} &middot;{' '}
              {widgets.movement.daylightGoal.replace('{minutes}', String(goals.daylightMin))}
              {/* Always in the DOM so the updater can toggle it as live daylight changes. */}
              <span class="mv-sun-caption-hit" id="mvDaylightHit" hidden={!daylightHit}>
                &#10003;
              </span>
            </p>
          </div>
        </div>
      )
    }
  </div>
</div>

<style>
  /* Container context — enables @container queries for child elements */
  #cardMovement {
    container-type: inline-size;
    container-name: card-movement;
  }

  .mv-empty {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--space-48);
    padding: var(--lg-space-600) 0;
  }
  .mv-empty-label {
    font-size: var(--lg-font-size-caption);
    color: var(--lg-color-text-muted);
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  /* Paused state — watch off wrist or charging.
     The paused block is always in the DOM (hidden by default).
     When .is-paused is on #cardMovement: show the paused block, hide the data. */
  .mv-paused {
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--lg-space-200);
    padding: var(--lg-space-600) var(--lg-space-300);
    text-align: center;
  }
  /* Data wrapper: hidden when paused so stale ring/step numbers are never shown. */
  #cardMovement.is-paused .mv-data {
    display: none;
  }
  #cardMovement.is-paused .mv-paused {
    display: flex;
  }
  .mv-paused-icon {
    width: var(--lg-space-600);
    height: var(--lg-space-600);
    color: var(--lg-color-text-disabled);
    opacity: 0.65;
    flex-shrink: 0;
  }
  .mv-paused-label {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption);
    font-weight: var(--lg-font-weight-semibold);
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--lg-color-text-muted);
  }
  .mv-paused-desc {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption2);
    color: var(--lg-color-text-disabled);
    line-height: 1.4;
    max-width: 22ch;
  }

  /* Top section — rings + chips */
  .mv-layout {
    display: grid;
    grid-template-columns: 144px 1fr;
    gap: var(--lg-space-450);
    align-items: center;
  }
  .mv-rings {
    width: 144px;
    height: 144px;
    position: relative;
    filter: drop-shadow(0 0 12px rgba(255, 59, 48, 0.15));
  }
  .mv-rings svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .mv-ring-track {
    fill: none;
    stroke-width: 12;
    stroke-linecap: round;
    opacity: 0.18;
  }
  .mv-ring-progress {
    fill: none;
    stroke-width: 12;
    stroke-linecap: round;
    transform: rotate(-90deg);
    transform-origin: center;
    transition: stroke-dashoffset 1.4s var(--lg-motion-easing-decelerate);
  }
  .mv-ring-move {
    stroke: var(--lg-color-health-red);
    filter: drop-shadow(0 0 4px rgba(255, 59, 48, 0.6));
  }
  .mv-ring-exercise {
    stroke: var(--lg-color-health-green);
    filter: drop-shadow(0 0 4px rgba(52, 199, 89, 0.55));
  }
  .mv-ring-stand {
    stroke: var(--lg-color-accent-blue);
    filter: drop-shadow(0 0 4px rgba(58, 134, 255, 0.55));
  }
  .mv-ring-track-move {
    stroke: var(--lg-color-health-red);
  }
  .mv-ring-track-exercise {
    stroke: var(--lg-color-health-green);
  }
  .mv-ring-track-stand {
    stroke: var(--lg-color-accent-blue);
  }

  .mv-rings-center {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    line-height: 1;
    gap: var(--lg-space-50);
  }
  .mv-rings-center-pct {
    font-family: var(--lg-font-family-system);
    font-size: 0.92rem;
    font-weight: var(--lg-font-weight-bold);
    color: var(--lg-color-text-title);
    letter-spacing: -0.01em;
  }
  .mv-rings-center-cap {
    font-family: var(--lg-font-family-system);
    font-size: 0.5rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--lg-color-text-muted);
  }

  /* Right column — chips */
  .mv-chips {
    display: flex;
    flex-direction: column;
    gap: var(--lg-space-150);
  }
  .mv-chip {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    gap: var(--lg-space-200);
    padding: var(--lg-space-150) var(--lg-space-250);
    background: rgba(255, 255, 255, 0.025);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: var(--lg-radius-md);
    position: relative;
  }
  .mv-chip-label {
    font-size: var(--lg-font-size-caption2);
    text-transform: uppercase;
    letter-spacing: 1.8px;
    color: var(--lg-color-text-muted);
  }
  .mv-chip-value {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-body);
    font-weight: var(--lg-font-weight-semibold);
    color: var(--lg-color-text-title);
    letter-spacing: -0.01em;
  }
  .mv-chip-unit {
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption2);
    color: var(--lg-color-text-muted);
    margin-left: 3px;
    font-weight: var(--lg-font-weight-regular);
    letter-spacing: 0.04em;
  }

  /* Legend row */
  .mv-legend {
    display: flex;
    justify-content: space-between;
    gap: var(--lg-space-200);
    margin-top: var(--lg-space-350);
    padding-top: var(--lg-space-300);
    border-top: 1px solid rgba(255, 255, 255, 0.04);
  }
  .mv-legend-item {
    display: flex;
    align-items: center;
    gap: var(--lg-space-150);
    font-family: var(--lg-font-family-system);
    font-size: var(--lg-font-size-caption2);
    color: var(--lg-color-text-muted);
    letter-spacing: 0.08em;
  }
  .mv-legend-swatch {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    flex-shrink: 0;
  }
  .mv-legend-swatch-move {
    background: var(--lg-color-health-red);
    box-shadow: 0 0 6px rgba(255, 59, 48, 0.6);
  }
  .mv-legend-swatch-exercise {
    background: var(--lg-color-health-green);
    box-shadow: 0 0 6px rgba(52, 199, 89, 0.5);
  }
  .mv-legend-swatch-stand {
    background: var(--lg-color-accent-blue);
    box-shadow: 0 0 6px rgba(58, 134, 255, 0.5);
  }
  .mv-legend-val {
    color: var(--lg-color-text-title);
    font-weight: var(--lg-font-weight-semibold);
  }

  /* Sun-arc circadian footer */
  .mv-sun-footer {
    border-top: 1px solid rgba(255, 255, 255, 0.06);
    margin-top: var(--lg-space-350);
    padding-top: var(--lg-space-300);
  }
  .mv-sun-arc-row {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--lg-space-200);
    margin-bottom: var(--lg-space-200);
  }
  .mv-sun-glyph {
    font-size: 0.82rem;
    line-height: 1;
    flex-shrink: 0;
    color: var(--lg-color-accent-amber);
    filter: drop-shadow(0 0 6px rgba(245, 158, 11, 0.7));
  }
  .mv-sun-glyph-moon {
    opacity: 0.85;
    color: var(--lg-color-accent-blue);
