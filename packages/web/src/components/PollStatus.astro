---
import '../styles/primitives.css';
interface Props {
  status: 'ok' | 'warn' | 'error' | 'off';
  label?: string;
  class?: string;
}

const { status, label, class: className } = Astro.props;
---

<span class:list={['lg-poll-status', className]}>
  <span class={`lg-poll-dot lg-poll-dot--${status}`} aria-hidden="true"></span>
  {label && <span class="lg-poll-label">{label}</span>}
</span>
