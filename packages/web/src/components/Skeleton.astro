---
import '../styles/primitives.css';
interface Props {
  variant?: 'bar' | 'circle';
  width?: string;
  height?: string;
  class?: string;
}

const { variant = 'bar', width, height, class: className } = Astro.props;
const style = [width && `width:${width}`, height && `height:${height}`].filter(Boolean).join(';');
---

<div
  class:list={[variant === 'circle' ? 'lg-skeleton-circle' : 'lg-skeleton-bar', className]}
  style={style || undefined}
  aria-hidden="true"
>
</div>
