---
import '../styles/primitives.css';
import { a11y } from '@lifegames/copy';

interface Props {
  visible?: boolean;
  class?: string;
}

const { visible = false, class: className } = Astro.props;
---

<div
  class:list={['lg-modal-overlay', { visible }, className]}
  role="dialog"
  aria-modal="true"
  data-modal-overlay
>
  <div class="lg-modal">
    <button class="lg-modal-close" aria-label={a11y.modal.close} data-modal-close> &times; </button>
    <div class="lg-modal-body">
      <slot />
    </div>
  </div>
</div>
