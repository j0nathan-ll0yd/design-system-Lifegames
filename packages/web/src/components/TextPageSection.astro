---
// One headed section of a TextPage. The default slot is the body: paragraphs, and lists
// whose items may hold a <b> label and a <small> note. TextPage's rules in
// primitives.css style those elements, so the consumer writes plain markup.
import '../styles/primitives.css';

interface Props {
  /** Section heading, rendered as an h2. */
  heading: string;
  /** Fragment target, for example `api` for /developers#api. The heading takes `${id}-heading`. */
  id?: string;
}

const { heading } = Astro.props;
// An empty string is no id: it would render an invalid id="" attribute.
const id = Astro.props.id || undefined;
const headingId = id ? `${id}-heading` : undefined;
---

<section
  class="lg-text-page-section"
  id={id}
  aria-labelledby={headingId}
  aria-label={headingId ? undefined : heading}
>
  <h2 id={headingId} class="lg-text-page-section-heading">{heading}</h2>
  <div class="lg-text-page-section-body">
    <slot />
  </div>
</section>
