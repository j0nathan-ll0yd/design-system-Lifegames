---
// Header timestamp of a live widget (atlas decision 0160).
//
// `stale` replaces the relative label ("live", "today") with an absolute
// "as of" time in the owner's time zone, inside <time datetime>.
// `unavailable`, `suppressed` and `loading` show no label: nothing on the card
// is live. A `stale` card with no valid timestamp shows no label either: it
// never claims "live". `live` and `empty` keep the widget's own label.
// The rule is `widgetTimestampView`, which the browser's `revealLiveData`
// applies too, so server and client render the same header.
// Internal to @j0nathan-ll0yd/web.
import { widgetTimestampView, type WidgetState } from '../runtime/widget-state';

interface Props {
  label: string;
  state: WidgetState;
  generatedAt?: string | null;
  id?: string;
}

const { label, state, generatedAt, id } = Astro.props;
const view = widgetTimestampView(label, state, generatedAt);
---

{
  /* data-live-label lets revealLiveData restore the live label after a stale
    or notice state, so a recovered card never keeps a dishonest header. */
}
{
  view.kind === 'asOf' ? (
    <time
      class="widget-timestamp widget-timestamp-stale"
      id={id}
      datetime={view.datetime}
      data-live-label={label}
    >
      {view.text}
    </time>
  ) : (
    <span class="widget-timestamp" id={id} data-live-label={label}>
      {view.text}
    </span>
  )
}
