---
// Header timestamp of a live widget (atlas decision 0160).
//
// `stale` replaces the relative label ("live", "today") with an absolute
// "as of" time in the owner's time zone, inside <time datetime>.
// `unavailable` and `suppressed` show no label: nothing on the card is live.
// Every other state keeps the widget's own label. Internal to @j0nathan-ll0yd/web.
import { pendingCopy } from '../runtime/pending-copy';
import { formatAsOf, type WidgetState } from '../runtime/widget-state';

interface Props {
  label: string;
  state: WidgetState;
  generatedAt?: string | null;
  id?: string;
}

const { label, state, generatedAt, id } = Astro.props;
const asOf = state === 'stale' ? formatAsOf(generatedAt) : null;
const showLabel = state !== 'unavailable' && state !== 'suppressed';
---

{
  /* data-live-label lets revealLiveData restore the live label after a stale
    or notice state, so a recovered card never keeps a dishonest header. */
}
{
  asOf && generatedAt ? (
    <time
      class="widget-timestamp widget-timestamp-stale"
      id={id}
      datetime={generatedAt}
      data-live-label={label}
    >
      {pendingCopy.widgetState.asOf.replace('{time}', asOf)}
    </time>
  ) : (
    <span class="widget-timestamp" id={id} data-live-label={label}>
      {showLabel ? label : ''}
    </span>
  )
}
