---
// Production-shaped ReadingFeed: typed-props passthrough only.
//
// The consumer fork has no inline script; pagination + live updates are
// handled by the consumer's page-level updaters in src/lib/updaters.ts +
// live-data.ts. Bundling initReadingFeedPagination here would conflict
// with the page-level pagination wiring.
import ReadingFeed from '../widgets/reading/ReadingFeed.astro';
import type { ReadingFeedProps } from '../widgets/reading/ReadingFeed.types';

const props = Astro.props as ReadingFeedProps;
---
<ReadingFeed {...props} />
