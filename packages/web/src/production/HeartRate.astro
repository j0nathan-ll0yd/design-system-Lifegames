---
// Production-shaped HeartRate: typed-props passthrough only.
//
// The consumer fork has no inline script; the ECG canvas is initialized by a
// page-level inline script at consumer's pages/index.astro:166-168 (targets
// #hrEcgCanvas directly). Bundling the heart-rate-init runtime here would
// race against that page-level animation loop and cause canvas layout
// divergence (verified: bundled init produced 73px shorter render).
//
// The showcase use case (apps/portfolio, apps/docs, fixture-driven demos)
// loads heart-rate-init via the existing HeartRateIsland.astro wrapper.
import HeartRate from '../widgets/health/HeartRate.astro';
import type { HeartRateProps } from '../widgets/health/HeartRate.types';

const props = Astro.props as HeartRateProps;
---
<HeartRate {...props} />
