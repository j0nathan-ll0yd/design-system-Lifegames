// with the page-level updaters.
import PlaceLeaderboardV3 from '../widgets/location/PlaceLeaderboardV3.astro';
import type { PlaceLeaderboardV3Props } from '../widgets/location/PlaceLeaderboardV3.types';

const props = Astro.props as PlaceLeaderboardV3Props;
---

<PlaceLeaderboardV3 {...props} />
