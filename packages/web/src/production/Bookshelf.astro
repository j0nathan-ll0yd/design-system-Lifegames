---
// Production-shaped Bookshelf: typed-props passthrough only.
//
// The consumer fork has no inline script; book modal interactions and live
// updates are handled by the consumer's page-level updaters in
// src/lib/updaters.ts + live-data.ts. Bundling initBookshelf here would
// double-bind click handlers.
//
// The showcase use case loads initBookshelf via BookshelfIsland.astro.
import Bookshelf from '../widgets/reading/Bookshelf.astro';
import type { BookshelfProps } from '../widgets/reading/Bookshelf.types';

const props = Astro.props as BookshelfProps;
---
<Bookshelf {...props} />
