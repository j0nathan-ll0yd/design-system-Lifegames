---
// Production-shaped TheatreReviews: typed-props passthrough only.
//
// The consumer fork has no inline script; the poster carousel is driven by
// page-level updaters-theatre.ts + live-data.ts. Bundling initTheatreReviews
// here would double-bind the carousel handlers.
import TheatreReviews from '../widgets/reading/TheatreReviews.astro';
import type { TheatreReviewsProps } from '../widgets/reading/TheatreReviews.types';

const props = Astro.props as TheatreReviewsProps;
---
<TheatreReviews {...props} />
