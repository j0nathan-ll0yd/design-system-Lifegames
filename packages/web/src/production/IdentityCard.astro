---
// Production-shaped IdentityCard: typed-props passthrough, no script.
// The consumer-side fork carries a tiny Simple Analytics tracking script
// (window.sa_event('social_click', {platform})) but that's analytics tooling,
// not widget behavior — production islands ship scriptless. Consumers that
// want click tracking should attach their own analytics listener at the page
// level (e.g., delegated on .id-links a in Dashboard.astro or similar).
//
// compact defaults to true: suppresses widget-header chrome (live-dot,
// timestamp, label) and skeleton-state, matching consumer's pre-migration
// flat identity-card shape. Consumers wanting full chrome can pass
// compact={false} explicitly.
import IdentityCard from '../widgets/identity/IdentityCard.astro';
import type { IdentityCardProps } from '../widgets/identity/IdentityCard.types';

const { compact = true, ...rest } = Astro.props as IdentityCardProps;
---
<IdentityCard {...rest} compact={compact} />
