---
// Production-shaped ExplorationOdometerV3: typed-props widget + bundled odometer runtime.
//
// initExplorationOdometerV3 needs the location data to populate visit/place/city/state
// counts and the homebase city, so props are passed through via Astro's define:vars.
import ExplorationOdometerV3 from '../widgets/location/ExplorationOdometerV3.astro';
import type { ExplorationOdometerV3Props } from '../widgets/location/ExplorationOdometerV3.types';

const props = Astro.props as ExplorationOdometerV3Props;
---
<ExplorationOdometerV3 {...props} />
<script define:vars={{ fixture: props }}>
  import('../runtime/exploration-odometer-init').then(({ initExplorationOdometerV3 }) => {
    const target = document.getElementById('cardExplorationOdometerV3');
    if (target) initExplorationOdometerV3(target, fixture);
  });
</script>
