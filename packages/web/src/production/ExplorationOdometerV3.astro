---
// Production-shaped ExplorationOdometerV3: typed-props passthrough only.
//
// The consumer fork has no inline script; rendering is driven by build-time
// SSR data plus page-level updaters-odometer-variations.ts + live-data.ts.
// Bundling initExplorationOdometerV3 here would race with the page-level
// updaters.
import ExplorationOdometerV3 from '../widgets/location/ExplorationOdometerV3.astro';
import type { ExplorationOdometerV3Props } from '../widgets/location/ExplorationOdometerV3.types';

const props = Astro.props as ExplorationOdometerV3Props;
---

<ExplorationOdometerV3 {...props} />
