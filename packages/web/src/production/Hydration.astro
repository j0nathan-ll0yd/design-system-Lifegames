---
// Production-shaped Hydration: typed-props widget + bundled runtime for the
// count-up animation + range overlay rendering.
//
// initHydration needs the fixture values. We bridge them across the
// SSR -> runtime boundary via a JSON `data-*` attribute on a hidden carrier
// element (mirrors BookModal's `data-book` pattern), then a bundled module
// reads + parses it. This is CSP-clean: no inline script body and no
// `window.__lgHydrationFixtures` global.
//
// Why a data attribute instead of the previous inline `define:vars` bridge:
// CSP `script-src 'self'` rejects inline script bodies in production, so the
// old bridge silently failed and the widget stayed in its SSR skeleton
// forever.
//
// Atlas decision 0160: the widget now renders its values in server markup, and
// the carrier holds ONLY the hydration fields, and only in the data states
// (live, stale). In unavailable, suppressed, empty and loading it is absent,
// so no gated or unrelated health field can reach the HTML through it.
import Hydration from '../widgets/health/Hydration.astro';
import type { HydrationProps } from '../widgets/health/Hydration.types';
import { rendersData, resolveWidgetState } from '../runtime/widget-state';

const props = Astro.props as HydrationProps;
const state = resolveWidgetState(props.state, props.health?.hydration != null);
const carrier: HydrationProps | null =
  rendersData(state) && props.health
    ? { state, health: { hydration: { ...props.health.hydration } } }
    : null;
---

<Hydration {...props} />
{carrier && <div id="cardHydrationData" data-hydration-fixture={JSON.stringify(carrier)} hidden />}
<script>
  import { initHydration } from '../runtime/hydration-init';
  const target = document.getElementById('cardHydration');
  const carrier = document.getElementById('cardHydrationData');
  const raw = carrier?.dataset.hydrationFixture;
  if (target && raw) {
    try {
      initHydration(target, JSON.parse(raw));
    } catch (err) {
      if (window.console && console.error) {
        console.error('[Hydration] bad data-hydration-fixture JSON', err);
      }
    }
  }
</script>
