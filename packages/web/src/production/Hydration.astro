---
// Production-shaped Hydration: typed-props widget + bundled runtime for the
// count-up animation + range overlay rendering.
//
// initHydration needs the fixture values. We split the script in two:
//   1) inline (define:vars) — stashes the fixture on window under a
//      per-element key so multiple instances are isolated;
//   2) bundled module — statically imports the runtime so Vite resolves
//      the path correctly in both dev (no pre-bundle) and build modes.
//
// A single `<script define:vars>` with a dynamic import() does NOT work in
// dev: Astro emits the script verbatim and the relative import is
// interpreted as a literal URL (404).
import Hydration from '../widgets/health/Hydration.astro';
import type { HydrationProps } from '../widgets/health/Hydration.types';

const props = Astro.props as HydrationProps;
---
<Hydration {...props} />
<script define:vars={{ fixture: props }} is:inline>
  (window.__lgHydrationFixtures = window.__lgHydrationFixtures || {})['cardHydration'] = fixture;
</script>
<script>
  import { initHydration } from '../runtime/hydration-init';
  const target = document.getElementById('cardHydration');
  const fixture = (window as any).__lgHydrationFixtures?.['cardHydration'];
  if (target && fixture) initHydration(target, fixture);
</script>
