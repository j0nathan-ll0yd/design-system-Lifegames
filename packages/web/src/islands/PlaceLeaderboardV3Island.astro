---
import PlaceLeaderboardV3 from '@widgets/location/PlaceLeaderboardV3.astro';
const { fixture } = Astro.props;
---

<div data-widget-preview data-fixture={JSON.stringify(fixture)}>
  <PlaceLeaderboardV3 />
</div>
<script>
  import { initPlaceLeaderboardV3 } from '../runtime/place-leaderboard-init';
  const wrappers = document.querySelectorAll<HTMLElement>('[data-widget-preview][data-fixture]');
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const fixture = JSON.parse(el.dataset.fixture || '{}');
        if (fixture.topPlaces !== undefined) {
          initPlaceLeaderboardV3(el, fixture);
          io.unobserve(el);
        }
      }
    }
  });
  wrappers.forEach((w) => io.observe(w));
</script>
