---
import Hydration from '@widgets/health/Hydration.astro';
const { fixture } = Astro.props;
---

<div data-widget-preview data-fixture={JSON.stringify(fixture)}>
  <Hydration {...fixture} />
</div>
<script>
  import { initHydration } from '../runtime/hydration-init';
  const wrappers = document.querySelectorAll<HTMLElement>('[data-widget-preview][data-fixture]');
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const fixture = JSON.parse(el.dataset.fixture || '{}');
        if (fixture.health?.hydration) {
          initHydration(el, fixture);
          io.unobserve(el);
        }
      }
    }
  });
  wrappers.forEach((w) => io.observe(w));
</script>
