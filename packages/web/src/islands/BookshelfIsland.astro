---
import Bookshelf from '@widgets/reading/Bookshelf.astro';
const { fixture } = Astro.props;
---

<div data-widget-preview data-fixture={JSON.stringify(fixture)}>
  <Bookshelf {...fixture} />
</div>
<script>
  import { initBookshelf } from '../runtime/bookshelf-init';
  const wrappers = document.querySelectorAll<HTMLElement>('[data-widget-preview][data-fixture]');
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const fixture = JSON.parse(el.dataset.fixture || '{}');
        if (fixture.books) {
          initBookshelf(el, fixture);
          io.unobserve(el);
        }
      }
    }
  });
  wrappers.forEach((w) => io.observe(w));
  // Fallback: init wrappers already visible (IO may not fire under overflow:hidden parents)
  setTimeout(() => {
    wrappers.forEach((w) => {
      const fixture = JSON.parse(w.dataset.fixture || '{}');
      if (fixture.books) {
        initBookshelf(w, fixture);
        io.unobserve(w);
      }
    });
  }, 0);
</script>
