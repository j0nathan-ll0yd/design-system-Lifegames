---
import TheatreReviews from '@widgets/reading/TheatreReviews.astro';
const { fixture } = Astro.props;
---
<div data-widget-preview data-fixture={JSON.stringify(fixture)}>
  <TheatreReviews {...fixture} />
</div>
<script>
  import { initTheatreReviews } from '../runtime/theatre-init';
  const wrappers = document.querySelectorAll<HTMLElement>('[data-widget-preview][data-fixture]');
  const io = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const el = entry.target as HTMLElement;
        const fixture = JSON.parse(el.dataset.fixture || '{}');
        if (fixture.reviews) {
          initTheatreReviews(el, fixture);
          io.unobserve(el);
        }
      }
    }
  });
  wrappers.forEach((w) => io.observe(w));
  // Fallback: init wrappers already visible (IO may not fire under overflow:hidden parents)
  setTimeout(() => {
    wrappers.forEach((w) => {
      const fixture = JSON.parse(w.dataset.fixture || '{}');
      if (fixture.reviews) {
        initTheatreReviews(w, fixture);
        io.unobserve(w);
      }
    });
  }, 0);
</script>
