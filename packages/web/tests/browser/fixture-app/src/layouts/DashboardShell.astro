---
// The website's dashboard document shell, reduced to what decides whether the page
// scrolls: the DS stylesheets the website's src/layouts/Dashboard.astro imports, in its
// order, and that file's inline html and body rules ("GLOBAL STYLES") with every
// declaration intact; only the formatter's layout differs. At 1100px and up those rules
// lock html and body to 100dvh with overflow hidden. tests/browser/text-page.test.ts
// loads two pages through this shell.
import '../../../../../../tokens/src/preamble.css';
import '../../../../../../tokens/dist/tokens-layered.css';
import '../../../../../../tokens/src/compat.css';
import '../../../../../src/styles/components.css';
import '../../../../../../tokens/src/effects.css';
import '../../../../../../tokens/src/reset.css';
import '../../../../../src/styles/a11y.css';
import '../../../../../src/styles/layout.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <style is:inline>
      html,
      body {
        height: 100%;
        height: 100dvh;
        font-family: 'Space Grotesk', 'Space Grotesk Fallback', sans-serif;
        background: var(--bg);
        color: var(--text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }
      html {
        overflow-y: scroll;
      }
      @supports (scrollbar-gutter: stable) {
        html {
          overflow-y: auto;
          scrollbar-gutter: stable;
        }
      }
      @media (min-width: 1100px) {
        html,
        body {
          overflow: hidden;
        }
      }
    </style>
  </head>
  <body>
    <slot />
  </body>
</html>
