{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifegames.org/schemas/copy.identity.flat.schema.json",
  "type": "object",
  "title": "Identity",
  "description": "Rich authoring schema for the identity slice of @j0nathan-ll0yd/copy. Every customer-facing identity string is a CopyString/CopyStringList leaf carrying authoring context in _meta. The copy build derives a FLAT schema from this one (stripping _meta) for all consumer codegen (TS/Zod/Swift). Strings are authored in ICU MessageFormat 1 syntax.",
  "properties": {
    "person": {
      "type": "object",
      "description": "Identity facts and biographical voices for Jonathan Lloyd.",
      "properties": {
        "name": {
          "type": "string"
        },
        "firstName": {
          "type": "string"
        },
        "lastName": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "jobTitle": {
          "type": "string"
        },
        "employer": {
          "type": "string"
        },
        "employerUrl": {
          "type": "string"
        },
        "alumniOf": {
          "type": "string"
        },
        "alumniOfUrl": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "yearsExperience": {
          "type": "string"
        },
        "philosophy": {
          "type": "string"
        },
        "skills": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interests": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "sameAs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shortBio": {
          "type": "string"
        },
        "socialBio": {
          "type": "string"
        },
        "longBio": {
          "type": "string"
        },
        "flavorBio": {
          "type": "string"
        },
        "experiencePhrase": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "firstName",
        "lastName",
        "handle",
        "jobTitle",
        "employer",
        "employerUrl",
        "alumniOf",
        "alumniOfUrl",
        "location",
        "yearsExperience",
        "philosophy",
        "skills",
        "interests",
        "sameAs",
        "shortBio",
        "socialBio",
        "longBio",
        "flavorBio",
        "experiencePhrase"
      ],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "description": "Brand/site-level naming and description.",
      "properties": {
        "name": {
          "type": "string"
        },
        "fullName": {
          "type": "string"
        },
        "tagline": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "pwaDescription": {
          "type": "string"
        }
      },
      "required": ["name", "fullName", "tagline", "description", "pwaDescription"],
      "additionalProperties": false
    },
    "seo": {
      "type": "object",
      "description": "SEO/metadata copy. Composed strings are stored whole (D7), never concatenated in consumers.",
      "properties": {
        "title": {
          "type": "string"
        },
        "keywords": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "expertise": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ogImageQuote": {
          "type": "string"
        }
      },
      "required": ["title", "keywords", "expertise", "ogImageQuote"],
      "additionalProperties": false
    },
    "a11y": {
      "type": "object",
      "description": "Accessibility copy in the V1 identity slice (skip link + OG image alt). The rest of a11y is V2.",
      "properties": {
        "skipToMain": {
          "type": "string"
        },
        "ogImageAlt": {
          "type": "string"
        }
      },
      "required": ["skipToMain", "ogImageAlt"],
      "additionalProperties": false
    },
    "humansTxt": {
      "type": "object",
      "description": "humans.txt endpoint data — web stack, hosting, standards, and credits for the SITE and THANKS sections.",
      "properties": {
        "stack": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hosting": {
          "type": "string"
        },
        "standards": {
          "type": "string"
        },
        "thanks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": ["stack", "hosting", "standards", "thanks"],
      "additionalProperties": false
    },
    "feed": {
      "type": "object",
      "description": "RSS 2.0 + JSON Feed channel copy — title, description, author, copyright, and per-domain section labels.",
      "properties": {
        "title": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "copyright": {
          "type": "string"
        },
        "sections": {
          "type": "object",
          "description": "Per-domain section labels for feed items.",
          "properties": {
            "theatre": {
              "type": "string"
            },
            "github": {
              "type": "string"
            },
            "starred": {
              "type": "string"
            },
            "books": {
              "type": "string"
            },
            "articles": {
              "type": "string"
            }
          },
          "required": ["theatre", "github", "starred", "books", "articles"],
          "additionalProperties": false
        }
      },
      "required": ["title", "description", "author", "copyright", "sections"],
      "additionalProperties": false
    },
    "privacy": {
      "type": "object",
      "description": "Privacy policy page copy — plain-English sections covering who operates the site, what data is displayed, what is collected from visitors, analytics, user rights, and change notifications. Includes section headings, the last-updated label, and the back-link.",
      "properties": {
        "title": {
          "type": "string"
        },
        "lastUpdated": {
          "type": "string"
        },
        "lastUpdatedLabel": {
          "type": "string"
        },
        "backLink": {
          "type": "string"
        },
        "whoHeading": {
          "type": "string"
        },
        "dataDisplayedHeading": {
          "type": "string"
        },
        "dataCollectedHeading": {
          "type": "string"
        },
        "analyticsHeading": {
          "type": "string"
        },
        "rightsHeading": {
          "type": "string"
        },
        "changesHeading": {
          "type": "string"
        },
        "who": {
          "type": "string"
        },
        "dataDisplayed": {
          "type": "string"
        },
        "dataCollected": {
          "type": "string"
        },
        "analytics": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "changes": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "lastUpdated",
        "lastUpdatedLabel",
        "backLink",
        "whoHeading",
        "dataDisplayedHeading",
        "dataCollectedHeading",
        "analyticsHeading",
        "rightsHeading",
        "changesHeading",
        "who",
        "dataDisplayed",
        "dataCollected",
        "analytics",
        "rights",
        "changes"
      ],
      "additionalProperties": false
    }
  },
  "required": ["person", "site", "seo", "a11y", "humansTxt", "feed", "privacy"],
  "additionalProperties": false
}
