{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifegames.org/schemas/copy.widgets.flat.schema.json",
  "type": "object",
  "title": "Widgets",
  "description": "Rich authoring schema for the widgets slice of @lifegames/copy (V2 Wave 1a). Every customer-facing widget label, unit, empty-state, zone/phase name, and timestamp badge is a CopyString/CopyStringList leaf carrying authoring context in _meta. The copy build derives a FLAT schema from this one (stripping _meta) for all consumer codegen (TS/Zod/Swift). Strings are authored in ICU MessageFormat 1 syntax. Casing is canonical natural-case (D3): consumers apply any uppercasing as a display-only transform; no all-caps literals are stored. The $defs block is byte-identical to schema/identity.schema.json (per-file inlined, no cross-file $ref — §3.2).",
  "properties": {
    "heartRate": {
      "type": "object",
      "description": "Heart Rate widget — title, metric labels/units, HR zone names, empty-state, timestamp.",
      "properties": {
        "title": {
          "type": "string"
        },
        "bpm": {
          "type": "string"
        },
        "hrv": {
          "type": "string"
        },
        "hrvUnit": {
          "type": "string"
        },
        "rhr": {
          "type": "string"
        },
        "rhrUnit": {
          "type": "string"
        },
        "rr": {
          "type": "string"
        },
        "rrUnit": {
          "type": "string"
        },
        "temp": {
          "type": "string"
        },
        "empty": {
          "type": "string"
        },
        "zoneBradycardia": {
          "type": "string"
        },
        "zoneResting": {
          "type": "string"
        },
        "zoneNormal": {
          "type": "string"
        },
        "zoneFatBurn": {
          "type": "string"
        },
        "zonePeak": {
          "type": "string"
        },
        "timestampLive": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "bpm",
        "hrv",
        "hrvUnit",
        "rhr",
        "rhrUnit",
        "rr",
        "rrUnit",
        "temp",
        "empty",
        "zoneBradycardia",
        "zoneResting",
        "zoneNormal",
        "zoneFatBurn",
        "zonePeak",
        "timestampLive"
      ],
      "additionalProperties": false
