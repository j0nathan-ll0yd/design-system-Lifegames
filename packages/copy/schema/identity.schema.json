{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lifegames.org/schemas/copy.identity.schema.json",
  "title": "LifegamesCopyIdentity",
  "description": "Rich authoring schema for the identity slice of @lifegames/copy. Every customer-facing identity string is a CopyString/CopyStringList leaf carrying authoring context in _meta. The copy build derives a FLAT schema from this one (stripping _meta) for all consumer codegen (TS/Zod/Swift). Strings are authored in ICU MessageFormat 1 syntax.",
  "type": "object",
  "additionalProperties": false,
  "required": ["person", "site", "seo", "a11y", "humansTxt", "feed", "privacy"],
  "properties": {
    "person": {
      "type": "object",
      "description": "Identity facts and biographical voices for Jonathan Lloyd.",
      "additionalProperties": false,
      "required": [
        "name",
        "firstName",
        "lastName",
        "handle",
        "jobTitle",
        "location",
        "yearsExperience",
        "philosophy",
        "skills",
        "interests",
        "sameAs",
        "shortBio",
        "socialBio",
        "longBio",
        "flavorBio",
        "experiencePhrase"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/CopyString"
        },
        "firstName": {
          "$ref": "#/$defs/CopyString"
        },
        "lastName": {
          "$ref": "#/$defs/CopyString"
        },
        "handle": {
          "$ref": "#/$defs/CopyString"
        },
        "jobTitle": {
          "$ref": "#/$defs/CopyString"
        },
        "location": {
          "$ref": "#/$defs/CopyString"
        },
        "yearsExperience": {
          "$ref": "#/$defs/CopyString"
        },
        "philosophy": {
          "$ref": "#/$defs/CopyString"
        },
        "skills": {
          "$ref": "#/$defs/CopyStringList"
        },
        "interests": {
          "$ref": "#/$defs/CopyStringList"
        },
        "sameAs": {
          "$ref": "#/$defs/CopyStringList"
        },
        "shortBio": {
          "$ref": "#/$defs/CopyString"
        },
        "socialBio": {
          "$ref": "#/$defs/CopyString"
        },
        "longBio": {
          "$ref": "#/$defs/CopyString"
        },
        "flavorBio": {
          "$ref": "#/$defs/CopyString"
        },
        "experiencePhrase": {
          "$ref": "#/$defs/CopyString"
        }
      }
    },
    "site": {
      "type": "object",
      "description": "Brand/site-level naming and description.",
      "additionalProperties": false,
      "required": ["name", "fullName", "tagline", "description", "pwaDescription"],
      "properties": {
        "name": {
          "$ref": "#/$defs/CopyString"
        },
        "fullName": {
          "$ref": "#/$defs/CopyString"
        },
        "tagline": {
          "$ref": "#/$defs/CopyString"
        },
        "description": {
          "$ref": "#/$defs/CopyString"
        },
        "pwaDescription": {
          "$ref": "#/$defs/CopyString"
        }
      }
    },
    "seo": {
      "type": "object",
      "description": "SEO/metadata copy. Composed strings are stored whole (D7), never concatenated in consumers.",
      "additionalProperties": false,
      "required": ["title", "keywords", "expertise", "ogImageQuote"],
      "properties": {
        "title": {
          "$ref": "#/$defs/CopyString"
        },
        "keywords": {
          "$ref": "#/$defs/CopyStringList"
        },
        "expertise": {
          "$ref": "#/$defs/CopyStringList"
        },
        "ogImageQuote": {
          "$ref": "#/$defs/CopyString"
        }
      }
    },
    "a11y": {
      "type": "object",
      "description": "Accessibility copy in the V1 identity slice (skip link + OG image alt). The rest of a11y is V2.",
      "additionalProperties": false,
      "required": ["skipToMain", "ogImageAlt"],
      "properties": {
        "skipToMain": {
          "$ref": "#/$defs/CopyString"
        },
        "ogImageAlt": {
          "$ref": "#/$defs/CopyString"
        }
      }
    },
    "humansTxt": {
      "type": "object",
      "description": "humans.txt endpoint data — web stack, hosting, standards, and credits for the SITE and THANKS sections.",
      "additionalProperties": false,
      "required": ["stack", "hosting", "standards", "thanks"],
      "properties": {
        "stack": {
          "$ref": "#/$defs/CopyStringList"
        },
        "hosting": {
          "$ref": "#/$defs/CopyString"
        },
        "standards": {
          "$ref": "#/$defs/CopyString"
        },
        "thanks": {
          "$ref": "#/$defs/CopyStringList"
        }
      }
    },
    "feed": {
      "type": "object",
      "description": "RSS 2.0 + JSON Feed channel copy — title, description, author, copyright, and per-domain section labels.",
      "additionalProperties": false,
      "required": ["title", "description", "author", "copyright", "sections"],
      "properties": {
        "title": {
          "$ref": "#/$defs/CopyString"
        },
        "description": {
          "$ref": "#/$defs/CopyString"
        },
        "author": {
          "$ref": "#/$defs/CopyString"
        },
        "copyright": {
          "$ref": "#/$defs/CopyString"
        },
        "sections": {
          "type": "object",
          "description": "Per-domain section labels for feed items.",
          "additionalProperties": false,
          "required": ["theatre", "github", "starred", "books", "articles"],
          "properties": {
            "theatre": {
              "$ref": "#/$defs/CopyString"
            },
            "github": {
              "$ref": "#/$defs/CopyString"
            },
            "starred": {
              "$ref": "#/$defs/CopyString"
            },
            "books": {
              "$ref": "#/$defs/CopyString"
            },
            "articles": {
              "$ref": "#/$defs/CopyString"
            }
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "description": "Privacy policy page copy — plain-English sections covering who operates the site, what data is displayed, what is collected from visitors, analytics, user rights, and change notifications.",
      "additionalProperties": false,
      "required": [
        "title",
        "lastUpdated",
        "who",
        "dataDisplayed",
        "dataCollected",
        "analytics",
        "rights",
        "changes"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/CopyString"
        },
        "lastUpdated": {
          "$ref": "#/$defs/CopyString"
        },
        "who": {
          "$ref": "#/$defs/CopyString"
        },
        "dataDisplayed": {
          "$ref": "#/$defs/CopyString"
        },
        "dataCollected": {
          "$ref": "#/$defs/CopyString"
        },
        "analytics": {
          "$ref": "#/$defs/CopyString"
        },
        "rights": {
          "$ref": "#/$defs/CopyString"
        },
        "changes": {
          "$ref": "#/$defs/CopyString"
        }
      }
    }
  },
  "$defs": {
    "CopyMeta": {
      "type": "object",
      "description": "Authoring context attached to every copy leaf (D6). Drives auditing, reconciliation, and CI-lintable constraints.",
      "additionalProperties": false,
      "required": ["description", "usage", "register", "audience", "owner", "lastReviewed"],
      "properties": {
        "description": {
          "type": "string",
          "description": "What this string is and why it exists."
        },
        "usage": {
          "type": "array",
          "description": "Every render site / placement where this string appears (file:line or surface name). Makes duplication and placement visible for reconciliation (D11).",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "register": {
          "type": "string",
          "enum": ["atom", "label", "factual", "expressive", "machine", "brand", "consent"],
          "description": "Voice register (see packages/copy/VOICE.md): atom | label | factual | expressive | machine | brand | consent."
        },
        "audience": {
          "type": "string",
          "enum": ["human", "machine", "dual"],
          "description": "Primary audience: human | machine | dual. Drives the human↔AI arbitration rule (machine/dual surfaces stay literal/parseable)."
        },
        "owner": {
          "type": "string",
          "description": "Who owns this string's wording."
        },
        "lastReviewed": {
          "type": "string",
          "format": "date",
          "description": "ISO-8601 date (YYYY-MM-DD) the wording was last deliberately reviewed."
        },
        "constraints": {
          "type": "object",
          "description": "Optional machine-checkable constraints (CI-enforced).",
          "additionalProperties": false,
          "properties": {
            "maxChars": {
              "type": "integer",
              "minimum": 1,
              "description": "Maximum rendered length. CI fails if value exceeds this."
            }
          }
        },
        "rationale": {
          "type": "string",
          "description": "Optional: why this wording/variant exists distinctly (intent, history)."
        }
      }
    },
    "CopyString": {
      "type": "object",
      "description": "A single customer-facing string (ICU MF1 syntax) plus its authoring context.",
      "additionalProperties": false,
      "required": ["value", "_meta"],
      "properties": {
        "value": {
          "type": "string",
          "description": "The string, authored in ICU MessageFormat 1 syntax."
        },
        "_meta": {
          "$ref": "#/$defs/CopyMeta"
        }
      }
    },
    "CopyStringList": {
      "type": "object",
      "description": "An ordered list of customer-facing strings (each ICU MF1) plus shared authoring context.",
      "additionalProperties": false,
      "required": ["value", "_meta"],
      "properties": {
        "value": {
          "type": "array",
          "description": "The strings, each authored in ICU MessageFormat 1 syntax.",
          "items": {
            "type": "string"
          }
        },
        "_meta": {
          "$ref": "#/$defs/CopyMeta"
        }
      }
    }
  }
}
