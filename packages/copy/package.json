{
  "name": "@j0nathan-ll0yd/copy",
  "version": "1.0.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "description": "Single source of truth for customer-facing copy (identity + widgets + a11y + app + permissions + errors + llm) across web, iOS, the design system, and the backend. Zero runtime dependencies; rich per-string authoring context (_meta); ICU MessageFormat 1 syntax.",
  "type": "module",
  "exports": {
    ".": "./dist/index.ts",
    "./identity.flat.json": "./dist/identity.flat.json",
    "./identity.zod": "./dist/identity.zod.ts",
    "./widgets.flat.json": "./dist/widgets.flat.json",
    "./widgets.zod": "./dist/widgets.zod.ts",
    "./a11y.flat.json": "./dist/a11y.flat.json",
    "./a11y.zod": "./dist/a11y.zod.ts",
    "./app.flat.json": "./dist/app.flat.json",
    "./app.zod": "./dist/app.zod.ts",
    "./permissions.flat.json": "./dist/permissions.flat.json",
    "./permissions.zod": "./dist/permissions.zod.ts",
    "./errors.flat.json": "./dist/errors.flat.json",
    "./errors.zod": "./dist/errors.zod.ts",
    "./llm.flat.json": "./dist/llm.flat.json",
    "./llm.zod": "./dist/llm.zod.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "build:copy": "tsx scripts/build.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,jsx,mjs,cjs}\"",
    "grep-gate": "node scripts/check-no-hardcoded-copy.mjs",
    "voice": "node scripts/check-copy-voice.mjs",
    "voice:report": "node scripts/check-copy-voice.mjs --report"
  },
  "dependencies": {},
  "devDependencies": {
    "@formatjs/icu-messageformat-parser": "^2.11.0",
    "@typescript-eslint/parser": "^8.61.0",
    "ajv": "~8.20.0",
    "ajv-formats": "~3.0.1",
    "eslint": "^10.4.1",
    "json-schema-to-typescript": "^15.0.4",
    "json-schema-to-zod": "^2.8.1",
    "prettier": "3.6.0",
    "prettier-plugin-astro": "0.14.1",
    "quicktype": "^23.2.6",
    "tsx": "^4.22.4",
    "vitest": "^4.1.8"
  }
}
