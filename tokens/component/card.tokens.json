{
  "card": {
    "background": { "$type": "color", "$value": "{color.surface.raised}" },
    "border": { "$type": "color", "$value": "{color.border.default}" },
    "borderHover": { "$type": "color", "$value": "{color.border.interactive}" },
    "cornerRadius": { "$type": "dimension", "$value": "{space.400}", "$description": "16px" },
    "padding": { "$type": "dimension", "$value": "{space.800}", "$description": "32px" },
