{
  "color": {
    "$type": "color",
    "surface": {
      "base": { "$value": "{color.gray.950}", "$description": "Primary background" },
      "deep": { "$value": "{color.gray.900}", "$description": "Secondary background" },
      "raised": {
        "$value": "{color.alpha.white5}",
        "$description": "Card/glass background (5% white overlay)"
      },
      "raisedHover": {
        "$value": "{color.alpha.white7}",
        "$description": "Card hover state — brighter than rest per industry-default hover-emphasis convention"
      },
      "inset": { "$value": "{color.alpha.white3}", "$description": "Inset/recessed surface" }
    },
    "border": {
      "default": { "$value": "{color.alpha.white6}", "$description": "Default border" },
      "subtle": { "$value": "{color.alpha.white10}", "$description": "Glass border" },
      "strong": { "$value": "{color.alpha.white18}", "$description": "Emphasized border" },
      "interactive": {
        "$value": "rgba(99,102,241,0.2)",
        "$description": "Interactive hover border (indigo accent — not covered by white/black alpha primitive set)"
      }
    },
    "text": {
      "title": { "$value": "{color.zinc.100}", "$description": "Heading text" },
      "primary": {
        "$value": "{color.zinc.300}",
        "$description": "Body text. Web parity: zinc.300 = #f0f0f0 matches production --text. iOS textPrimary remains zinc.200 (#e4e4e7) via SwiftUI layer (MA2)."
      },
      "muted": {
        "$value": "{color.zinc.400}",
        "$description": "Secondary text. Uses web value #9ca3af cross-platform. Converged upward for accessibility (MA2)."
      },
      "subtle": { "$value": "{color.zinc.600}", "$description": "Tertiary text" },
      "disabled": { "$value": "{color.zinc.700}", "$description": "Disabled/arrow text" }
    },
    "accent": {
      "pink": { "$value": "{color.pink.500}" },
      "blue": { "$value": "{color.blue.500}" },
      "blue-on-dark": {
        "$value": "{color.blue.300}",
        "$description": "Accessible blue for readable text on the dashboard dark background (#06060f). ~9:1 contrast — meets WCAG AA (≥4.5:1) and AAA (≥7:1). Use wherever blue.500 (#3a86ff, ~1.78:1) would appear as readable text on dark surfaces."
      },
      "green": { "$value": "{color.green.500}" },
      "amber": { "$value": "{color.amber.500}" },
      "purple": { "$value": "{color.purple.500}" },
      "red": { "$value": "{color.red.500}" },
      "cyan": { "$value": "{color.cyan.500}" },
      "orange": { "$value": "{color.orange.500}" },
      "indigo": { "$value": "{color.indigo.500}" },
      "default": { "$value": "{color.indigo.600}", "$description": "Primary accent (iOS accent)" }
    },
    "accent-hc": {
      "pink": { "$value": "{color.pink.400}", "$description": "High-contrast variant (AAA)" },
      "purple": { "$value": "{color.purple.400}" },
      "red": { "$value": "{color.red.400}" }
    },
    "health": {
      "red": { "$value": "{color.red.apple}", "$description": "Apple Health move ring" },
      "green": {
        "$value": "{color.appleHealth.green}",
        "$description": "Apple Health exercise ring"
      },
      "purple": { "$value": "{color.indigo.700}", "$description": "Apple Health stand ring" }
    },
    "interactive": {
      "default": { "$value": "{color.indigo.600}", "$description": "Buttons, links" },
      "hover": { "$value": "{color.purple.600}", "$description": "Hover state" }
    },
    "sleep": {
      "$description": "Sleep-phase palette. Four phases (deep/rem/core/awake) shared by iOS NightSummary and web NightSummary pills.",
      "deep": {
        "$type": "color",
        "$value": "{color.blue.700}",
        "$description": "Deep sleep phase (web NightSummary deep pill)"
      },
      "rem": {
        "$type": "color",
        "$value": "{color.purple.550}",
        "$description": "REM sleep phase (WCAG AA for white text on bg)"
      },
      "core": {
        "$type": "color",
        "$value": "{color.blue.550}",
        "$description": "Core sleep phase (WCAG AA for white text on bg)"
      },
      "awake": {
        "$type": "color",
        "$value": "{color.zinc.400}",
        "$description": "Awake (muted; rendered as inactive surface in NightSummary)"
      }
    },
    "status": {
      "warning": {
        "$value": "{color.yellow.500}",
        "$description": "Warning state (iOS statusWarning)"
      }
    },
    "podium": {
      "$description": "Medal podium colors for PlaceLeaderboard rankings.",
      "gold": { "$value": "{color.gold.500}", "$description": "1st place" },
      "silver": { "$value": "{color.silver.500}", "$description": "2nd place" },
      "bronze": { "$value": "{color.bronze.500}", "$description": "3rd place" }
    }
  }
}
