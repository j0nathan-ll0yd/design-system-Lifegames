{
  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "clamp(1.80rem, 1.50rem + 0.80vw, 2.20rem)",
        "lineHeight": 1.15
      },
      "$description": "Hero/display text. Maps to typography.hero primitive."
    },
    "heading1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.bold}",
        "fontSize": "clamp(1.60rem, 1.30rem + 0.80vw, 2.00rem)",
        "lineHeight": 1.25
      },
      "$description": "Section headings. Maps to typography.title3 primitive."
    },
    "heading2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.semibold}",
        "fontSize": "clamp(1.20rem, 0.98rem + 0.60vw, 1.50rem)",
        "lineHeight": 1.3
      },
      "$description": "Subsection headings. Maps to typography.headline primitive."
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "clamp(0.72rem, 0.65rem + 0.20vw, 0.82rem)",
        "lineHeight": 1.5
      },
      "$description": "Default body text. Maps to typography.body primitive."
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.medium}",
        "fontSize": "clamp(0.72rem, 0.65rem + 0.20vw, 0.82rem)",
        "lineHeight": 1.4
      },
      "$description": "Form labels and UI element labels."
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "clamp(0.70rem, 0.64rem + 0.14vw, 0.78rem)",
        "lineHeight": 1.3
      },
      "$description": "Caption / supporting text. Maps to typography.caption primitive."
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontWeight": "{font.weight.regular}",
        "fontSize": "clamp(0.70rem, 0.64rem + 0.14vw, 0.78rem)",
        "lineHeight": 1.6
      },
      "$description": "Monospaced code blocks and inline code. Uses the mono family stack, ending in the monospace generic."
    }
  }
}
