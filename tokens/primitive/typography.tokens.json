{
  "font": {
    "family": {
      "brand": { "$type": "fontFamily", "$value": "Space Grotesk" },
      "brandFallback": { "$type": "fontFamily", "$value": "Space Grotesk Fallback" },
      "system": { "$type": "fontFamily", "$value": "system-ui" }
    },
    "weight": {
      "light":    { "$type": "fontWeight", "$value": 300 },
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "iosTypography": {
    "caption2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 11.5,
        "fontWeight": 400,
        "lineHeight": 1.3
      },
      "$extensions": { "lifegames": { "fontSizeMax": 11.5, "iosTextStyle": ".caption2" } }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 12.5,
        "fontWeight": 400,
        "lineHeight": 1.3
      },
      "$extensions": { "lifegames": { "fontSizeMax": 12.5, "iosTextStyle": ".caption" } }
    },
    "footnote": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 13.1,
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "$extensions": { "lifegames": { "fontSizeMax": 13.1, "iosTextStyle": ".footnote" } }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 13.1,
        "fontWeight": 400,
        "lineHeight": 1.5
      },
      "$description": "Maps to web --font-size-base: clamp(0.72rem, 0.65rem + 0.20vw, 0.82rem)",
      "$extensions": { "lifegames": { "fontSizeMax": 13.1, "iosTextStyle": ".body" } }
    },
    "callout": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 13.1,
        "fontWeight": 400,
        "lineHeight": 1.4
      },
      "$extensions": { "lifegames": { "fontSizeMax": 13.1, "iosTextStyle": ".callout" } }
    },
    "subhead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 16.8,
        "fontWeight": 500,
        "lineHeight": 1.4
      },
      "$description": "Maps to web --font-size-lg",
      "$extensions": { "lifegames": { "fontSizeMax": 16.8, "iosTextStyle": ".subheadline" } }
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 24.0,
        "fontWeight": 600,
        "lineHeight": 1.3
      },
      "$description": "Maps to web --font-size-xl",
      "$extensions": { "lifegames": { "fontSizeMax": 24.0, "iosTextStyle": ".headline" } }
    },
    "title3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 32.0,
        "fontWeight": 700,
        "lineHeight": 1.25
      },
      "$description": "Maps to web --font-size-2xl",
      "$extensions": { "lifegames": { "fontSizeMax": 32.0, "iosTextStyle": ".title3" } }
    },
    "title2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 38.4,
        "fontWeight": 700,
        "lineHeight": 1.2
      },
      "$description": "Maps to web --font-size-3xl",
      "$extensions": { "lifegames": { "fontSizeMax": 38.4, "iosTextStyle": ".title2" } }
    },
    "title1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 42.0,
        "fontWeight": 700,
        "lineHeight": 1.15
      },
      "$description": "Interpolated between title2 and hero. No direct web mapping.",
      "$extensions": { "lifegames": { "fontSizeMax": 42.0, "iosTextStyle": ".title1" } }
    },
    "hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSize": 35.2,
        "fontWeight": 700,
        "lineHeight": 1.15
      },
      "$description": "Maps to web --font-size-hero",
      "$extensions": { "lifegames": { "fontSizeMax": 35.2, "iosTextStyle": ".largeTitle" } }
    }
  }
}
