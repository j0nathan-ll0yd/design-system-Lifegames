{
  "font": {
    "family": {
      "brand": { "$type": "fontFamily", "$value": "Space Grotesk" },
      "brandFallback": { "$type": "fontFamily", "$value": "Space Grotesk Fallback" },
      "system": { "$type": "fontFamily", "$value": "system-ui" }
    },
    "weight": {
      "light":    { "$type": "fontWeight", "$value": 300 },
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    }
  },
  "typography": {
    "caption2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 10, "fontSizeMax": 11.5,
        "fontWeight": 400, "lineHeight": 1.3,
        "iosTextStyle": "caption2"
      }
    },
    "caption": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 11.2, "fontSizeMax": 12.5,
        "fontWeight": 400, "lineHeight": 1.3,
        "iosTextStyle": "caption1"
      }
    },
    "footnote": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 11.5, "fontSizeMax": 13.1,
        "fontWeight": 400, "lineHeight": 1.4,
        "iosTextStyle": "footnote"
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 11.5, "fontSizeMax": 13.1,
        "fontWeight": 400, "lineHeight": 1.5,
        "iosTextStyle": "body"
      },
      "$description": "Maps to web --font-size-base: clamp(0.72rem, 0.65rem + 0.20vw, 0.82rem)"
    },
    "callout": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 11.5, "fontSizeMax": 13.1,
        "fontWeight": 400, "lineHeight": 1.4,
        "iosTextStyle": "callout"
      }
    },
    "subhead": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 14.1, "fontSizeMax": 16.8,
        "fontWeight": 500, "lineHeight": 1.4,
        "iosTextStyle": "subheadline"
      },
      "$description": "Maps to web --font-size-lg"
    },
    "headline": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 19.2, "fontSizeMax": 24.0,
        "fontWeight": 600, "lineHeight": 1.3,
        "iosTextStyle": "headline"
      },
      "$description": "Maps to web --font-size-xl"
    },
    "title3": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 25.6, "fontSizeMax": 32.0,
        "fontWeight": 700, "lineHeight": 1.25,
        "iosTextStyle": "title3"
      },
      "$description": "Maps to web --font-size-2xl"
    },
    "title2": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 30.4, "fontSizeMax": 38.4,
        "fontWeight": 700, "lineHeight": 1.2,
        "iosTextStyle": "title2"
      },
      "$description": "Maps to web --font-size-3xl"
    },
    "title1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 33.6, "fontSizeMax": 42.0,
        "fontWeight": 700, "lineHeight": 1.15,
        "iosTextStyle": "title1"
      },
      "$description": "Interpolated between title2 and hero. No direct web mapping."
    },
    "hero": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.brand}",
        "fontSizeMin": 28.8, "fontSizeMax": 35.2,
        "fontWeight": 700, "lineHeight": 1.15,
        "iosTextStyle": "largeTitle"
      },
      "$description": "Maps to web --font-size-hero"
    }
  }
}
